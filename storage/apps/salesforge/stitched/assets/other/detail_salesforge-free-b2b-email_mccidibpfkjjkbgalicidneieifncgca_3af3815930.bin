tps://lh3.googleusercontent.com/o0pjmNzj0zV-Knqgh1lTBNXByf_zZVrRFyerJHCAh4911UzCBrvS-1FCRPegQ_hm_JRaGJ5HIPadSTueSmixkqTPHg","Salesforge: Free B2B Email \u0026 Phone Number Finder",4.861111111111111,36,"https://lh3.googleusercontent.com/DWv1gigOGASOllXj_7UvN_YiEBrErgX1bK7uusjmwO5ls1W9IiLWU3RRGOm5yV2EaRtochKrXu8bI8DE63CQv-im","Capture contacts, send personalized emails or messages, and sync contacts into your outreach pipeline in one click.","salesforge.ai",1,null,null,["productivity/workflow",null,4],1,null,872,1,null,[1758523079,739920000],"{\n\"update_url\": \"https://clients2.google.com/service/update2/crx\",\n\n  \"manifest_version\": 3,\n  \"name\": \"Salesforge: Free B2B Email \u0026 Phone Number Finder\",\n  \"version\": \"2.0.7\",\n  \"minimum_chrome_version\": \"114\",\n  \"description\": \"Capture contacts, send personalized emails or messages, and sync contacts into your outreach pipeline in one click.\",\n  \"permissions\": [\"tabs\", \"storage\", \"sidePanel\"],\n  \"host_permissions\": [\"\u003call_urls\u003e\"],\n  \"icons\": {\n    \"16\": \"icon.png\",\n    \"32\": \"icon.png\",\n    \"48\": \"icon.png\",\n    \"128\": \"icon.png\"\n  },\n  \"side_panel\": {\n    \"default_path\": \"sidepanel/index.html\"\n  },\n  \"action\": {\n    \"default_title\": \"Open Salesforge\",\n    \"default_icon\": {\n      \"16\": \"icon.png\",\n      \"48\": \"icon.png\",\n      \"128\": \"icon.png\"\n    }\n  },\n  \"background\": {\n    \"service_worker\": \"background.js\"\n  },\n  \"content_scripts\": [\n    {\n      \"matches\": [\"\u003call_urls\u003e\"],\n      \"js\": [\"content/content.js\"],\n      \"run_at\": \"document_end\"\n    },\n    {\n      \"matches\": [\"https://app.salesforge.ai/*\"],\n      \"js\": [\"content/injector.js\", \"content/auth.js\"],\n      \"run_at\": \"document_end\"\n    },\n    {\n      \"matches\": [\"http://localhost:3000/*\"],\n      \"js\": [\"content/injector.js\", \"content/auth.js\"],\n      \"run_at\": \"document_end\"\n    },\n    {\n      \"matches\": [\"https://app-dev.salesforge.ai/*\"],\n      \"js\": [\"content/injector.js\", \"content/auth.js\"],\n      \"run_at\": \"document_end\"\n    }\n  ],\n  \"web_accessible_resources\": [\n    {\n      \"resources\": [\"content/page-auth.js\"],\n      \"matches\": [\"\u003call_urls\u003e\"]\n    }\n  ]\n}\n","Salesforge: Free B2B Email \u0026 Phone Number Finder"],null,null,null,null,[[1,"https://lh3.googleusercontent.com/K3rzsnBK_XuX9HQR7HRAQSYBkvet77mkTZHqae-ZvNU7dFmPLzT5f8cWE6g1edC7AjbLPgmCZbBGdUHr5Vb66gM_Cg"],[1,"https://lh3.googleusercontent.com/AU2U_WdNBV-PZ5oJwKzFV7wxo9rq5nf0hKHJpDXZ98ddffxjDCCnwxrL_8BeVNZKjMtLYTUNoWae2PxOzMwzhMgt"],[1,"https://lh3.googleusercontent.com/l6WhGMZguP4uJF7oEnn0C9jFegZjpZcKwQtejC8PbVJhzmLbHpjZRiyaKX6RABO8wHHf1CO8A7ctsHMdFf3RssH-"],[1,"https://lh3.googleusercontent.com/M5ppOPWZGAxAv_wXRLbROekx4fE2x8lzYf_4Zb1526K2IT-OlaT9EPraRZHuJ_tWOSwhK_Erm9rx2o7ULVL_JMuF"],[1,"https://lh3.googleusercontent.com/g7u5WLNPU7cFnMii_FWOJ7KLPqJSRhlC92Ys0puqGfuIzrNGswHhc5i0Eiv4JW9-VkF-VtVUE6XDhTdsfpEVfY2MOQ"]],"Salesforge extension helps you find contact info, add prospects to your pipeline, launch personalized outreach, and speed up your entire prospecting workflow.\n\nProspecting shouldn’t take hours. With Salesforge, you can capture a lead’s business email or phone number instantly, enrich profiles, send tailored messages, and sync everything directly into your Salesforge account with a single click.\n\nBuilt for modern outbound teams, the extension works wherever you work - LinkedIn, company websites - turning every page into a prospecting surface.\n\nInstall the free extension, or unlock the full Salesforge platform (AI SDR, multi-channel outreach, deliverability tools, lead search, and more) with a free account at: https://salesforge.ai\n\nThousands of founders, SDRs, and agencies use Salesforge to streamline contact discovery and automate their outreach.\n\n🔥 Prospect faster - anywhere you work\nUse the Salesforge Chrome Extension to do all of the below across tools you already use every day, including LinkedIn, company websites, and inside your Salesforge workspace:\n- Find verified B2B emails\n- Find mobile phone numbers\n- Capture contacts from any page\n- Launch personalized emails instantly\n- Tag contacts\n- Sync contacts directly into your Salesforge pipeline\n- Trigger outreach sequences\n- Compose emails with AI\n- Build lead lists as you browse\n- Save prospects without switching tabs\nWith one click, Salesforge turns manual research into a streamlined workflow.\n\n🚀 Additional platform-specific features\nThe Chrome Extension is optimized for each workflow you work in - giving you even more power inside each platform.\nLinkedIn\n- Capture contact emails \u0026 phones from profiles\n- Save leads directly into Salesforge\n- Build lists while browsing\n- Enrich contacts with company info\nCompany Websites\n- Instantly discover decision-maker contact details\n- Add prospects to your pipeline\n- Launch outreach without opening another tool\nEverywhere Online\n- Open the Salesforge sidebar on any site\n- Pull verified contact info in seconds\n- Sync everything seamlessly to your CRM inside Salesforge\n\n🤝 Extension benefits\n- The Salesforge Chrome Extension includes:\n- Free Unlimited contact lookups\n- Free Unlimited contact saving\n- Free syncing to your Salesforge pipeline\n- AI-assisted email writing inside Salesforge\n- Free warm-up (via Warmforge) for mailboxes connected to Salesforge\n- Access to Salesforge’s free tools: Spam Checker, Blacklist Checker, DMARC Record Generator \u0026 more\nSalesforge’s free tier delivers high value out of the box - no complicated setup, no hidden restrictions.\nExplore additional capabilities with full access to the Salesforge platform: https://salesforge.ai\n\n🌐 Useful links\nLinkedIn: https://www.linkedin.com/company/salesforgeai\nWebsite: https://salesforge.ai\nHelp Center: https://help.salesforge.ai\nBlog: https://salesforge.ai/blog\nPrivacy Policy: https://salesforge.ai/privacy",[1,5],1,1,["hey@salesforge.ai","Sepapaja 6\nTallinn 15551\nEE",null,null,null,"Salesforge",null,"Salesforge OÜ",null,null,"u733b9a8537fd3543f679019b331330e6"],null,null,"2.0.7",[1783423629,122609000],"5.25MiB",["English"],null,null,null,null,1,[["alhgpfoeiimagjlnfekdhkjlkiomcapa","https://lh3.googleusercontent.com/68LpDYX6VaTBKftQddBUEwe7Girb6Q-4ml18X54szmH8z6aW5mcqE-C1-L47jSGU7ikYJl48mr0IVfKymTtEMd8B","Apollo.io: Free B2B Phone Number \u0026 Email Finder",4.706636155606407,2185,"https://lh3.googleusercontent.com/VlxeOTxqNf917svPV978n1qnIi6HjO-XE3r7DNZNgl11obl_PMTzRkUUIiKasma0VNyo2es_fdHP0apDfIVLeJ__6w","Apollo enables users to find contact info, connect with buyers, track emails, and more for free.","apollo.io",1,1,null,["productivity/workflow",null,4],1,1,1000000,1,"https://lh3.googleusercontent.com/mntnGZryv0TzhqezyyVgLax_6CQwqtVDoOqsuKMCxcdGpmTGGX6LKlRr_BmWqwdlvn9J4KgOJOD4trzeCDH7L9Wn9A",[1454705999,42000000],"{\n\"update_url\": \"https://clients2.google.com/service/update2/crx\",\n\n  \"version\": \"16.0.0\",\n  \"name\": \"Apollo.io: Free B2B Phone Number \u0026 Email Finder\",\n  \"short_name\": \"Apollo.io\",\n  \"manifest_version\": 3,\n  \"description\": \"Apollo enables users to find contact info, connect with buyers, track emails, and more for free.\",\n  \"action\": {\n    \"default_title\": \"Apollo\"\n  },\n  \"icons\": {\n    \"16\": \"img/lmjks_rNdM_icon-16wb05v.png\",\n    \"48\": \"img/twqxq_rNdM_icon-4823o5t.png\",\n    \"128\": \"img/y9ul4_rNdM_icon-128nv45z.png\"\n  },\n  \"background\": {\n    \"service_worker\": \"9nxbk_rNdM_serviceWorker2o1f3.js\",\n    \"type\": \"module\"\n  },\n  \"content_scripts\": [\n    {\n      \"matches\": [\"*://*.linkedin.com/*\"],\n      \"js\": [\"js/3jrh8_rNdM_injectLINetwork.bundledwsx6.js\"],\n      \"run_at\": \"document_start\"\n    },\n    {\n      \"matches\": [\"*://*.hubspot.com/*\"],\n      \"js\": [\"js/l48kz_rNdM_injectHSNetwork.bundlekd2vj.js\"],\n  