s="outbound-success w-form-done"><div class="outbound-success-flex-wrap"><div class="get-ai-message-form-success-wrapper margin-bottom _16px"><div><div class="text-large-20 text-semibold text-white">It&#x27;s being carefully crafted by AI</div><div class="text-dark text-xregular-15 margin-top _8px text-white">Please check your mailbox in 5 minutes</div></div></div><div class="captiwate-cta"></div></div></div><div class="form-error-box margin-top _24px w-form-fail"><div class="text-dark text-align-center">Something went wrong. Please try again</div></div></div></div></div></div></div></section><div class="divider lighter"></div><section id="stack" class="n-section-divider relative z-index-1"><div class="padding-global"><div class="container-large"><div class="n-section-home-divider-inner"></div></div></div></section><div class="divider lighter"></div><div class="stack-pricing-wrapper"><section class="section-outbound-pricing"><div class="padding-global"><div class="w-condition-invisible w-embed w-script"><script>
  // Salesforge base plan
var ACTIVE_CONTACT_VALUES = [
