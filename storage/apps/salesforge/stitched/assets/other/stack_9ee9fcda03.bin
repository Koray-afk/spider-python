<script>
document
  .getElementById("wf-form-hubspot-sign-up")
  .parentElement.addEventListener("submit", function (event) {
    event.preventDefault();

    const urlParams = new URLSearchParams(window.location.search);
    const skipBacklink = urlParams.get("skipBacklink");

    const windowUrl = new URL(window.location.href);
    const salesforgeUrl = new URL("https://app.salesforge.ai/signup");
    const email = event.target.elements.email.value;

    // Preserve email in redirect URL
    if (email) {
      salesforgeUrl.searchParams.set("email", email);
    }

    // Preserve existing query params
    windowUrl.searchParams.forEach((value, key) => {
      salesforgeUrl.searchParams.set(key, value);
    });

    const data = new FormData(event.target);
    data.set("pageUri", window.location.href);
    data.set("pageName", document.title);
    data.set("pageId", window.location.pathname);

    // Send form data to HubSpot
    fetch(
      "https://hubspotonwebflow.com/api/forms/b0af8fbd-3c18-4f37-ae7c-fab3d5a8353a",
      {
        method: "POST",
        body: data,
      }
    );

    if (!skipBacklink) {
      // 🚀 Open Salesforge signup in new tab
      const newTab = window.open("", "_blank");
      newTab.location.href = salesforgeUrl.toString();

      // 🔁 Redirect current tab to Leadsforge with skipBacklink to prevent loops
      const redirectUrl = new URL("https://leadsforge.ai");
      redirectUrl.searchParams.set("skipBacklink", "true");
      setTimeout(() => {
        window.location.href = redirectUrl.toString();
      }, 500);
    } else {
      // If skipBacklink=true, just redirect current tab to Salesforge signup
      window.location.href = salesforgeUrl.toString();
    }
  });
</script></div></div></div></div></div></div><div class="padding-global hide-mobile-portrait"><div class="container-large"><div class="stack-new-hero-illu-parent-wrapper"><div class="relative"><div class="div-block-132"><div class="stack-hero-badge"><div class="text-large-20 text-dark text-medium">Before the Forge</div></div><div class="text-xxsmall-13 text-lighter-400">Android-like Experience</div></div><img src="https://cdn.prod.website-files.com/642bd4ac1fcf21f9f33d92ed/69400f7bc3d941ec7628f309_87b456aa848836d88b6db472969c14c0_hero-01.avif" loading="lazy" width="930" sizes="(max-width: 991px) 100vw, 930px" alt="" srcset="https://cdn.prod.website-files.com/642bd4ac1fcf21f9f33d92ed/69400f7bc3d941ec7628f309_87b456aa848836d88b6db472969c14c0_hero-01-p-500.avif 500w, https://cdn.prod.website-files.com/642bd4ac1fcf21f9f33d92ed/69400f7bc3d941ec7628f309_87b456aa848836d88b6db472969c14c0_hero-01-p-800.avif 800w, https://cdn.prod.website-files.com/642bd4ac1fcf21f9f33d92ed/69400f7bc3d941ec7628f309_87b456aa848836d88b6db472969c14c0_hero-01.avif 1860w"/></div><div class="divider vertical lighter"></div><div class="relative"><div class="div-block-132"><div class="stack-hero-badge brand"><div class="text-large-20 text-medium text-white">With the Forge</div></div><div class="text-xxsmall-13 text-lighter-400">Apple-like Experience</div></div><img src="https://cdn.prod.website-files.com/642bd4ac1fcf21f9f33d92ed/69400f7b8e7da2d18e9427da_c3501f1fd35cc5af601e947e0567bc62_hero-02.avif" loading="lazy" width="930" sizes="(max-width: 991px) 100vw, 930px" alt="" srcset="https://cdn.prod.website-files.com/642bd4ac1fcf21f9f33d92ed/69400f7b8e7da2d18e9427da_c3501f1fd35cc5af601e947e0567bc62_hero-02-p-500.avif 500w, https://cdn.prod.website-files.com/642bd4ac1fcf21f9f33d92ed/69400f7b8e7da2d18e9427da_c3501f1fd35cc5af601e947e0567bc62_hero-02-p-800.avif 800w, https://cdn.prod.website-files.com/642bd4ac1fcf21f9f33d92ed/69400f7b8e7da2d18e9427da_c3501f1fd35cc5af601e947e0567bc62_hero-02.avif 1860w"/></di