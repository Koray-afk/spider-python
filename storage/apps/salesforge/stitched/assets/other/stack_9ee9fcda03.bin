  var GROWTH_BASE_PRICE = 96;

  /* =====================================================
     LEAD GENERATION LAYER – Leadsforge (from CSV, monthly)
     Tier 0 = Not included
     Tier 1 = Base Plan (2,000 credits, included in Leadsforge Essential)
     ===================================================== */
  var LEADSFORGE_ESSENTIAL_MONTHLY = 49;
  var LEADSFORGE_TIERS = [
    { name: "Not included", credits: 0,      priceMonthly: 0    },
    { name: "Base plan",    credits: 2000,   priceMonthly: 0    },
    { name: "Tier 2",       credits: 8000,   priceMonthly: 40   },
    { name: "Tier 3",       credits: 16000,  priceMonthly: 100  },
    { name: "Tier 4",       credits: 25000,  priceMonthly: 170  },
    { name: "Tier 5",       credits: 50000,  priceMonthly: 380  },
    { name: "Tier 6",       credits: 100000, priceMonthly: 750  },
    { name: "Tier 7",       credits: 150000, priceMonthly: 1130 },
    { name: "Tier 8",       credits: 200000, priceMonthly: 1500 },
  ];

  /* =====================================================
     INFRASTRUCTURE LAYER – Primeforge, Mailforge, Infraforge
     ===================================================== */

  var PF_DOMAIN_PRICE = 14;
  var PF_MAILBOX_TIERS = [
    { range: [1, 100], monthly: 4.5 },
    { range: [101, 200], monthly: 4.5 },
    { range: [201, 300], monthly: 4.5 },
    { range: [301, 400], monthly: 4.5 },
    { range: [401, 500], monthly: 4.5 },
    { range: [501, 600], monthly: 4.5 },
    { range: [601, 700], monthly: 4.5 },
    { range: [701, 800], monthly: 4.5 },
    { range: [801, 900], monthly: 4.5 },
    { range: [901, 1000], monthly: 4.5 },
    { range: [1001, Infinity], monthly: 4.5 },
  ];
  var PF_PLANS = [
    { credits: 0, price: 0 },
    { credits: 1000, price: 0 },
    { credits: 8000, price: 45 },
    { credits: 16000, price: 90 },
    { credits: 25000, price: 135 },
    { credits: 50000, price: 250 },
    { credits: 100000, price: 450 },
  ];
  var PF_EMAILS_PER_CONTACT = 2;
  var PF_MAILBOXES_PER_DOMAIN = 3;

  var DOMAIN_PRICE_MF = 14;
  var pricingIncrementsMonthlyMf = [
    { slotsRange: [1, 100], price: 3 },
    { slotsRange: [101, 200], price: 2.9 },
    { slotsRange: [201, 300], price: 2.8 },
    { slotsRange: [301, 400], price: 2.7 },
    { slotsRange: [401, 500], price: 2.6 },
    { slotsRange: [501, 600], price: 2.5 },
    { slotsRange: [601, 700], price: 2.4 },
    { slotsRange: [701, 800], price: 2.3 },
    { slotsRange: [801, 900], price: 2.2 },
    { slotsRange: [901, 1000], price: 2.1 },
    { slotsRange: [1001, Infinity], price: 2.0 },
  ];
  var MF_PRICING = {
    monthly: [
      { credits: 0, price: 0 },
      { credits: 1000, price: 0 },
      { credits: 8000, price: 40 },
      { credits: 16000, price: 100 },
      { credits: 25000, price: 170 },
      { credits: 50000, price: 380 },
      { credits: 100000, price: 750 },
    ],
  };
  var EMAILS_PER_CONTACT_MF = 2;
  var MAILBOXES_PER_DOMAIN_MF = 3;

  var IF_MAILBOX_PRICING = [
    { range: [1, 100], monthly: 4.0 },
    { range: [101, 200], monthly: 3.9 },
    { range: [201, 300], monthly: 3.8 },
    { range: [301, 400], monthly: 3.7 },
    { range: [401, 500], monthly: 3.6 },
    { range: [501, 600], monthly: 3.5 },
    { range: [601, 700], monthly: 3.4 },
    { range: [701, 800], monthly: 3.3 },
    { range: [801, 900], monthly: 3.2 },
    { range: [901, 1000], monthly: 3.1 },
    { range: [1001, Infinity], monthly: 3.0 },
  ];
  var DOMAIN_PRICE_IF = 14;
  var EMAILS_PER_CONTACT_IF = 2;
  var MAILBOXES_PER_DOMAIN_IF = 3;
  var IF_PRICING = [
    { credits: 0, price: 0 },
    { credits: 1000, price: 0 },
    { credits: 8000, price: 40 },
    { credits: 16000, price: 100 },
    { credits: 25000, price: 170 },
    { credits: 50000, price: 380 },
    { credits: 100000, price: 750 },
  ];

  function presentNumberInfra(n) {
    return new Intl.NumberFormat("en-US", { maximumFractionDigits: 0 }).format(
      Number(n)
    );
  }

  function getPFMailboxUnitPrice(count) {
    for (var i = 0; i < PF_MAILBOX_TIERS.length; i++) {
      var t = PF_MAILBOX_TIERS[i];
      if (count >= t.range[0] && count <= t.range[1]) return t.monthly;
    }
    return 0;
  }

  function getPFTierIndex(count) {
    for (var i = 0; i < PF_MAILBOX_TIERS.length; i++) {
      var t = PF_MAILBOX_TIERS[i];
      if (count >= t.range[0] && count <= t.range[1]) return i;
    }
    return PF_MAILBOX_TIERS.length - 1;
  }

  function calculatePrimeforge(contacts) {
    var emailsPerDay = Math.ceil((contacts / 22) * PF_EMAILS_PER_CONTACT);
    var rawMailboxes = Math.ceil(emailsPerDay / 30);
    var mailboxes = Math.max(10, Math.ceil(rawMailboxes / 5) * 5);
    var domains = Math.ceil(mailboxes / PF_MAILBOXES_PER_DOMAIN);
    var unitPrice = getPFMailboxUnitPrice(mailboxes);
    return {
      mailboxes: { count: mailboxes, monthly: mailboxes * unitPrice },
      domains: { count: domains, yearly: domains * PF_DOMAIN_PRICE },
    };
  }

  function findSlotPrice(slots) {
    for (var i = 0; i < pricingIncrementsMonthlyMf.length; i++) {
      var tier = pricingIncrementsMonthlyMf[i];
      var from = tier.slotsRange[0];
      var to = tier.slotsRange[1];
      if (slots >= from && slots <= to) return tier.price;
    }
    return 0;
  }

  function getMFTierIndex(slots) {
    for (var i = 0; i < pricingIncrementsMonthlyMf.length; i++) {
      var tier = pricingIncrementsMonthlyMf[i];
      if (slots >= tier.slotsRange[0] && slots <= tier.slotsRange[1]) return i;
    }
    return pricingIncrementsMonthlyMf.length - 1;
  }

  function calculateResults(
    contactsPerMonth,
    emailsPerContact,
    mailboxesPerDomain,
    domainPrice
  ) {
    if (!emailsPerContact || !mailboxesPerDomain) return null;
    var emailsPerDay = Math.ceil((contactsPerMonth / 22) * emailsPerContact);
    var rawMailboxes = Math.ceil(emailsPerDay / 30);
    var mailboxesCount = Math.max(10, Math.ceil(rawMailboxes / 5) * 5);
    var domainsCount = Math.ceil(mailboxesCount / mailboxesPerDomain);
    var mailboxUnitPrice = findSlotPrice(mailboxesCount);
    return {
      mailboxes: {
        count: mailboxesCount,
        monthly: mailboxesCount * mailboxUnitPrice,
      },
      domains: { count: domainsCount, price: domainsCount * domainPrice },
    };
  }

  function getIFMailboxUnitPrice(count) {
    for (var i = 0; i < IF_MAILBOX_PRICING.length; i++) {
      var t = IF_MAILBOX_PRICING[i];
      if (count >= t.range[0] && count <= t.range[1]) return t.monthly;
    }
    return 0;
  }

  function getIFTierIndex(count) {
    for (var i = 0; i < IF_MAILBOX_PRICING.length; i++) {
      var t = IF_MAILBOX_PRICING[i];
      if (count >= t.range[0] && count <= t.range[1]) return i;
    }
    return IF_MAILBOX_PRICING.length - 1;
  }

  function calculateResult(
    contactsPerMonth,
    emailsPerContact,
    mailboxesPerDomain,
    domainPrice
  ) {
    var emailsPerDay = Math.ceil((contactsPerMonth / 22) * emailsPerContact);
    var requiredMailboxes = Math.max(10, Math.ceil(emailsPerDay / 30 / 5) * 5);
    var domains = Math.ceil(requiredMailboxes / mailboxesPerDomain);
    if (domains < 1) domains = 1;
    var unitPrice = getIFMailboxUnitPrice(requiredMailboxes);
    var mailboxMonthlyCost = requiredMailboxes * unitPrice;
    return {
      mailboxes: { count: requiredMailboxes, monthly: mailboxMonthlyCost },
      domains: { count: domains, price: domains * domainPrice },
    };
  }

  // Helper: calculate amount of emails per month from mailbox count
  // Formula: (30 emails/mailbox/day) * 20 working days * numberOfMailboxes
  function calcEmailsPerMonth(mailboxCount) {
    return 30 * mailboxCount * 20;
  }

  function initLeadsforge() {
    var slider = document.getElementById("leadsforge-slider");
    if (!slider) return;

    var creditsValueEl = document.getElementById("leadsforge-credits-value");
    var tierEl = document.getElementById("leadsforge-tier");
    var exportCreditsEl = document.getElementById("leadsforge-export-credits");
    var tierCostEl = document.getElementById("leadsforge-tier-cost");
    var essentialCostEl = document.getElementById("leadsforge-essential-cost");

    slider.min = 0;
    slider.max = LEADSFORGE_TIERS.length - 1;
    slider.step = 1;

    function updateLeadsforge(index) {
      var tier = LEADSFORGE_TIERS[index];
      if (!tier) return;

      if (index === 0) {
        if (creditsValueEl) creditsValueEl.textContent = "Not included";
        if (tierEl) tierEl.textContent = "";
        if (exportCreditsEl) exportCreditsEl.textContent = "0";
        if (tierCostEl) tierCostEl.textContent = "$0 / month";
        if (essentialCostEl) essentialCostEl.textContent = "$0 / month";
        return;
      }

      var creditsDisplay = formatNumber(tier.credits);
      var priceDisplay = formatPrice(tier.priceMonthly);

      if (creditsValueEl) {
        creditsValueEl.textContent =
          creditsDisplay + " Active contacts";
      }
      if (tierEl) tierEl.textContent = tier.name;
      if (exportCreditsEl) exportCreditsEl.textContent = creditsDisplay;
      if (tierCostEl) tierCostEl.textContent = priceDisplay + " / month";
      if (essentialCostEl) {
        essentialCostEl.textContent =
          formatPrice(LEADSFORGE_ESSENTIAL_MONTHLY) + " / month";
      }
    }

    updateLeadsforge(parseInt(slider.value || 0, 10));
    slider.addEventListener("input", function () {
      updateLeadsforge(parseInt(slider.value, 10));
      updateSelectedProducts();
    });
    updateSelectedProducts();
  }

  function initPrimeforge() {
    var slider = document.getElementById("pf-slider");
    if (!slider) return;
    var tierEl = document.getElementById("pf-tier");
    var numberOfLeads = document.getElementById("leads-number-pf");
    var mailboxCountEl = document.getElementById("pf-mailboxes");
    var mailboxCostEl = document.getElementById("pf-mailboxes-cost");
    var domainCountEl = document.getElementById("pf-domains");
    var domainCostEl = document.getElementById("pf-domains-cost");

    slider.min = 0;
    slider.max = PF_PLANS.length - 1;
    slider.step = 1;

    function updatePF(index) {
      var plan = PF_PLANS[index];
      if (!plan) return;

      if (index === 0) {
        if (numberOfLeads) numberOfLeads.innerText = "Not included";
        if (tierEl) tierEl.textContent = "";
        if (mailboxCountEl) mailboxCountEl.innerText = "0";
        if (mailboxCostEl) mailboxCostEl.innerText = "$0 / month";
        if (domainCountEl) domainCountEl.innerText = "0";
        if (domainCostEl) domainCostEl.innerText = "$0 / year";
        return;
      }

      var result;
      try {
        result = calculatePrimeforge(plan.credits);
      } catch (e) {
        console.error("Primeforge calculation error", e);
        return;
      }

      var emailsPerMonth = calcEmailsPerMonth(result.mailboxes.count);

      if (numberOfLeads) {
        numberOfLeads.innerText = `${emailsPerMonth.toLocaleString("en-US")} Emails / month`;
      }
      if (tierEl) tierEl.textContent = "Tier " + index;
      if (mailboxCountEl) {
        mailboxCountEl.innerText = presentNumberInfra(result.mailboxes.count);
      }
      if (mailboxCostEl) {
        mailboxCostEl.innerText =
          "$" + presentNumberInfra(result.mailboxes.monthly) + " / month";
      }
      if (domainCountEl) {
        domainCountEl.innerText = presentNumberInfra(result.domains.count);
      }
      if (domainCostEl) {
        domainCostEl.innerText =
          "$" + presentNumberInfra(result.domains.yearly) + " / year";
      }
    }

    updatePF(parseInt(slider.value || 0, 10));
    slider.addEventListener("input", function () {
      updatePF(parseInt(slider.value, 10));
      updateSelectedProducts();
    });
    updateSelectedProducts();
  }

  function initMailforge() {
    var slider = document.getElementById("mf-slider");
    if (!slider) return;
    var tierEl = document.getElementById("mf-tier");
    var numberOfLeads = document.getElementById("leads-number-mf");
    var mailboxCountEl = document.getElementById("mf-mailboxes");
    var mailboxCostEl = document.getElementById("mf-mailboxes-cost");
    var domainCountEl = document.getElementById("mf-domains");
    var domainCostEl = document.getElementById("mf-domains-cost");

    slider.min = 0;
    slider.max = MF_PRICING.monthly.length - 1;
    slider.step = 1;

    function updateFromSlider(index) {
      var tier = MF_PRICING.monthly[index];
      if (!tier) return;

      if (index === 0) {
        if (numberOfLeads) numberOfLeads.innerText = "Not included";
        if (tierEl) tierEl.textContent = "";
        if (mailboxCountEl) mailboxCountEl.innerText = "0";
        if (mailboxCostEl) mailboxCostEl.innerText = "$0 / month";
        if (domainCountEl) domainCountEl.innerText = "0";
        if (domainCostEl) domainCostEl.innerText = "$0 / year";
        return;
      }

      var result;
      try {
        result = calculateResults(
          tier.credits,
          EMAILS_PER_CONTACT_MF,
          MAILBOXES_PER_DOMAIN_MF,
          DOMAIN_PRICE_MF
        );
      } catch (e) {
        console.error("Mailforge calculation error", e);
        return;
      }

      if (!result) return;

      var emailsPerMonth = calcEmailsPerMonth(result.mailboxes.count);

      if (numberOfLeads) {
        numberOfLeads.innerText = `${emailsPerMonth.toLocaleString("en-US")} Emails / month`;
      }
      if (tierEl) tierEl.textContent = "Tier " + index;
      if (mailboxCountEl) {
        mailboxCountEl.innerText = presentNumberInfra(result.mailboxes.count);
      }
      if (mailboxCostEl) {
        mailboxCostEl.innerText =
          "$" + presentNumberInfra(result.mailboxes.monthly) + " / month";
      }
      if (domainCountEl) {
        domainCountEl.innerText = presentNumberInfra(result.domains.count);
      }
      if (domainCostEl) {
        domainCostEl.innerText =
          "$" + presentNumberInfra(result.domains.price) + " / year";
      }
    }

    updateFromSlider(parseInt(slider.value || 0, 10));
    slider.addEventListener("input", function () {
      updateFromSlider(parseInt(slider.value, 10));
      updateSelectedProducts();
    });
    updateSelectedProducts();
  }

  function initInfraforge() {
    var slider = document.getElementById("if-slider");
    if (!slider) return;
    var tierEl = document.getElementById("if-tier");
    var numberOfLeads = document.getElementById("leads-number-if");
    var mailboxCountEl = document.getElementById("if-mailboxes");
    var mailboxCostEl = document.getElementById("if-mailboxes-cost");
    var domainCountEl = document.getElementById("if-domains");
    var domainCostEl = document.getElementById("if-domains-cost");

    slider.min = 0;
    slider.max = IF_PRICING.length - 1;
    slider.step = 1;

    function updateFromSlider(index) {
      var tier = IF_PRICING[index];
      if (!tier) return;

      if (index === 0) {
        if (numberOfLeads) numberOfLeads.innerText = "Not included";
        if (tierEl) tierEl.textContent = "";
        if (mailboxCountEl) mailboxCountEl.innerText = "0";
        if (mailboxCostEl) mailboxCostEl.innerText = "$0 / month";
        if (domainCountEl) domainCountEl.innerText = "0";
        if (domainCostEl) domainCostEl.innerText = "$0 / year";
        return;
      }

      var result;
      try {
        result = calculateResult(
          tier.credits,
          EMAILS_PER_CONTACT_IF,
          MAILBOXES_PER_DOMAIN_IF,
          DOMAIN_PRICE_IF
        );
      } catch (e) {
        console.error("Infraforge calculation error", e);
        return;
      }

      if (!result) return;

      var emailsPerMonth = calcEmailsPerMonth(result.mailboxes.count);

      if (numberOfLeads) {
        numberOfLeads.innerText = `${emailsPerMonth.toLocaleString("en-US")} Emails / month`;
      }
      if (tierEl) tierEl.textContent = "Tier " + index;
      if (mailboxCountEl) {
        mailboxCountEl.innerText = presentNumberInfra(result.mailboxes.count);
      }
      if (mailboxCostEl) {
        mailboxCostEl.innerText =
          "$" + presentNumberInfra(result.mailboxes.monthly) + " / month";
      }
      if (domainCountEl) {
        domainCountEl.innerText = presentNumberInfra(result.domains.count);
      }
      if (domainCostEl) {
        domainCostEl.innerText =
          "$" + presentNumberInfra(result.domains.price) + " / year";
      }
    }

    updateFromSlider(parseInt(slider.value || 0, 10));
    slider.addEventListener("input", function () {
      updateFromSlider(parseInt(slider.value, 10));
      updateSelectedProducts();
    });
    updateSelectedProducts();
  }

  function formatIntegerWithCommas(n) {
    var num = Math.floor(Number(n));
    if (num < 0) return String(num);
    var s = String(num);
    var result = "";
    for (var i = s.length - 1, count = 0; i >= 0; i--, count++) {
      if (count > 0 && count % 3 === 0) result = "," + result;
      result = s[i] + result;
    }
    return result;
  }

  function formatNumber(n) {
    var num = Number(n);
    if (num >= 1000) return formatIntegerWithCommas(num);
    return String(num);
  }

  function formatPrice(centsOrDollars) {
    var n = Number(centsOrDollars);
    return "$" + (n >= 1000 ? formatIntegerWithCommas(n) : String(n));
  }

  function findTierIndex(value, tiers) {
    for (var i = 0; i < tiers.length; i++) {
      if (tiers[i] >= value) return i;
    }
    return tiers.length - 1;
  }

function updateActiveContacts(slider) {
  var value = Number(slider.value);
  var tierIndex = ACTIVE_CONTACT_VALUES.indexOf(value);

  if (tierIndex === -1) {
    tierIndex = findTierIndex(value, ACTIVE_CONTACT_VALUES);
    if (ACTIVE_CONTACT_VALUES[tierIndex] !== value) {
      value = ACTIVE_CONTACT_VALUES[tierIndex];
      slider.value = value;
    }
  }

  var price = ACTIVE_CONTACT_PRICES[tierIndex];
  var emails = EMAILS_PER_TIER[tierIndex];

  var tierLabel =
    tierIndex === 0
      ? ""
      : tierIndex === 1
      ? "Growth plan"
      : "Tier " + (tierIndex - 1);

  var valueEl = document.getElementById("contacts-value");
  var tierEl = document.getElementById("contacts-tier");
  var emailsEl = document.getElementById("contacts-emails");
  var costEl = document.getElementById("contacts-cost");

if (valueEl) {
  if (tierIndex === 0) {
    valueEl.textContent = "Not included";
  } else {
    valueEl.innerHTML =
      formatNumber(value) + " Active Contacts<br>" +
      formatNumber(emails) + " Emails";
  }
}

  if (tierEl) tierEl.textContent = tierLabel;
  if (emailsEl) emailsEl.textContent = formatNumber(emails);
  if (costEl) costEl.textContent = formatPrice(price) + " / month";

  updateTotal();
}

  function updatePersonalization(slider) {
  var tierIndex = Math.max(
    0,
    Math.min(PERSONALIZATION_CREDITS.length - 1, Math.floor(Number(slider.value)))
  );

  var credits = PERSONALIZATION_CREDITS[tierIndex];
  var price = PERSONALIZATION_PRICES[tierIndex];

  var tierLabel =
    tierIndex === 0
      ? ""
      : tierIndex === 1
      ? "Growth plan"
      : "Tier " + (tierIndex - 1);

  var valueEl = document.getElementById("personalization-value");
  var tierEl = document.getElementById("personalization-tier");
  var costEl = document.getElementById("personalization-cost");

if (valueEl) {
  if (tierIndex === 0) {
    valueEl.textContent = "Not included";
  } else if (tierIndex === 1) {
    valueEl.textContent = "1,000 included Personalization credits";
  } else {
    // Add base plan 1,000 credits to tier credits
    var displayCredits = credits + 1000;
    valueEl.textContent = formatNumber(displayCredits) + " Personalization credits";
  }
}

  if (tierEl) tierEl.textContent = tierLabel;
  if (costEl) costEl.textContent = formatPrice(price) + " / month";

  updateTotal();
}

  function updateValidation(slider) {
  var tierIndex = Math.max(
    0,
    Math.min(VALIDATION_CREDITS.length - 1, Math.floor(Number(slider.value)))
  );

  var credits = VALIDATION_CREDITS[tierIndex];
  var price = VALIDATION_PRICES[tierIndex];

  var tierLabel =
    tierIndex === 0
      ? ""
      : tierIndex === 1
      ? "Growth plan"
      : "Tier " + (tierIndex - 1);

  var valueEl = document.getElementById("validation-value");
  var tierEl = document.getElementById("validation-tier");
  var costEl = document.getElementById("validation-cost");

if (valueEl) {
  if (tierIndex === 0) {
    valueEl.textContent = "Not included";
  } else if (tierIndex === 1) {
    valueEl.textContent = "1,000 included Validation credits";
  } else {
    var displayCredits = credits + 1000;
    valueEl.textContent = formatNumber(displayCredits) + " Validation credits";
  }
}

  if (tierEl) tierEl.textContent = tierLabel;
  if (costEl) costEl.textContent = formatPrice(price) + " / month";

  updateTotal();
}

  function updateSocialActions(slider) {
  var tierIndex = Math.max(
    0,
    Math.min(SOCIAL_ACTIONS_VALUES.length - 1, Math.floor(Number(slider.value)))
  );

  var actions = SOCIAL_ACTIONS_VALUES[tierIndex];
  var price = SOCIAL_ACTIONS_PRICES[tierIndex];

  var tierLabel =
    tierIndex === 0
      ? "0"
      : tierIndex === 1
      ? "Growth plan"
      : "Tier " + (tierIndex - 1);

  var valueEl = document.getElementById("social-actions-value");
  var tierEl = document.getElementById("social-actions-tier");
  var costEl = document.getElementById("social-actions-cost");

if (valueEl) {
  if (tierIndex === 0) {
    valueEl.textContent = "Not included";
  } else if (tierIndex === 1) {
    valueEl.textContent = "1000 included Social actions";
  } else {
    var displayCredits = actions;
    valueEl.textContent = formatNumber(displayCredits) + " Social actions";
  }
}

  if (tierEl) tierEl.textContent = tierLabel;
  if (costEl) costEl.textContent = formatPrice(price) + " / month";

  updateTotal();
}

  function getSalesforgeMonthly() {
  var contactsSlider = document.getElementById("slider-contacts");
  var personalizationSlider = document.getElementById("slider-personalization");
  var validationSlider = document.getElementById("slider-validation");
  var socialActionsSlider = document.getElementById("slider-social-actions");

  var contactsPrice = 0;
  if (contactsSlider) {
    var contactsIndex = ACTIVE_CONTACT_VALUES.indexOf(Number(contactsSlider.value));
    if (contactsIndex === -1) {
      contactsIndex = findTierIndex(Number(contactsSlider.value), ACTIVE_CONTACT_VALUES);
    }
    contactsPrice = ACTIVE_CONTACT_PRICES[contactsIndex] || 0;
  }

  var personalizationPrice = 0;
  if (personalizationSlider) {
    var pi = Math.max(
      0,
      Math.min(PERSONALIZATION_PRICES.length - 1, Math.floor(Number(personalizationSlider.value)))
    );
    personalizationPrice = PERSONALIZATION_PRICES[pi] || 0;
  }

  var validationPrice = 0;
  if (validationSlider) {
    var vi = Math.max(
      0,
      Math.min(VALIDATION_PRICES.length - 1, Math.floor(Number(validationSlider.value)))
    );
    validationPrice = VALIDATION_PRICES[vi] || 0;
  }

  var socialActionsPrice = 0;
  if (socialActionsSlider) {
    var sai = Math.max(
      0,
      Math.min(SOCIAL_ACTIONS_PRICES.length - 1, Math.floor(Number(socialActionsSlider.value)))
    );
    socialActionsPrice = SOCIAL_ACTIONS_PRICES[sai] || 0;
  }

  return contactsPrice + personalizationPrice + validationPrice + socialActionsPrice;
}

  function getLeadsforgeMonthly() {
    var slider = document.getElementById("leadsforge-slider");
    if (!slider) return 0;

    var index = Math.max(
      0,
      Math.min(LEADSFORGE_TIERS.length - 1, parseInt(slider.value || 0, 10))
    );
    var tier = LEADSFORGE_TIERS[index];
    if (!tier) return 0;

    if (index === 0) return 0;

    return LEADSFORGE_ESSENTIAL_MONTHLY + tier.priceMonthly;
  }

  function getPrimeforgeMonthly() {
    var slider = document.getElementById("pf-slider");
    if (!slider) return 0;

    var index = Math.max(
      0,
      Math.min(PF_PLANS.length - 1, parseInt(slider.value || 0, 10))
    );

    if (index === 0) return 0;

    var plan = PF_PLANS[index];
    if (!plan) return 0;

    try {
      var result = calculatePrimeforge(plan.credits);
      if (!result) return 0;
      return result.mailboxes.monthly + result.domains.yearly / 12;
    } catch (e) {
      console.error("Primeforge summary calculation error", e);
      return 0;
    }
  }

  function getMailforgeMonthly() {
    var slider = document.getElementById("mf-slider");
    if (!slider) return 0;

    var index = Math.max(
      0,
      Math.min(MF_PRICING.monthly.length - 1, parseInt(slider.value || 0, 10))
    );

    if (index === 0) return 0;

    var tier = MF_PRICING.monthly[index];
    if (!tier) return 0;

    try {
      var result = calculateResults(
        tier.credits,
        EMAILS_PER_CONTACT_MF,
        MAILBOXES_PER_DOMAIN_MF,
        DOMAIN_PRICE_MF
      );
      if (!result) return 0;
      return result.mailboxes.monthly + result.domains.price / 12;
    } catch (e) {
      console.error("Mailforge summary calculation error", e);
      return 0;
    }
  }

  function getInfraforgeMonthly() {
    var slider = document.getElementById("if-slider");
    if (!slider) return 0;

    var index = Math.max(
      0,
      Math.min(IF_PRICING.length - 1, parseInt(slider.value || 0, 10))
    );

    if (index === 0) return 0;

    var tier = IF_PRICING[index];
    if (!tier) return 0;

    try {
      var result = calculateResult(
        tier.credits,
        EMAILS_PER_CONTACT_IF,
        MAILBOXES_PER_DOMAIN_IF,
        DOMAIN_PRICE_IF
      );
      if (!result) return 0;
      return result.mailboxes.monthly + result.domains.price / 12;
    } catch (e) {
      console.error("Infraforge summary calculation error", e);
      return 0;
    }
  }

  function getInfraSliderValue(sliderId) {
    var slider = document.getElementById(sliderId);
    if (!slider) return 0;
    return parseInt(slider.value || 0, 10);
  }

  function setInfraSummaryVisibility(costEl, show) {
    if (!costEl) return;
    var box =
      (costEl.closest &&
        costEl.closest(".outbound-pricing-right-prdouct-box")) ||
      costEl.parentElement;
    if (!box) return;
    box.style.display = show ? "" : "none";
  }

  function updateSelectedProducts() {
    var salesforge = getSalesforgeMonthly();
    var leadsforge = getLeadsforgeMonthly();
    var primeforge = getPrimeforgeMonthly();
    var mailforge = getMailforgeMonthly();
    var infraforge = getInfraforgeMonthly();

    var pfIncluded = getInfraSliderValue("pf-slider") > 0;
    var mfIncluded = getInfraSliderValue("mf-slider") > 0;
    var ifIncluded = getInfraSliderValue("if-slider") > 0;

    var total =
      salesforge +
      leadsforge +
      (pfIncluded ? primeforge : 0) +
      (mfIncluded ? mailforge : 0) +
      (ifIncluded ? infraforge : 0);

    var el;
    el = document.getElementById("summary-salesforge");
    if (el) el.textContent = formatPrice(Math.round(salesforge));

    el = document.getElementById("summary-leadsforge");
    if (el) {
      el.textContent = formatPrice(Math.round(leadsforge));
      setInfraSummaryVisibility(el, getInfraSliderValue("leadsforge-slider") > 0 || leadsforge > 0);
    }

    el = document.getElementById("summary-primeforge");
    if (el) {
      el.textContent = formatPrice(Math.round(primeforge));
      setInfraSummaryVisibility(el, pfIncluded);
    }

    el = document.getElementById("summary-mailforge");
    if (el) {
      el.textContent = formatPrice(Math.round(mailforge));
      setInfraSummaryVisibility(el, mfIncluded);
    }

    el = document.getElementById("summary-infraforge");
    if (el) {
      el.textContent = formatPrice(Math.round(infraforge));
      setInfraSummaryVisibility(el, ifIncluded);
    }

    el = document.getElementById("summary-total-amount");
    if (el) el.textContent = formatPrice(Math.round(total));
  }

  function updateTotal() {
    var totalEl = document.getElementById("total-cost");
    if (!totalEl) return;
    var total = getSalesforgeMonthly();
    totalEl.textContent = formatPrice(total) + " / month";
    updateSelectedProducts();
  }

  function init() {
    var contactsSlider = document.getElementById("slider-contacts");
    var personalizationSlider = document.getElementById(
      "slider-personalization"
    );
    var validationSlider = document.getElementById("slider-validation");

    if (contactsSlider) {
      contactsSlider.addEventListener("input", function () {
        updateActiveContacts(contactsSlider);
      });
      contactsSlider.addEventListener("change", function () {
        updateActiveContacts(contactsSlider);
      });
      updateActiveContacts(contactsSlider);
    }

    if (personalizationSlider) {
      personalizationSlider.addEventListener("input", function () {
        updatePersonalization(personalizationSlider);
      });
      personalizationSlider.addEventListener("change", function () {
        updatePersonalization(personalizationSlider);
      });
      updatePersonalization(personalizationSlider);
    }

    if (validationSlider) {
      validationSlider.addEventListener("input", function () {
        updateValidation(validationSlider);
      });
      validationSlider.addEventListener("change", function () {
        updateValidation(validationSlider);
      });
      updateValidation(validationSlider);
    }

    var socialActionsSlider = document.getElementById("slider-social-actions");
    if (socialActionsSlider) {
      socialActionsSlider.addEventListener("input", function () {
        updateSocialActions(socialActionsSlider);
      });
      socialActionsSlider.addEventListener("change", function () {
        updateSocialActions(socialActionsSlider);
      });
      updateSocialActions(socialActionsSlider);
    }

    initLeadsforge();
    initPrimeforge();
    initMailforge();
    initInfraforge();
    updateSelectedProducts();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script></div><div class="container-large"><div class="pricing-slider-code w-embed w-script"><style>
.pricing-slider {
  -webkit-appearance: none; /* Override default CSS styles */
  appearance: none;
  width: 100%; /* Full-width */
  height: 4px; /* Specified height */
  outline: none; /* Remove outline */
  border-radius: 100px;
  transition: opacity 0.2s; /* Smooth transition */
}

.pricing-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: white;
  border: solid 3px #6E40D7; /* Border styling for thumb */
  cursor: pointer;
  position: relative; /* Positioning relative to parent */
  transform: translateY(-6px); /* Adjust vertical alignment */
}

.pricing-slider::-moz-range-thumb {
  height: 16px;
  width: 16px;
  background-color: white;
  border-radius: 50%;
  border: solid 3px #6E40D7;
  cursor: pointer;
  position: relative;
  transform: translateY(-4px); /* Adjust vertical alignment */
}

.pricing-slider::-webkit-slider-runnable-track {
  height: 4px;
  border-radius: 100px;
}

.pricing-slider::-moz-range-progress {
  height: 8px;
  border-radius: 100px;
}

.pricing-slider::-moz-range-track {
  background: #EAECF0; /* Background color */
  height: 8px;
  border-radius: 100px;
}
</style>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const sliders = document.querySelectorAll('.pricing-slider');

  function updateSliderFill(slider) {
    const min = parseFloat(slider.min) || 0;
    const max = parseFloat(slider.max) || 100;
    const pct = ((parseFloat(slider.value) - min) / (max - min)) * 100;

    slider.style.background = `linear-gradient(to right, #6E40D7 ${pct}%, #EAECF0 ${pct}%)`;
  }

  sliders.forEach(function (slider) {
    slider.addEventListener('input', function () {
      updateSliderFill(slider);
    });
    updateSliderFill(slider);
  });
});
</script></div><div class="case-study-parent-flex outbound-page"><div id="w-node-_457952b8-a6bb-c7da-36c5-e832c4c1bb3b-c4c1bb35" class="case-study-left"><div class="outbound-pricing-box"><div class="outbound-pricing-top"><div class="text-xxsmall-13 text-semibold">Outreach Layer</div></div><div class="outbound-pricing-bottom"><div class="outbound-pricing-bottom-top"><div class="baseline-0 w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="114" height="22" fill="none" viewBox="0 0 114 22">
