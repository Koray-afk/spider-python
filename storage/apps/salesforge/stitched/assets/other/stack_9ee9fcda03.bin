  <path stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.667" d="M17.5 8.333h-15m10.833-6.666V5M6.667 1.667V5M6.5 18.333h7c1.4 0 2.1 0 2.635-.272a2.5 2.5 0 0 0 1.092-1.093c.273-.535.273-1.235.273-2.635v-7c0-1.4 0-2.1-.273-2.635a2.5 2.5 0 0 0-1.092-1.092c-.535-.273-1.235-.273-2.635-.273h-7c-1.4 0-2.1 0-2.635.273a2.5 2.5 0 0 0-1.093 1.092C2.5 5.233 2.5 5.933 2.5 7.333v7c0 1.4 0 2.1.272 2.635a2.5 2.5 0 0 0 1.093 1.093c.535.272 1.235.272 2.635.272Z"/>
</svg></div></a><div class="hide w-embed w-script"><style>
/* 1. Essential Positioning */
.m-book-time-button-parent {
  display: none; /* Hidden by default */
  position: fixed; 
  opacity: 0;
  transition: opacity 0.3s ease;
}

/* Initial state for children */
.m-book-time-button-glare { 
  opacity: 0; 
  transition: opacity 0.5s linear;
}

#book-time-button { 
  opacity: 0; 
  transition: opacity 0.3s ease-out;
}

/* 2. Logic: When JS adds this class, trigger animations */
.m-book-time-button-parent.is-visible {
  opacity: 1; /* Fades in the parent */
}

.m-book-time-button-parent.is-visible .m-book-time-button-glare {
  opacity: 0.12; /* Fades in the glare to 12% */
}

.m-book-time-button-parent.is-visible #book-time-button {
  opacity: 1; /* Fades in the button */
  transform: translateY(0); /* Moves the button up */
}
</style>

<script>
window.addEventListener('DOMContentLoaded', () => {
    // Select the elements
    const parentContainer = document.querySelector('.m-book-time-button-parent');
    const closeTrigger = document.querySelector('.book-time-close-box');

    // 1. Check if element exists to avoid errors
    if (!parentContainer) {
        console.error("CTA Script: Could not find .m-book-time-button-parent");
        return;
    }

    // 2. Check LocalStorage (Persistence)
    const hasBeenClosed = localStorage.getItem('hideBookTimeCTA');
    if (hasBeenClosed === 'true') {
        return; // User previously closed this. Script stops here.
    }

    // 3. Scroll Logic
    const onScroll = () => {
        // Check if user scrolled more than 100vh
        if (window.scrollY > window.innerHeight) {
            
            // Step A: Apply the styles to make it exist in the layout as a flexbox
            parentContainer.style.display = 'flex';
            
            // Step B: Small delay to allow 'display: flex' to register before fading in
            setTimeout(() => {
                parentContainer.classList.add('is-visible');
            }, 20);

            // Stop listening to scroll once triggered
            window.removeEventListener('scroll', onScroll);
        }
    };

    window.addEventListener('scroll', onScroll);

    // 4. Close Logic
    if (closeTrigger) {
        closeTrigger.addEventListener('click', () => {
            
            // Animate out (fade to 0)
            parentContainer.classList.remove('is-visible');
            parentContainer.style.opacity = '0';
            
            // Wait 0.3s (matching your CSS transition) then remove from layout entirely
            setTimeout(() => {
                parentContainer.style.display = 'none';
                // Save to localStorage so it stays hidden on all pages
                localStorage.setItem('hideBookTimeCTA', 'true');
            }, 300);
        });
    }
});
</script></div></div></div></div></div><div class="v-page-wrapper"><section class="section-new-stack-hero-illu"><div class="padding-global"><div class="container-large"><div class="stack-new-hero-parent-wrapper"><div class="body-glare-container stack-page"><div class="body-glare-wrapper"><div class="inner-bg-glare-squares opacity-30 w-embed"><svg viewBox="0 0 1046 350" fill="none" xmlns="http://www.w3.org/2000/svg">
