</style></div><div class="hide-mobile-landscape"><div class="lf-100-credits-banner"><div class="hide-desktop"><div class="w-embed w-script"><script>
  document.addEventListener("DOMContentLoaded", function () {
    const banner = document.querySelector(".lf-100-credits-banner");
    const closeButton = document.querySelector(".lf-100-credits-close");

    // 1. Check if screen width is Tablet/Desktop (>= 768px)
    const isLargeEnough = window.innerWidth >= 768;

    // Only run the banner logic if on Desktop/Tablet
    if (isLargeEnough && localStorage.getItem("creditsBannerClosed") !== "true") {
      banner.style.display = "flex";
    }

    if (closeButton) {
      closeButton.addEventListener("click", function () {
        banner.style.top = "-2.75rem";

        setTimeout(function () {
          banner.style.display = "none";
          localStorage.setItem("creditsBannerClosed", "true");
        }, 300);
      });
    }
  });
</script>

<style>
/* 2. Hide the banner by default on mobile */
.lf-100-credits-banner {
  display: none; 
  width: 100%;
  transition: top 0.3s ease;
  z-index: 100;
}

/* 3. Allow it to be visible only on screens wider than 767px */
@media (min-width: 768px) {
  /* Note: The JS will handle the actual 'display: flex' toggle */
}
