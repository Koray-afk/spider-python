document.addEventListener('DOMContentLoaded', () => {
  // 1. Configuration
  const triggerSelector = '#karumi-overlay-button'; 
  const containerId = 'karumi-content-wrapper';
  const closeButtonId = 'karumi-close-button';

  const triggers = document.querySelectorAll(triggerSelector);
  const container = document.getElementById(containerId);
  const closeBtn = document.getElementById(closeButtonId);

  // 2. LOAD the meeting on click
  if (triggers.length > 0 && container) {
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        if (container.innerHTML.trim() === "") {
          container.innerHTML = `
            <iframe
              src="https://app.karumi.ai/meet/start/salesforge-landing-overlay"
              width="100%"
              height="100%"
              allow="camera; microphone; display-capture; autoplay; clipboard-write"
              allowfullscreen
              style="border: none; border-radius: 12px; height: 100%; width: 100%;"
            ></iframe>
          `;
        }
      });
    });
  }

  // 3. STOP & REMOVE the meeting on close
  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      const iframe = container.querySelector('iframe[src*="karumi.ai/meet"]');
      
      if (iframe) {
        // A. Signal the demo to disconnect properly
        iframe.contentWindow.postMessage({ type: "karumi:close" }, "https://app.karumi.ai");

        // B. Wait for the grace window before hard removal
        setTimeout(() => {
          iframe.src = ''; // Force stop media streams
          iframe.remove(); // Clean up DOM
        }, 300);
      }
      // Webflow Interactions will handle the visual 'Hide' animation
    });
  }
});
</script></div><div class="padding-global karumi"><div class="div-block-159"><div data-w-id="4249931b-329e-13e1-0bc8-0b7a4d5d3e7d" class="popup-close-icon-box karumi"><div class="icon-embed _32px w-embed"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg></div></div><div class="karumi-overlay-parent-flex"><div id="karumi-content-wrapper" class="karumi-overlay-parent"></div></div></div></div></div><div class="alt-back-button-parent"><div class="w-embed w-script"><script>
document.addEventListener("DOMContentLoaded", function () {
  const backComponent = document.querySelector(".alt-back-button-parent");
  const closeButton = document.querySelector(".button-back-close-icon");

  if (closeButton && backComponent) {
    closeButton.addEventListener("click", function () {
      backComponent.style.display = "none";
    });
  }
});
</script></div><div class="button-back-close-icon w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 28 28">
