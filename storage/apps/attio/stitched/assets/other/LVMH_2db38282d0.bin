tration de LVMH, que je l'avais conviée à rejoindre en 2010 et aux travaux duquel elle a contribué jusqu'en 2019. J'adresse mes plus sincères condoléances à sa fille Claude, à son petit fils Martin, et à tous ceux qui, comme beaucoup de Français, la portaient dans leur coeur. »",entity_set:$R[1479]={__ref:"client:Tm90ZVR3ZWV0OjIwNjMzMDkwNDA5MDY4NjY2ODg=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjMzMDkwNDA5MDY4NjY2ODg="},"client:Tm90ZVR3ZWV0OjIwNjMzMDkwNDA5MDY4NjY2ODg=:entity_set":$R[1480]={__id:"client:Tm90ZVR3ZWV0OjIwNjMzMDkwNDA5MDY4NjY2ODg=:entity_set",__typename:"EntitySet",hashtags:$R[1481]={__refs:$R[1482]=[]},symbols:$R[1483]={__refs:$R[1484]=[]},smarttags:$R[1485]={__refs:$R[1486]=[]},urls:$R[1487]={__refs:$R[1488]=[]},user_mentions:$R[1489]={__refs:$R[1490]=[]}},"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:grok_translated_post_with_availability":$R[1491]={__id:"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:edit_control":$R[1492]={__id:"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[1493]=["2063309040994951303"]},"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:quick_promote_eligibility":$R[1494]={__id:"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:quick_promote_eligibility",__typename:"TweetQuickPromoteEligibilityResponse",eligibility:"IneligibleUserUnauthorized"},"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:views":$R[1495]={__id:"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:views",__typename:"ViewCountInfo",count:"10508"},"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:legacy":$R[1496]={__id:"client:VHdlZXQ6MjA2MzMwOTA0MDk5NDk1MTMwMw==:legacy",__typename:"LegacyTweet",retweeted_status_results:null},"urt:server:TimelineTimelineEntry:tweet-2062829627492438093":$R[1497]={__id:"urt:server:TimelineTimelineEntry:tweet-2062829627492438093",__typename:"TimelineTimelineEntry",en