$R[620]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:media_entities2:0:video_info:variants:1",__typename:"ApiMediaEntityVideoVariant",bitrate:256000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/2072651083202392064/vid/avc1/480x270/wDaZVIACzDbfnvpC.mp4?tag=28"},"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:media_entities2:0:video_info:variants:2":$R[621]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:media_entities2:0:video_info:variants:2",__typename:"ApiMediaEntityVideoVariant",bitrate:832000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/2072651083202392064/vid/avc1/640x360/6I0OQ5x1NTTVXQ8b.mp4?tag=28"},"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:media_entities2:0:video_info:variants:3":$R[622]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:media_entities2:0:video_info:variants:3",__typename:"ApiMediaEntityVideoVariant",bitrate:2176000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/2072651083202392064/vid/avc1/1280x720/GnTIRsqiatHSX2ya.mp4?tag=28"},"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:media_entities2:0:video_info:variants:4":$R[623]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:media_entities2:0:video_info:variants:4",__typename:"ApiMediaEntityVideoVariant",bitrate:10368000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/2072651083202392064/vid/avc1/1920x1080/cJ6pdvxAXHpf9ras.mp4?tag=28"},"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:details":$R[624]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:details",__typename:"TBirdData",display_text_range:$R[625]=[0,277],self_thread_metadata:null,full_text:"Microsoft is just one beneficiary of 250 years of American history and the choices made by past generations. As an American company, we believe we have a responsibility to understand where we have been, learn from it, and help make real for others the opportunities created for https://t.co/4gIsazHjkd",hashtag_entities:$R[626]={__refs:$R[627]=[]},cashtag_entities:$R[628]={__refs:$R[629]=[]},smarttags:$R[630]={__refs:$R[631]=[]},created_at_ms:1782994483000},"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:note_tweet":$R[632]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[633]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDcyNjU1MjA1NzkyMDk2MjU2"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDcyNjU1MjA1NzkyMDk2MjU2:$R[634]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDcyNjU1MjA1NzkyMDk2MjU2",__typename:"NoteTweetResults",result:$R[635]={__ref:"Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDcyNjU1MjA1NzkyMDk2MjU2"},"Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=":$R[636]={__id:"Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=",__typename:"NoteTweet",text:"Microsoft is just one beneficiary of 250 years of American history and the choices made by past generations. As an American company, we believe we have a responsibility to understand where we have been, learn from it, and help make real for others the opportunities created for us.  \n \nAs America enters its 251st year, we face another inflection point shaped by rapid technological change. That is why we created this series. Throughout July, we will reflect on moments in American history with six video episodes when people faced uncertainty and made choices that set in motion consequences they could not fully see. Some decisions advanced the country. Others revealed how much work remained. Together, they remind us that history is not inevitable; it is made by people, in moments, through choices. \n \nOur goal is not simply to celebrate that history, but to learn and connect the past to the questions we face today. Because one of the best ways to honor 250 years of American history is to think seriously about what we will do next. \n \nStay tuned for episode 2 next week. https://t.co/8KAJ2Rfmsm \n\n@Microsoft",entity_set:$R[637]={__ref:"client:Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY="},"client:Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=:entity_set":$R[638]={__id:"client:Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=:entity_set",__typename:"EntitySet",hashtags:$R[639]={__refs:$R[640]=[]},symbols:$R[641]={__refs:$R[642]=[]},smarttags:$R[643]={__refs:$R[644]=[]},urls:$R[645]={__refs:$R[646]=["client:Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=:entity_set:urls:0"]},user_mentions:$R[647]={__refs:$R[648]=["client:Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=:entity_set:urls:0":$R[649]={__id:"client:Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=:entity_set:urls:0",__typename:"UrlsEntity",display_url:"aka.ms/America250",expanded_url:"https://aka.ms/America250",indices:$R[650]=[1081,1104],url:"https://t.co/8KAJ2Rfmsm"},"client:Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=:entity_set:user_mentions:0":$R[651]={__id:"client:Tm90ZVR3ZWV0OjIwNzI2NTUyMDU3OTIwOTYyNTY=:entity_set:user_mentions:0",__typename:"ApiMentionEntity",indices:$R[652]=[1107,1117],is_unmentioned:null,screen_name:"Microsoft"},"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:grok_translated_post_with_availability":$R[653]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:edit_control":$R[654]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[655]=["2072655205976703031"]},"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:quick_promote_eligibility":$R[656]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:quick_promote_eligibility",__typename:"TweetQuickPromoteEligibilityResponse",eligibility:"IneligibleUserUnauthorized"},"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:views":$R[657]={__id:"client:VHdlZXQ6MjA3MjY1NTIwNTk3NjcwMzAzMQ==:views",__typename:"ViewCountInfo",count:"120809"},"urt:server:TimelineTimelineEntry:tweet-207266