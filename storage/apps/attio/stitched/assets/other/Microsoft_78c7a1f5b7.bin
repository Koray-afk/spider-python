etails",__typename:"TBirdData",display_text_range:$R[970]=[0,279],self_thread_metadata:null,full_text:"When we launched our Community-First AI Infrastructure plan in January, we made a promise: we would meet the growing demand for datacenters without straining the resources communities depend on. Water was central to that commitment.\n\nToday we shared our progress. Since our first https://t.co/WNr1Ab1DCp",hashtag_entities:$R[971]={__refs:$R[972]=[]},cashtag_entities:$R[973]={__refs:$R[974]=[]},smarttags:$R[975]={__refs:$R[976]=[]},created_at_ms:1782303765000},"client:VHdlZXQ6MjA2OTc1ODEyMjY5NzQwNDUyMQ==:note_tweet":$R[977]={__id:"client:VHdlZXQ6MjA2OTc1ODEyMjY5NzQwNDUyMQ==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[978]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY5NzU4MTIyNTI5NTY2NzIw"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDY5NzU4MTIyNTI5NTY2NzIw:$R[979]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY5NzU4MTIyNTI5NTY2NzIw",__typename:"NoteTweetResults",result:$R[980]={__ref:"Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY5NzU4MTIyNTI5NTY2NzIw"},"Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=":$R[981]={__id:"Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=",__typename:"NoteTweet",text:"When we launched our Community-First AI Infrastructure plan in January, we made a promise: we would meet the growing demand for datacenters without straining the resources communities depend on. Water was central to that commitment.\n\nToday we shared our progress. Since our first datacenter designs in the early 2000s, we have improved our water-use effectiveness by nearly 90 percent. We are more than halfway to our 2030 water-intensity goal. And in FY25, we replenished more water globally than we withdrew, a milestone toward becoming water positive.\n\nDigital growth and responsible water stewardship can move forward together, and the communities we call home should be stronger for it. @Microsoft \n\nhttps://t.co/3nriuiwZKF",entity_set:$R[982]={__ref:"client:Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA="},"client:Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=:entity_set":$R[983]={__id:"client:Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=:entity_set",__typename:"EntitySet",hashtags:$R[984]={__refs:$R[985]=[]},symbols:$R[986]={__refs:$R[987]=[]},smarttags:$R[988]={__refs:$R[989]=[]},urls:$R[990]={__refs:$R[991]=["client:Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=:entity_set:urls:0"]},user_mentions:$R[992]={__refs:$R[993]=["client:Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=:entity_set:urls:0":$R[994]={__id:"client:Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=:entity_set:urls:0",__typename:"UrlsEntity",display_url:"blogs.microsoft.com/blog/2026/06/2…",expanded_url:"https://blogs.microsoft.com/blog/2026/06/24/inside-microsofts-two-decade-push-to-cut-water-intensity-while-scaling-for-growth/",indices:$R[995]=[705,728],url:"https://t.co/3nriuiwZKF"},"client:Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=:entity_set:user_mentions:0":$R[996]={__id:"client:Tm90ZVR3ZWV0OjIwNjk3NTgxMjI1Mjk1NjY3MjA=:entity_set:user_mentions:0",__typename:"ApiMentionEntity",indices:$R[997]=[692,702],is_unmentioned:null,screen_name:"Microsoft"},"client:VHdlZXQ6MjA2OTc1ODEyMjY5NzQwNDUyMQ==:grok_translated_post_with_availability":$R[998]={__id:"client:VHdlZXQ6MjA2OTc1ODEyMjY5NzQwNDUyMQ==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA2OTc1ODEyMjY5NzQwNDUyMQ==:edit_control":$R[999]={__id:"client:VHdlZXQ6MjA2OTc1ODEyMjY5NzQwNDUyMQ==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[1000]=["2069758122697404521"]},"client:VHdlZXQ6MjA2OTc1ODEyMjY5NzQwNDUyMQ==:quick_promote_eligibility":$R[1001]={__id:"client:VHdlZXQ6MjA2OTc1ODEyMjY5NzQwNDUyMQ==:quick_promote_eligibility",__typename:"TweetQuickPromoteEligibilityResponse",eligibility:"IneligibleUserUnauthorized"},"client:VHdlZXQ