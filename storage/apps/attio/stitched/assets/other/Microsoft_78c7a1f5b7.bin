itional_media_info:null,original_info:$R[1073]={__ref:"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:media_entities2:0:original_info"},ext_playlists:$R[1074]={__refs:$R[1075]=[]},video_info:null,sensitive_media_warning:null,indices:$R[1076]=[274,297]},"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:media_entities2:0:original_info":$R[1077]={__id:"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:media_entities2:0:original_info",__typename:"ApiMediaEntityOriginalInfo",width:4096,height:2178},"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:details":$R[1078]={__id:"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:details",__typename:"TBirdData",display_text_range:$R[1079]=[0,273],self_thread_metadata:null,full_text:"Today we broke ground in La Porte, Indiana, alongside Mayor Tom Dermody, local leaders, and community members who made this possible. This marks more than the start of a new datacenter. It represents the future of this community and our commitment to being a good neighbor. https://t.co/vhxACDNZhF",hashtag_entities:$R[1080]={__refs:$R[1081]=[]},cashtag_entities:$R[1082]={__refs:$R[1083]=[]},smarttags:$R[1084]={__refs:$R[1085]=[]},created_at_ms:1781728496000},"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:note_tweet":$R[1086]={__id:"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[1087]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY3MzQ1MjcwMDAyODY0MTI4"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDY3MzQ1MjcwMDAyODY0MTI4:$R[1088]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY3MzQ1MjcwMDAyODY0MTI4",__typename:"NoteTweetResults",result:$R[1089]={__ref:"Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDY3MzQ1MjcwMDAyODY0MTI4"},"Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg=":$R[1090]={__id:"Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg=",__typename:"NoteTweet",text:"Today we broke ground in La Porte, Indiana, alongside Mayor Tom Dermody, local leaders, and community members who made this possible. This marks more than the start of a new datacenter. It represents the future of this community and our commitment to being a good neighbor.\n\nBeyond the thousands of construction jobs, our first phase will create more than 600 permanent Microsoft jobs. It will grow local tax revenues to support schools and the broader community for generations. Our campus will be designed with the latest energy efficient and closed-loop liquid cooling technologies to conserve natural resources. And we will enhance the surrounding ecosystem to strengthen flood protection and natural habitat.\n\nLa Porte means \"the door.\" Together, we hope to help open a door to what's next, and to be the kind of neighbor that makes a community proud to call @Microsoft part of its hometown.",entity_set:$R[1091]={__ref:"client:Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg="},"client:Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg=:entity_set":$R[1092]={__id:"client:Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg=:entity_set",__typename:"EntitySet",hashtags:$R[1093]={__refs:$R[1094]=[]},symbols:$R[1095]={__refs:$R[1096]=[]},smarttags:$R[1097]={__refs:$R[1098]=[]},urls:$R[1099]={__refs:$R[1100]=[]},user_mentions:$R[1101]={__refs:$R[1102]=["client:Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg=:entity_set:user_mentions:0":$R[1103]={__id:"client:Tm90ZVR3ZWV0OjIwNjczNDUyNzAwMDI4NjQxMjg=:entity_set:user_mentions:0",__typename:"ApiMentionEntity",indices:$R[1104]=[864,874],is_unmentioned:null,screen_name:"Microsoft"},"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:grok_translated_post_with_availability":$R[1105]={__id:"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:edit_control":$R[1106]={__id:"client:VHdlZXQ6MjA2NzM0NTI3MDEyMDMwMDg0NA==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R