ct.webp&amp;w=2048&amp;q=75&amp;dpl=dpl_2L956ShVEVUkDqoy2XH4Ga913zyK 2048w, /ims-image?url=%2Fintercom-marketing-site%2Fimg%2Fen%2Fhome-2026%2Fdesktop%2FIC_Helpdesk_03_Engage_03_targeted_product.webp&amp;w=3840&amp;q=75&amp;dpl=dpl_2L956ShVEVUkDqoy2XH4Ga913zyK 3840w" src="/ims-image?url=%2Fintercom-marketing-site%2Fimg%2Fen%2Fhome-2026%2Fdesktop%2FIC_Helpdesk_03_Engage_03_targeted_product.webp&amp;w=3840&amp;q=75&amp;dpl=dpl_2L956ShVEVUkDqoy2XH4Ga913zyK"/></div></div></div></div></div></div></div><div class="flex gap-0 w-2/5 shrink-0 flex-col"><div class="group/thumb relative flex-1"><button type="button" class="focus-visible:outline-2 focus-visible:outline-offset-2 data-selected:bg-black/3 data-selected:opacity-100 group peer relative flex h-full w-full cursor-pointer flex-col text-left opacity-60 group-hover/thumb:opacity-80 data-selected:flex-1 min-h-32 flex-none overflow-hidden"><div class="flex h-full gap-4 p-6 lg:gap-6 pb-12"><span aria-hidden="true" class="mt-1 block size-2 shrink-0 bg-helpdesk"></span><div class="flex flex-col"><h4 class="text-heading-6 flex pb-2">Onboarding tools</h4><div class="font-sans! font-normal! text-current/70 space-y-3"><p>Onboard customers with interactive product tours, checklists, and in-app tooltips, so they get up to speed faster and get more value from your product, all without contacting support.</p></div></div></div><style>@keyframes carouselAutoplay { from { transform: scaleX(0); } to { transform: scaleX(1); } }</style><div class="absolute left-0 top-0 h-0.5 w-full origin-left bg-helpdesk" style="animation:carouselAutoplay linear;opacity:0"></div></button><div class="peer-data-selected:opacity-100 text-body font-sans! font-normal! lg:ml-13 absolute bottom-0 left-0 mb-5 ml-11 text-black/70 opacity-60 group-hover/thumb:opacity-80"><a class="text-inline-link focus-visible:outline-2 focus-visible:outline-offset-2" href="/helpdesk/outbound">Learn more</a></div></div><div class="group/thumb relative flex-1"><button type="button" class="focus-visible:outline-2 focus-visible:outline-offset-2 data-selected:bg-black/3 data-selected:opacity-100 group peer relative flex h-full w-full cursor-pointer flex-col text-left opacity-60 group-hover/thumb:opacity-80 data-selected:flex-1 min-h-32 flex-none overflow-hidden"><div class="flex h-full gap-4 p-6 lg:gap-6 pb-12"><span aria-hidden="true" class="mt-1 block size-2 shrink-0 bg-helpdesk"></span><div class="flex flex-col"><h4 class="text-heading-6 flex pb-2">Proactive notifications</h4><div class="font-sans! font-normal! text-current/70 space-y-3"><p>Keep customers informed about new features, known issues, and policy changes with in-product messages, mobile push notifications, and banners.</p></div></div></div><style>@keyframes carouselAutoplay { from { transform: scaleX(0); } to { transform: scaleX(1); } }</style><div class="absolute left-0 top-0 h-0.5 w-full origin-left bg-helpdesk" style="animation:carouselAutoplay linear;opacity:0"></div></button><div class="peer-data-selected:opacity-100 text-body font-sans! font-normal! lg:ml-13 absolute bottom-0 left-0 mb-5 ml-11 text-black/70 opacity-60 group-hover/thumb:opacity-80"><a class="text-inline-link focus-visible:outline-2 focus-visible:outline-offset-2" href="/helpdesk/outbound">Learn more</a></div></div><div class="group/thumb relative flex-1"><button type="button" class="focus-visible:outline-2 focus-visible:outline-offset-2 data-selected:bg-black/3 data-selected:opacity-100 group peer relative flex h-full w-full cursor-pointer flex-col text-left opacity-60 group-hover/thumb:opacity-80 data-selected:flex-1 min-h-32 flex-none overflow-hidden"><div class="flex h-full gap-4 p-6 lg:gap-6 pb-12"><span aria-hidden="true" class="mt-1 block size-2 shrink-0 bg-helpdesk"></span><div class="flex flex-col"><h4 class="text-heading-6 flex pb-2">Targeted messaging sequences</h4><div class="font-sans! font-normal! text-current/70 space-y-3"><p>Build omnichannel message journeys with a no-code visual builder, targeting customers precisely based on live behavioral data, product usage, and custom attributes.</p></div></div></div><style>@keyframes carouselAutoplay { from { transform: scaleX(0); } to { transform: scaleX(1); } }</style><div class="absolute left-0 top-0 h-0.5 w-full origin-left bg-helpdesk" style="animation:carouselAutoplay linear;opacity:0"></div></button><div class="peer-data-selected:opacity-100 text-body font-sans! font-normal! lg:ml-13 absolute bottom-0 left-0 mb-5 ml-11 text-black/70 opacity-60 group-hover/thumb:opacity-80"><a class="text-inline-link focus-visible:outline-2 focus-visible:outline-offset-2" href="/helpdesk/outbound">Learn more</a></div></div></div></div></div><div class="@4xl:hidden block"><div data-orientation="vertical" dir="ltr" role="region"><div data-orientation="vertical" data-index="-1" data-open="" class="border-linen data-open:bg-off-white data-open:opacity-100 border border-b-0 opacity-60 last:border-b"><h3 data-orientation="vertical" data-index="-1" data-open="" class="group"><button type="button" data-value="0" data-orientation="vertical" data-index="-1" data-panel-open="" tabindex="0" aria-disabled="false" aria-controls="base-ui-_R_qdb5fknpivodbH1_" aria-expanded="true" id="base-ui-_R_qdb5fknpivodbH2_" class="focus-visible:z-1 group relative items-baseline justify-between text-left focus-visible:outline-2 focus-visible:outline-blue-800 flex w-full flex-col p-5"><h4 class="text-heading-5 mb-6 flex w-full items-start gap-3"><span class="min-w-0 flex-1">Onboarding tools</span><span class="shrink-0"><span class="group-data-open:hidden block">+</span><span class="group-data-open:block hidden">-</span></span></h4><div class="text-current/70 space-y-2"><p class="text-body font-sans! font-normal! mt-2">Onboard customers with interactive product tours, checklists, and in-app tooltips, so they get up to speed faster and get more value from your product, all without contacting support.</p></div></button></h3><div data-orientation="vertical" 