00\",\"last_publication_date\":\"2025-09-18T12:53:03+0000\",\"slugs\":[\"consent-settings\"],\"linked_documents\":[],\"lang\":\"en-us\",\"alternate_languages\":[{\"id\":\"ZlbLvhEAACoAdofU\",\"type\":\"consentSettings\",\"lang\":\"zh-cn\"},{\"id\":\"ZlbM7REAACsAdonv\",\"type\":\"consentSettings\",\"lang\":\"ja-jp\"},{\"id\":\"ZlbMZhEAAC0Adokl\",\"type\":\"consentSettings\",\"lang\":\"it-it\"},{\"id\":\"ZgQ01BIAACEAoQkk\",\"type\":\"consentSettings\",\"lang\":\"fr-fr\"}],\"data\":{\"dataConsent\":[{\"type\":\"paragraph\",\"text\":\"I agree that my data will be processed in accordance with LVMH Personal Data Protection Policy.\",\"spans\":[{\"start\":63,\"end\":94,\"type\":\"hyperlink\",\"data\":{\"id\":\"ZhZDsxEAACMAGpoY\",\"type\":\"page\",\"tags\":[\"Footer\"],\"lang\":\"en-us\",\"slug\":\"personal-data\",\"first_publication_date\":\"2024-04-10T07:46:00+0000\",\"last_publication_date\":\"2025-04-03T18:25:16+0000\",\"uid\":\"personal-data\",\"data\":{\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Personal Data\",\"spans\":[]}],\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH Corporate Website Personal Data Protection Policy\",\"spans\":[]}]},\"link_type\":\"Document\",\"isBroken\":false}}]}],\"userDataConsent\":[{\"type\":\"paragraph\",\"text\":\"I have read, understood, and accepted the data privacy statement associated with the creation of a candidate account.\",\"spans\":[],\"direction\":\"ltr\"}],\"cornerstoneDatabaseConsent\":[{\"type\":\"paragraph\",\"text\":\"I have read, understood, and accepted the data privacy statement associated with the application data.\",\"spans\":[]}],\"talentDatabaseConsent\":[{\"type\":\"paragraph\",\"text\":\"I agree that my application data may be shared with all LVMH group companies.\",\"spans\":[]}],\"contactFormConsent\":[{\"type\":\"paragraph\",\"text\":\"Your data are collected by LVMH, the data controller, for the purpose of processing your request and to respond to your questions. Your data will be processed in accordance with our Personal Data Protection Policy. You may at any time exercise your rights of access, correction and deletion of your personal data by using the contact form.\",\"spans\":[{\"start\":326,\"end\":338,\"type\":\"hyperlink\",\"data\":{\"id\":\"ZkTNnBIAACMAMlzO\",\"type\":\"contact\",\"tags\":[\"Footer\"],\"lang\":\"en-us\",\"slug\":\"contact\",\"first_publication_date\":\"2024-05-15T14:59:35+0000\",\"last_publication_date\":\"2026-05-07T14:43:51+0000\",\"uid\":\"contact\",\"data\":{\"pageTitle\":[{\"type\":\"heading2\",\"text\":\"Contact\",\"spans\":[]}],\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH website contact form\",\"spans\":[]}]},\"link_type\":\"Document\",\"isBroken\":false}}]}],\"orderPublicationConsent\":[{\"type\":\"paragraph\",\"text\":\"Modifying your personal data: any personal data collected is used digitally to manage the distribution of our newsletters. If you wish to read our personal data charter, click here.\",\"spans\":[]},{\"type\":\"paragraph\",\"text\":\"According to the law no.78-17 of January 6, 1978, you have the right to access, modify or remove any of your personal information. You also have the right to refuse the use of this data if a legitimate reason can be given.  You may exercise this right by contacting the following address  [Protection des données personnelles LVMH – Direction de la Communication – 22 avenue Montaigne – 75008 Paris – France] or using our contact form.\",\"spans\":[{\"start\":422,\"end\":434,\"type\":\"hyperlink\",\"data\":{\"id\":\"ZkTNnBIAACMAMlzO\",\"type\":\"contact\",\"tags\":[\"Footer\"],\"lang\":\"en-us\",\"slug\":\"contact\",\"first_publication_date\":\"2024-05-15T14:59:35+0000\",\"last_publication_date\":\"2026-05-07T14:43:51+0000\",\"uid\":\"contact\",\"data\":{\"pageTitle\":[{\"type\":\"heading2\",\"text\":\"Contact\",\"spans\":[]}],\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH website contact form\",\"spans\":[]}]},\"link_type\":\"Document\",\"isBroken\":false}}]}],\"popinTitle\":[{\"type\":\"paragraph\",\"text\":\"Update your consent preferences\",\"spans\":[]}],\"userDataConsent_uncheck\":[{\"type\":\"paragraph\",\"text\":\"Withdrawing consent for the storage of data linked to your candidate portal will result in the deletion of your portal and associated data (favorites, application drafts, etc.). \",\"spans\":[]},{\"type\":\"paragraph\",\"text\":\"Your application data will not be deleted. The data will be deleted within the period described in the data privacy policy associated with the application data.\",\"spans\":[]},{\"type\":\"paragraph\",\"text\":\"Once you confirm, you will be logged out and redirected to the home page.\",\"spans\":[]}],\"cornerstoneDatabaseConsent_uncheck\":[{\"type\":\"paragraph\",\"text\":\"Withdrawing consent for the storage of application data will result in the deletion of all applications in your portal.  \",\"spans\":[]},{\"type\":\"paragraph\",\"text\":\"If you still have applications in progress, you will no longer be considered for the position(s).\",\"spans\":[]}],\"talentDatabaseConsent_check\":[{\"type\":\"paragraph\",\"text\":\"By consenting to share your data with all LVMH Group companies, your application information will be accessible to all companies within the Group.  They may contact you with offers that match your profile.\",\"spans\":[]}],\"talentDatabaseConsent_uncheck\":[{\"type\":\"paragraph\",\"text\":\"Withdrawing your consent to share your data with all LVMH Group companies will result in your application data no longer being shared with companies to which you have not applied.\",\"spans\":[]}]}},\"children\":[\"$\",\"$L1c4\",null,{\"popupContent\":{\"title\":[{\"type\":\"paragraph\",\"text\":\"Redirection Notice\",\"spans\":[],\"direction\":\"ltr\"}],\"description\":[{\"type\":\"paragraph\",\"text\":\"To continue with your application, you will be redirected to a platform hosted in Chinese Mainland. Please be aware that your data will be directly collected and stored on this platform. Do you wish to proceed?\",\"spans\":[{\"start\":82,\"end\":98,\"type\":\"strong\"}],\"direction\":\"ltr\"}],\"confirmButtonText\":\"Confirm\",\"cancelButtonText\":\"Cancel\"},\"children\":[\"$\",\"$L1c5\",null,{\"popupContent\":{\"importFilesModalTitle\":[{\"type\":\"paragraph\",\"text\":\"Upload a document\",\"spans\":[]}],\"importFileModalTitle\":[{\"type\":\"paragraph\",\"text\":\"Upload a document\",\"spans\":[]}],\"accountSuppressionTitle\":[{\"type\":\"paragraph\",\"text\":\"ACCOUNT SUPPRESSION\",\"spans\":[]}],\"accountSuppressionPopoverContent\":[{\"type\":\"paragraph\",\"text\":\"I understand that my account will be deleted, and I will be logged out\",\"spans\":[]}]},\"children\":[\"$\",\"$L1c6\",null,{\"document\":{\"id\":\"ZgQXYxIAACEAoHut\",\"uid\":null,\"url\":null,\"type\":\"loginRegisterPopup\",\"href\":\"https://lvmh-com.cdn.prismic.io/api/v2/documents/search?ref=akOhnxIAACwAxmf6\u0026integrationFieldsRef=lvmh-com%7E77f554dc-ca55-496b-8aac-a91f1c3ffc93\u0026q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ZgQXYxIAACEAoHut%22%29+%5D%5D\",\"tags\":[],\"first_publication_date\":\"2024-03-27T12:56:07+0000\",\"last_publication_date\":\"2024-07-03T07:09:26+0000\",\"slugs\":[\"login--register-popup\"],\"linked_documents\":[],\"lang\":\"en-us\",\"alternate_languages\":[{\"id\":\"ZenG5RAAACIA_dFs\",\"type\":\"loginRegisterPopup\",\"lang\":\"fr-fr\"},{\"id\":\"ZlQkmxIAAC4AMJrd\",\"type\":\"loginRegisterPopup\",\"lang\":\"it-it\"},{\"id\":\"ZlQvIhIAACgAMKni\",\"type\":\"loginRegisterPopup\",\"lang\":\"ja-jp\"},{\"id\":\"ZlQy8xIAACsAMK8A\",\"type\":\"loginRegisterPopup\",\"lang\":\"zh-cn\"}],\"data\":{\"loginModalTitle\":[{\"type\":\"paragraph\",\"text\":\"To apply for this job, log in or create an account\",\"spans\":[{\"start\":23,\"end\":30,\"type\":\"em\"},{\"start\":33,\"end\":50,\"type\":\"em\"}]}],\"loginModalDescription\":[{\"type\":\"paragraph\",\"text\":\"In your candidate portal, you will be able to track your applications,