}\n34c:{\"width\":2953,\"height\":1996}\n34d:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}\n34b:{\"dimensions\":\"$34c\",\"alt\":\"Decorative image\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/f9629d05-73d4-46af-b8a3-0ffea8912b82_Distrubution+Se%CC%81lective.png?auto=compress,format\",\"id\":\"Zjjl3REAACEAwKJ_\",\"edit\":\"$34d\"}\n348:{\"dimensions\":\"$349\",\"alt\":\"Cover - Selective Retailing\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/f9629d05-73d4-46af-b8a3-0ffea8912b82_Distrubution+Se%CC%81lective.png?auto=compress,format\",\"id\":\"Zjjl3REAACEAwKJ_\",\"edit\":\"$34a\",\"mobile\":\"$34b\"}\n350:[]\n34f:{\"type\":\"paragraph\",\"text\":\"This sector brings together businesses that share a commitment to excellence, along with a passion for culture, along with a distinctive art de vivre.\",\"spans\":\"$350\"}\n34e:[\"$34f\"]\n353:[]\n352:{\"type\":\"paragraph\",\"text\":\"Other activities\",\"spans\":\"$353\"}\n351:[\"$352\"]\n355:{\"width\":2362,\"height\":2000}\n356:{\"x\":0,\"y\":-476,\"zoom\":1,\"background\":\"#fff\"}\n358:{\"width\":2362,\"height\":2953}\n359:{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}\n357:{\"dimensions\":\"$358\",\"alt\":\"Decorative image\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/966a3dc9-3099-4a17-b7f7-9fb125f924a9_Autres+Activite%CC%81s.jpg?auto=compress,format\",\"id\":\"ZjjkmxEAAB8AwKCm\",\"edit\":\"$359\"}\n354:{\"dimensions\":\"$355\",\"alt\":\"Cover - Other activities\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/966a3dc9-3099-4a17-b7f7-9fb125f924a9_Autres+Activite%CC%81s.jpg?auto=compress,format\u0026rect=0,476,2362,2000\u0026w=2362\u0026h=2000\",\"id\":\"ZjjkmxEAAB8AwKCm\",\"edit\":\"$356\",\"mobile\":\"$357\"}\n"])</script><script>self.__next_f.push([1,"2a4:[\"$\",\"div\",null,{\"className\":\"navigationColumn flex h-full  flex-col  justify-between\\n        pb-4 pt-6\",\"children\":[[\"$\",\"ul\",null,{\"className\":\"flex min-h-fit w-full flex-1 flex-col \",\"children\":[[[\"$\",\"li\",null,{\"className\":\"py-2 \",\"children\":[\"$\",\"$L2c6\",null,{\"small\":\"$undefined\",\"item\":{\"id\":\"primary_link_Group\",\"link\":{\"link_type\":\"Any\"},\"label\":\"Group\",\"sublevel\":{\"id\":\"ZfRrUREAACIAoeuS\",\"bottomLink\":{\"link\":{\"link_type\":\"Any\"},\"label\":\"$undefined\"},\"description\":[{\"type\":\"paragraph\",\"text\":\"A family-run group, LVMH strives to ensure the long-term development of each of its Maisons in keeping with their identity, their heritage and their expertise.\",\"spans\":[],\"direction\":\"ltr\"}],\"links\":[{\"links\":[{\"id\":\"subnav_ZfRrUREAACIAoeuS_0\",\"link\":{\"id\":\"ZkS9nRIAACEAMkJ8\",\"uid\":\"history\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH was created in 1987 through the merger of Moët Hennessy and Louis Vuitton, ushering in a new era for the luxury industry.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"History\",\"spans\":[]}],\"miniature_image\":{\"dimensions\":{\"width\":2190,\"height\":1369},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/ZkYfLyol0Zci9Nnf_Paris.jpg?auto=format,compress?auto=compress,format\",\"id\":\"ZkYfLyol0Zci9Nnf\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":2190,\"height\":1369},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/ZkYfLyol0Zci9Nnf_Paris.jpg?auto=format,compress?auto=compress,format\",\"id\":\"ZkYfLyol0Zci9Nnf\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"History\"},{\"id\":\"subnav_ZfRrUREAACIAoeuS_1\",\"link\":{\"id\":\"ZiEkbhEAACYAsZUJ\",\"uid\":\"our-mission\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The world leader in luxury, LVMH has since its founding in 1987 deployed a business model marked by creative momentum and a constant quest for excellence.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Our mission\",\"spans\":[]}],\"miniature_image\":{\"dimensions\":{\"width\":12000,\"height\":12000},\"alt\":\"Cover - Our mission\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zl2sfaWtHYXtUBhQ_Pattern_1x1.jpg?auto=format,compress?auto=compress,format\",\"id\":\"Zl2sfaWtHYXtUBhQ\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":12000,\"height\":12000},\"alt\":\"Cover - Our mission\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zl2sfaWtHYXtUBhQ_Pattern_1x1.jpg?auto=format,compress?auto=compress,format\",\"id\":\"Zl2sfaWtHYXtUBhQ\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Mission\"},{\"id\":\"subnav_ZfRrUREAACIAoeuS_2\",\"link\":{\"id\":\"Zbv5uhAAACIA9h9O\",\"uid\":\"governance\",\"lang\":\"en-us\",\"type\":\"governance\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Consult the Profiles of members of the LVMH Executive Committee and Board of Directors, as well as the rules of conduct and action principles to guide the behavior of all Group’s employees and stakeholders.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"heading2\",\"text\":\"Governance \u0026 Ethics\",\"spans\":[{\"start\":10,\"end\":19,\"type\":\"em\"}]}],\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Governance \u0026 Ethics\"},{\"id\":\"subnav_ZfRrUREAACIAoeuS_3\",\"link\":{\"id\":\"ZiEF6REAACkAsR6q\",\"uid\":\"our-model\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH's mission is to ensure the development of each of its Maisons by providing them with all the resources they need to create, manufacture and distribute products and services that prioritize outstanding quality and the highest ethical, social and environmental standards.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Our model\",\"spans\":[]}],\"miniature_image\":{\"dimensions\":{\"width\":2704,\"height\":2277},\"alt\":\"Cover - Our model\",\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zl7opZm069VX1b_1_header-pattern.jpg?auto=format,compress?auto=compress,format\",\"id\":\"Zl7opZm069VX1b_1\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":2704,\"height\":2277},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zl7opZm069VX1b_1_header-pattern.jpg?auto=format,compress?auto=compress,format\",\"id\":\"Zl7opZm069VX1b_1\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Business Model\"},{\"id\":\"subnav_ZfRrUREAACIAoeuS_4\",\"link\":{\"id\":\"ZkXIgBAAACMAp4Sq\",\"uid\":\"economic-impact\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The economic impact of the LVMH Group, notably in France, largely surpasses the positive impact of its business activities alone.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Economic impact\",\"spans\":[]}],\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Economic impact\"},{\"id\":\"subnav_ZfRrUREAACIAoeuS_5\",\"link\":{\"id\":\"ZnQlVxEAACcAJtZX\",\"uid\":\"special-events\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Special events organized by LVMH or our partners are key moments in the Group's communications.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Special events\",\"spans\":[]}],\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Special events\"}]}],\"pushs\":{\"title\":\"Highlight\",\"primary\":{\"push\":{\"id\":\"ajKSfhEAACgA-Fbm\",\"uid\":\"for-vivatechs-10th-anniversary-lvmh-showcases-how-innovation-drives-every-stage-of-its-value-chain\",\"lang\":\"en-us\",\"type\":\"news\",\"link_type\":\"Document\",\"isBroken\":false,\"tags\":[],\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Co-founded in 2016 by Les Échos–Le Parisien Group and Publicis Group, VivaTech has established itself over the years as one of the most influential technology events in Europe, bringing together startups, major corporations, investors, and thought leaders.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"heading1\",\"text\":\"LVMH marks VivaTech’s 10th Anniversary \",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":5834,\"height\":3881},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/ajLR341P9HI4UpLw_COVERSITEOK.jpg?auto=format,compress\",\"id\":\"ajLR341P9HI4UpLw\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensions\":{\"width\":5834,\"height\":3881},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/ajLR341P9HI4UpLw_COVERSITEOK.jpg?auto=format,compress\",\"id\":\"ajLR341P9HI4UpLw\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"}},\"buttonLabel\":\"Learn more\"},\"simpleList\":\"$undefined\"},\"primaryLink\":{\"link\":{\"link_type\":\"Any\"},\"label\":\"$undefined\"},\"secondaryLinks\":[{\"id\":\"secondary_0\",\"label\":\"\",\"link\":{\"link_type\":\"Any\"}}],\"tertiaryLinks\":[],\"title\":{\"label\":[{\"type\":\"heading3\",\"text\":\"GROUP\",\"spans\":[{\"start\":0,\"end\":5,\"type\":\"em\"}]}],\"link\":{\"link_type\":\"Any\"}}}},\"displaySeoContent\":\"$undefined\"}]}],[\"$\",\"li\",null,{\"className\":\"py-2 \",\"children\":[\"$\",\"$L2c6\",null,{\"small\":\"$undefined\",\"item\":{\"id\":\"primary_link_Commitments\",\"link\":{\"link_type\":\"Any\"},\"label\":\"Commitments\",\"sublevel\":{\"id\":\"ZfRxqxEAAB8Aogji\",\"bottomLink\":{\"link\":{\"link_type\":\"Any\"},\"label\":\"$undefined\"},\"description\":[{\"type\":\"paragraph\",\"text\":\"Committed to positive impact, LVMH actively supports social, environmental and cultural initiatives with a long-term vision, in order to make a lasting difference. The Group works closely with numerous stakeholders that address important social issues.\",\"spans\":[]}],\"links\":[{\"links\":[{\"id\":\"subnav_ZfRxqxEAAB8Aogji_0\",\"link\":{\"id\":\"ZldhHREAACgAd2oT\",\"uid\":\"commitment-in-action\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The LVMH Group strengthens its long-standing social and environmental responsibility commitment through robust roadmaps.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Commitment in action\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":8000,\"height\":4919},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aGKuuXfc4bHWi3Tn_ART-CULTURE_BLUE-site.jpg?auto=format,compress\",\"id\":\"aGKuuXfc4bHWi3Tn\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensions\":{\"width\":8000,\"height\":4919},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aGKuuXfc4bHWi3Tn_ART-CULTURE_BLUE-site.jpg?auto=format,compress\",\"id\":\"aGKuuXfc4bHWi3Tn\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Our commitment in action\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_1\",\"link\":{\"id\":\"Zh_KUhEAACkAq8cC\",\"uid\":\"ethics-and-compliance\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Every action taken by the Group and its employees reflects LVMH’s commitment to ethics and social and environmental responsibility. \",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"heading1\",\"text\":\"Ethics and compliance\",\"spans\":[]}],\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Our ethics \u0026 compliance approach\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_2\",\"link\":{\"id\":\"ZlQ_0BIAAC4AMMQM\",\"uid\":\"for-people\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH’s social responsibility strategy is long-term and puts men and women at the core of its initiatives. It is structured around a global road map.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"For People\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":2880,\"height\":1312},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/a1ff0f9d-ee56-4154-8b36-faa94ac56fc8_HEADER+%281%29.png?auto=format,compress?auto=compress,format\",\"id\":\"Zj3_9BEAAB8Ax_He\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":2880,\"height\":1312},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/a1ff0f9d-ee56-4154-8b36-faa94ac56fc8_HEADER+%281%29.png?auto=format,compress?auto=compress,format\",\"id\":\"Zj3_9BEAAB8Ax_He\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"For People\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_3\",\"link\":{\"id\":\"ZlXcIxEAACcAdS_k\",\"uid\":\"for-the-environment\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The LVMH Group is using the power of its influence to galvanize the luxury industry through concrete actions and to drive far-reaching changes to help protect ecosystems. \",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"For the Environment\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":2894,\"height\":3543},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/ZlROWCk0V36pXpeB_engagement_environnement.jpg?auto=format,compress?auto=compress,format\",\"id\":\"ZlROWCk0V36pXpeB\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":2894,\"height\":3543},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/ZlROWCk0V36pXpeB_engagement_environnement.jpg?auto=format,compress?auto=compress,format\",\"id\":\"ZlROWCk0V36pXpeB\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"For the Environment\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_4\",\"link\":{\"id\":\"ZldZRxEAACsAd17h\",\"uid\":\"for-philanthropy\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The Group and its Maisons serve the general interest in France and around the world, enabling the widest possible access to art, heritage and arts education, and supporting medical research and social solidarity initiatives.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"For Philanthropy\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":3858,\"height\":4724},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zkdw4iol0Zci9Pz9_Group03-BLUE-LAYERS.jpeg?auto=format,compress?auto=compress,format\",\"id\":\"Zkdw4iol0Zci9Pz9\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":3858,\"height\":4724},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/Zkdw4iol0Zci9Pz9_Group03-BLUE-LAYERS.jpeg?auto=format,compress?auto=compress,format\",\"id\":\"Zkdw4iol0Zci9Pz9\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"For Philanthropy\"},{\"id\":\"subnav_ZfRxqxEAAB8Aogji_5\",\"link\":{\"id\":\"Zn01_BIAAC4Aj9Op\",\"uid\":\"all-our-actions\",\"lang\":\"en-us\",\"type\":\"page\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"The Group has already put in place numerous initiatives in the area of social and environmental responsibility, with the active involvement of its employees and partners. \",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"All our actions\",\"spans\":[]}],\"miniature_image\":{},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"All our actions\"}]}],\"pushs\":{\"title\":\"Highlight\",\"primary\":{\"push\":{\"id\":\"aiLdhhEAAC4AJ2JR\",\"uid\":\"on-world-environment-day-lvmh-shines-a-light-on-regenerative-agriculture\",\"lang\":\"en-us\",\"type\":\"news\",\"link_type\":\"Document\",\"isBroken\":false,\"tags\":[],\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"LVMH reaffirms its commitment to regenerative agriculture, a key lever of its LIFE 360 environmental strategy. Through several initiatives deployed across its supply chains, the Group upholds a strong conviction: to create for the long term, one must return to the source.\",\"spans\":[],\"direction\":\"ltr\"}],\"pageTitle\":[{\"type\":\"heading1\",\"text\":\"On World Environment Day, LVMH shines a light on regenerative agriculture\",\"spans\":[],\"direction\":\"ltr\"}],\"miniature_image\":{\"dimensions\":{\"width\":4000,\"height\":2667},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aiLgigeQX7-eW4y3_NEWS_AGRI_REGENERATRICE-4-.jpg?auto=format,compress\",\"id\":\"aiLgigeQX7-eW4y3\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"},\"mobile\":{\"dimensions\":{\"width\":4000,\"height\":2667},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/aiLgigeQX7-eW4y3_NEWS_AGRI_REGENERATRICE-4-.jpg?auto=format,compress\",\"id\":\"aiLgigeQX7-eW4y3\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"transparent\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"}},\"buttonLabel\":\"Learn more\"},\"simpleList\":[]},\"primaryLink\":{\"link\":{\"link_type\":\"Any\"},\"label\":\"$undefined\"},\"secondaryLinks\":[{\"id\":\"secondary_0\",\"label\":\"\",\"link\":{\"link_type\":\"Any\"}}],\"tertiaryLinks\":[],\"title\":{\"label\":[{\"type\":\"heading3\",\"text\":\"COMMITMENTS\",\"spans\":[{\"start\":0,\"end\":11,\"type\":\"em\"}]}],\"link\":{\"link_type\":\"Any\"}}}},\"displaySeoContent\":\"$undefined\"}]}],[\"$\",\"li\",null,{\"className\":\"py-2 \",\"children\":[\"$\",\"$L2c6\",null,{\"small\":\"$undefined\",\"item\":{\"id\":\"primary_link_Maisons\",\"link\":{\"link_type\":\"Any\"},\"label\":\"Maisons\",\"sublevel\":{\"id\":\"ZNY3dBAAACYAnmAr\",\"bottomLink\":{\"link\":{\"link_type\":\"Any\"},\"label\":\"$undefined\"},\"description\":[{\"type\":\"paragraph\",\"text\":\"LVMH is home to more than 75 distinguished Maisons rooted in six different sectors. True to tradition, each of our brands builds on a specialty legacy while keeping an unwavering focus on the exquisite caliber of its products.\",\"spans\":[],\"direction\":\"ltr\"}],\"links\":[{\"links\":[{\"id\":\"subnav_house_ZNY3dBAAACYAnmAr_0\",\"link\":{\"id\":\"ZNYyzxAAACgAnkl8\",\"uid\":\"wines-spirits\",\"lang\":\"en-us\",\"type\":\"houseActivity\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\":\"paragraph\",\"text\":\"Our portfolio of Wines \u0026 Spirits Maisons, each synonymous with excellence and authenticity, is unparalleled in the world.\",\"spans\":[]}],\"pageTitle\":[{\"type\":\"paragraph\",\"text\":\"Wines \u0026 Spirits\",\"spans\":[]}],\"miniature_image\":{\"dimensions\":{\"width\":2362,\"height\":2953},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/72af9bca-f7f8-4ea6-89e2-f3b56adb5057_Vins%26Spiritueux.jpg?auto=compress,format\",\"id\":\"ZjiVcxEAACQAwCq5\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"},\"mobile\":{\"dimensions\":{\"width\":2362,\"height\":2953},\"alt\":null,\"copyright\":null,\"url\":\"https://images.prismic.io/lvmh-com/72af9bca-f7f8-4ea6-89e2-f3b56adb5057_Vins%26Spiritueux.jpg?auto=compress,format\",\"id\":\"ZjiVcxEAACQAwCq5\",\"edit\":{\"x\":0,\"y\":0,\"zoom\":1,\"background\":\"#fff\"}}},\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Wines \u0026 Spirits\",\"thirdLevel\":{\"id\":\"ZNYyzxAAACgAnkl8\",\"title\":\"Wines \u0026 Spirits\",\"levelMainLink\":{\"link\":{\"id\":\"ZNYyzxAAACgAnkl8\",\"uid\":\"wines-spirits\",\"lang\":\"en-us\",\"type\":\"houseActivity\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":\"$312\",\"pageTitle\":\"$315\",\"miniature_image\":\"$318\",\"file\":\"$undefined\",\"buttonLink\":\"$undefined\"},\"tags\":[]},\"label\":\"Home Wines \u0026 Spirits\"},\"topLinks\":{\"links\":[{\"id\":\"top_list_ZNYyzxAAACgAnkl8_0\",\"link\":{\"id\":\"ZgGNkBAAACoAcyJ6\",\"uid\":\"hennessy\",\"lang\":\"en-us\",\"type\":\"house\",\"link_type\":\"Document\",\"isBroken\":false,\"data\":{\"short_description\":[{\"type\"