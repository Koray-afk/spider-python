on\":\"Declare a workflow block's identity, copy, and config schema\",\"href\":\"/sdk/workflows/define-workflow-block\"},{\"title\":\"Config schema\",\"description\":\"Node types for declaring configurable fields in a workflow block\",\"href\":\"/sdk/workflows/config-schema\"},{\"title\":\"Outcome schema\",\"description\":\"Node types for typing outcome data returned from workflow block handlers\",\"href\":\"/sdk/workflows/outcome-schema\"}]},{\"title\":\"Configurator\",\"description\":\"Render config inputs and declare outcomes in the workflow editor\",\"href\":\"/sdk/workflows/configurator\"},{\"title\":\"Block lifecycle\",\"description\":\"How Attio calls your workflow block handlers across a run\",\"href\":\"/sdk/workflows/block-lifecycle\"},{\"group\":\"Step handlers\",\"pages\":[{\"title\":\"Executing a step\",\"description\":\"Define the execute handler for a step block\",\"href\":\"/sdk/workflows/define-workflow-block-execute\"},{\"title\":\"Finishing a deferred step\",\"description\":\"Define the finish handler for a deferred step block\",\"href\":\"/sdk/workflows/define-workflow-block-resume-callback\"}]},{\"group\":\"Trigger handlers\",\"pages\":[{\"title\":\"Registering a trigger\",\"description\":\"Define the activate handler for a trigger block\",\"href\":\"/sdk/workflows/define-workflow-block-activate\"},{\"title\":\"Receiving a trigger event\",\"description\":\"Define the event handler for a trigger block\",\"href\":\"/sdk/workflows/define-workflow-block-on-trigger-callback\"},{\"title\":\"Deactivating a trigger\",\"description\":\"Define the deactivate handler for a trigger block\",\"href\":\"/sdk/workflows/define-workflow-block-deactivate\"}]}]},{\"group\":\"Entry points\",\"pages\":[{\"title\":\"App configuration file\",\"sidebarTitle\":\"app.ts\",\"description\":\"Register all your entry points in one place\",\"href\":\"/sdk/entry-points/app-ts\"},{\"title\":\"Record action\",\"sidebarTitle\":\"Record action\",\"description\":\"Registers an action for records in Attio\",\"href\":\"/sdk/entry-points/record-action\"},{\"title\":\"Bulk record action\",\"sidebarTitle\":\"Bulk record action\",\"description\":\"Registers a bulk action for records in Attio\",\"href\":\"/sdk/entry-points/bulk-record-action\"},{\"title\":\"Record widget\",\"sidebarTitle\":\"Record widget\",\"description\":\"Record Widgets are a way to show information on record pages.\",\"href\":\"/sdk/entry-points/record-widget\"},{\"title\":\"Workspace settings\",\"sidebarTitle\":\"Workspace settings\",\"description\":\"Add configurable workspace-level settings to your app\",\"href\":\"/sdk/entry-points/workspace-settings\"},{\"group\":\"Text selection\",\"pages\":[{\"title\":\"Call recording transcript text selection action\",\"sidebarTitle\":\"Call recording transcript\",\"description\":\"Call recording transcript text selection actions are a way to perform an action based on a text selection on a call recording transcript.\",\"href\":\"/sdk/entry-points/call-recording-transcript-text-selection-action\"},{\"title\":\"Call recording insight text selection action\",\"sidebarTitle\":\"Call recording insights\",\"description\":\"Call recording insights text selection actions are a way to perform an action based on a text selection on a call recording insights.\",\"href\":\"/sdk/entry-points/call-recording-insight-text-selection-action\"},{\"title\":\"Call recording summary text selection action\",\"sidebarTitle\":\"Call recording summary\",\"description\":\"Call recording summary text selection actions are a way to perform an action based on a text selection on a call recording summary.\",\"href\":\"/sdk/entry-points/call-recording-summary-text-selection-action\"}]}]},{\"group\":\"Notifications\",\"pages\":[{\"title\":\"Notifying the user\",\"description\":\"Methods to imperatively give feedback to the user\",\"href\":\"/sdk/notifications/notifications\"},{\"title\":\"alert()\",\"description\":\"Shows an alert to the user\",\"href\":\"/sdk/notifications/alert\"},{\"title\":\"confirm()\",\"description\":\"Shows a confirmation prompt to the user\",\"href\":\"/sdk/notifications/confirm\"},{\"title\":\"showToast()\",\"description\":\"Shows a toast to the user\",\"href\":\"/sdk/notifications/show-toast\"}]},{\"group\":\"Dialogs\",\"pages\":[{\"title\":\"showDialog()\",\"description\":\"Show a dialog box\",\"href\":\"/sdk/dialogs/show-dialog\"},{\"title\":\"\u003cDialogList /\u003e\",\"description\":\"A navigatable and clickable list of items in a dialog.\",\"href\":\"/sdk/dialogs/dialog-list\"}]},{\"group\":\"Components\",\"pages\":[{\"title\":\"\u003cAvatar /\u003e\",\"description\":\"An avatar component for displaying profile pictures or organization logos.\",\"href\":\"/sdk/components/avatar\"},{\"title\":\"\u003cBadge /\u003e\",\"description\":\"A colored badge of information.\",\"href\":\"/sdk/components/badge\"},{\"title\":\"\u003cBanner /\u003e\",\"description\":\"A component displaying important information to the user.\",\"href\":\"/sdk/components/banner\"},{\"title\":\"\u003cButton /\u003e\",\"description\":\"A button component.\",\"href\":\"/sdk/components/button\"},{\"title\":\"\u003cDescriptionList /\u003e\",\"description\":\"A component displaying label-value information.\",\"href\":\"/sdk/components/description-list\"},{\"title\":\"\u003cDivider /\u003e\",\"description\":\"A component for drawing a horizontal dividing line between UI elements.\",\"href\":\"/sdk/components/divider\"},{\"title\":\"\u003cJson /\u003e\",\"description\":\"A component for displaying JSON data, primarily used for debugging.\",\"href\":\"/sdk/components/json\"},{\"title\":\"\u003cLink /\u003e\",\"description\":\"A hyperlink to an external website.\",\"href\":\"/sdk/components/link\"},{\"title\":\"\u003cLoadingState /\u003e\",\"description\":\"A component for showing a loading spinner.\",\"href\":\"/sdk/components/loading-state\"},{\"title\":\"\u003cSection /\u003e\",\"description\":\"A section of UI with a title. It can be thought of like a `\u003cdiv/\u003e` in DOM.\",\"href\":\"/sdk/components/section\"},{\"title\":\"\u003cStatusBadge /\u003e\",\"description\":\"A component for displaying a status badge with a color.\",\"href\":\"/sdk/components/status-badge\"},{\"title\":\"\u003cTable /\u003e\",\"description\":\"A component for displaying tabular data.\",\"href\":\"/sdk/components/table\"},{\"title\":\"\u003cTextBlock /\u003e\",\"description\":\"A block of text whose content can be aligned.\",\"href\":\"/sdk/components/text-block\"},{\"title\":\"\u003cTypography /\u003e\",\"description\":\"A component to style text.\",\"href\":\"/sdk/components/typography\"},{\"group\":\"Forms\",\"pages\":[{\"title\":\"\u003cAttioRecordCombobox /\u003e\",\"description\":\"A combobox input for selecting Attio records.\",\"href\":\"/sdk/components/forms/attio-record-combobox\"},{\"title\":\"\u003cAttioUserCombobox /\u003e\",\"description\":\"A combobox input for selecting Attio workspace users.\",\"href\":\"/sdk/components/forms/attio-user-combobox\"},{\"title\":\"\u003cCheckbox /\u003e\",\"description\":\"A checkbox input field.\",\"href\":\"/sdk/components/forms/checkbox\"},{\"title\":\"\u003cCombobox /\u003e\",\"description\":\"A combobox input which allows searching for and selecting from a list of options.\",\"href\":\"/sdk/components/forms/combobox\"},{\"title\":\"\u003cDateTimeInput /\u003e\",\"description\":\"A date and time input field for selecting both date and time.\",\"href\":\"/sdk/components/forms/date-time-input\"},{\"title\":\"\u003cFieldset /\u003e\",\"description\":\"A fieldset component that groups related form inputs together with a legend.\",\"href\":\"/sdk/components/forms/fieldset\"},{\"title\":\"\u003cForm /\u003e\",\"description\":\"A component that wraps your form inputs and provides an `onSubmit` handler.\",\"href\":\"/sdk/components/forms/form\"},{\"title\":\"\u003cInputGroup /\u003e\",\"description\":\"A component for grouping inputs.\",\"href\":\"/sdk/components/forms/input-group\"},{\"title\":\"\u003cNumberInput /\u003e\",\"description\":\"A numeric input field.\",\"href\":\"/sdk/components/forms/number-input\"},{\"title\":\"\u003cPlainDateInput /\u003e\",\"description\":\"A date input field for selecting ISO 8601 dates (YYYY-MM-DD).\",\"href\":\"/sdk/components/forms/plain-date-input\"},{\"title\":\"\u003cRadioGroup /\u003e\",\"description\":\"A radio group input field for selecting a single option from a list.\",\"href\":\"/sdk/components/forms/radio-group\"},{\"title\":\"\u003cSubmitButton /\u003e\",\"description\":\"A submit button for the form.\",\"href\":\"/sdk/components/forms/submit-button\"},{\"title\":\"\u003cTextInput /\u003e\",\"description\":\"A string input field.\",\"href\":\"/sdk/components/forms/text-input\"},{\"title\":\"\u003cTextArea /\u003e\",\"description\":\"A multi-line text input field for longer string values.\",\"href\":\"/sdk/components/forms/text-area\"},{\"title\":\"\u003cToggle /\u003e\",\"description\":\"A toggle input field.\",\"href\":\"/sdk/components/forms/toggle\"},{\"title\":\"\u003cWithState /\u003e\",\"description\":\"A non-visual component to get form state when rendering JSX\",\"href\":\"/sdk/components/forms/with-state\"}]},{\"group\":\"Workspace settings\",\"pages\":[{\"title\":\"\u003cAttioUserCombobox /\u003e\",\"description\":\"A combobox input for selecting Attio workspace users.\",\"href\":\"/sdk/components/workspace-settings/attio-user-combobox\"},{\"title\":\"\u003cButton /\u003e\",\"description\":\"A button component.\",\"href\":\"/sdk/components/workspace-settings/button\"},{\"title\":\"\u003cCheckbox /\u003e\",\"description\":\"A checkbox input field.\",\"href\":\"/sdk/components/workspace-settings/checkbox\"},{\"title\":\"\u003cCombobox /\u003e\",\"description\":\"A combobox input.\",\"href\":\"/sdk/components/workspace-settings/combobox\"},{\"title\":\"\u003cFieldset /\u003e\",\"description\":\"A fieldset component that groups related workspace settings inputs together with a legend.\",\"href\":\"/sdk/components/workspace-settings/fieldset\"},{\"title\":\"\u003cForm /\u003e\",\"description\":\"A component that wraps your workspace settings inputs.\",\"href\":\"/sdk/components/workspace-settings/form\"},{\"title\":\"\u003cInputGroup /\u003e\",\"description\":\"A component for grouping inputs.\",\"href\":\"/sdk/components/workspace-settings/input-group\"},{\"title\":\"\u003cNumberInput /\u003e\",\"description\":\"A numeric input field.\",\"href\":\"/sdk/components/workspace-settings/number-input\"},{\"title\":\"\u003cRadioGroup /\u003e\",\"description\":\"A radio group input field for selecting a single option from a list.\",\"href\":\"/sdk/components/workspace-settings/radio-group\"},{\"title\":\"\u003cSection /\u003e\",\"description\":\"A section of UI with a title and optional description. It can be thought of like a `\u003cdiv/\u003e` in DOM.\",\"href\":\"/sdk/components/workspace-settings/section\"},{\"title\":\"\u003cTextInput /\u003e\",\"description\":\"A string input field.\",\"href\":\"/sdk/components/workspace-settings/text-input\"},{\"title\":\"\u003cToggle /\u003e\",\"description\":\"A toggle input field.\",\"href\":\"/sdk/components/workspace-settings/toggle\"},{\"title\":\"\u003cWithState /\u003e\",\"description\":\"A non-visual component to get form state when rendering JSX\",\"href\":\"/sdk/components/workspace-settings/with-state\"}]},{\"group\":\"Widgets\",\"pages\":[{\"title\":\"\u003cWidget.TextWidget /\u003e\",\"description\":\"Text widget that can be shown on a record page.\",\"href\":\"/sdk/components/widgets/text-widget\"},{\"title\":\"\u003cWidget.Title /\u003e\",\"description\":\"The title of the widget\",\"href\":\"/sdk/components/widgets/title\"},{\"title\":\"\u003cWidget.Text.Primary /\u003e\",\"description\":\"The primary text information in a widget.\",\"href\":\"/sdk/components/widgets/text-primary\"},{\"title\":\"\u003cWidget.Text.Secondary /\u003e\",\"description\":\"The secondary text information in a widget.\",\"href\":\"/sdk/components/widgets/text-secondary\"},{\"title\":\"\u003cWidget.Loading /\u003e\",\"description\":\"A loading state for a widget.\",\"href\":\"/sdk/components/widgets/loading\"},{\"title\":\"\u003cWidget.Decoration /\u003e\",\"description\":\"A component to show decorations inside a widget.\",\"href\":\"/sdk/components/widgets/decoration\"}]}]},{\"group\":\"Forms\",\"pages\":[{\"title\":\"Form schema\",\"description\":\"Defines the shape of your form data\",\"href\":\"/sdk/forms/form-schema\"},{\"title\":\"useForm()\",\"description\":\"A hook for creating forms inside your Attio app.\",\"href\":\"/sdk/forms/use-form\"}]},{\"group\":\"Icons\",\"pages\":[{\"title\":\"AttioIcon\",\"description\":\"Built-in icons\",\"href\":\"/sdk/icons\"}]},{\"group\":\"Settings\",\"pages\":[{\"title\":\"Workspace settings schema\",\"description\":\"Define the structure and types of your workspace settings.\",\"href\":\"/sdk/settings/app-settings-schema\"},{\"title\":\"useWorkspaceSettingsForm()\",\"description\":\"A hook for creating workspace settings forms inside your Attio app.\",\"href\":\"/sdk/settings/use-workspace-settings-form\"},{\"title\":\"useWorkspaceSettings()\",\"description\":\"A hook for accessing workspace settings values in your app\",\"href\":\"/sdk/settings/use-workspace-settings\"},{\"title\":\"getWorkspaceSettings()\",\"description\":\"Get all workspace settings values\",\"href\":\"/sdk/settings/get-workspace-settings\"},{\"title\":\"getWorkspaceSetting()\",\"description\":\"Get a single workspace setting value\",\"href\":\"/sdk/settings/get-workspace-setting\"},{\"title\":\"setWorkspaceSetting()\",\"description\":\"Set a single workspace setting value\",\"href\":\"/sdk/settings/set-workspace-setting\"}]},{\"group\":\"GraphQL\",\"pages\":[{\"title\":\"GraphQL\",\"description\":\"How the App SDK uses GraphQL to query Attio data\",\"href\":\"/sdk/graphql/graphql\"},{\"title\":\"runQuery()\",\"description\":\"Imperatively run an asynchronous GraphQL query\",\"href\":\"/sdk/graphql/run-query\"},{\"title\":\"useQuery()\",\"description\":\"A suspenseful hook to run a GraphQL query\",\"href\":\"/sdk/graphql/use-query\"}]},{\"group\":\"Data fetching\",\"pages\":[{\"title\":\"useAsyncCache()\",\"description\":\"A suspenseful hook that returns, and caches, the results of calling one or more async functions, typically to load data from a third-party via server functions.\",\"href\":\"/sdk/data-fetching/use-async-cache\"},{\"title\":\"React Query\",\"description\":\"How to use React Query with App SDK\",\"href\":\"/sdk/data-fetching/react-query\"}]},{\"group\":\"Server\",\"pages\":[{\"title\":\"Server functions\",\"description\":\"Running code on the server\",\"mode\":\"wide\",\"href\":\"/sdk/server/server-functions\"},{\"title\":\"Attio API Token\",\"description\":\"A token for your app to call the Attio REST API\",\"href\":\"/sdk/server/attio-api-token\"},{\"group\":\"Connections\",\"pages\":[{\"title\":\"Connections\",\"description\":\"Authentication to third party services\",\"href\":\"/sdk/server/connections/connections\"},{\"title\":\"getUserConnection()\",\"description\":\"Using a user connection.\",\"href\":\"/sdk/server/connections/get-user-connection\"},{\"title\":\"getWorkspaceConnection()\",\"description\":\"Using a workspace connection.\",\"href\":\"/sdk/server/connections/get-workspace-connection\"}]},{\"group\":\"Events\",\"pages\":[{\"title\":\"Events\",\"description\":\"App lifecycle events\",\"href\":\"/sdk/server/events/events\"},{\"title\":\"connection-added\",\"description\":\"Fires when a connection is added to an app\",\"href\":\"/sdk/server/events/connection-added\"},{\"title\":\"connection-removed\",\"description\":\"Fires when a connection is removed from an app\",\"href\":\"/sdk/server/events/connection-removed\"}]},{\"group\":\"Webhooks\",\"pages\":[{\"title\":\"Webhook Handlers\",\"description\":\"Server code that can be executed when called via HTTP from a third party\",\"href\":\"/sdk/server/webhooks/webhook-handlers\"},{\"title\":\"createWebhookHandler()\",\"description\":\"Creates a webhook handler\",\"href\":\"/sdk/server/webhooks/create-webhook-handler\"},{\"title\":\"deleteWebhookHandler()\",\"description\":\"Deletes a webhook handler\",\"href\":\"/sdk/server/webhooks/delete-webhook-handler\"},{\"title\":\"updateWebhookHandler()\",\"description\":\"Updates a webhook handler\",\"href\":\"/sdk/server/webhooks/update-webhook-handler\"}]},{\"title\":\"KV Store\",\"description\":\"A key-value store for your app\",\"href\":\"/sdk/server/kv-store\"}]},{\"group\":\"System\",\"pages\":[{\"title\":\"platform\",\"description\":\"Tells you which Attio platform your client code is running inside.\",\"href\":\"/sdk/system/platform\"}]}]},{\"tab\":\"REST API\",\"groups\":[{\"group\":\"Introduction\",\"pages\":[{\"title\":\"Overview\",\"description\":\"Learn about the REST API\",\"href\":\"/rest-api/overview\"}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"Authenticating requests\",\"description\":\"How to generate access tokens and make requests\",\"href\":\"/rest-api/guides/authentication\"},{\"title\":\"Handling rate limits\",\"description\":\"How to ensure your app handles rate limits gracefully\",\"href\":\"/rest-api/guides/rate-limiting\"},{\"title\":\"Filtering and sorting\",\"description\":\"Searching for just the records you need\",\"href\":\"/rest-api/guides/filtering-and-sorting\"},{\"title\":\"Paginating API results\",\"description\":\"Retrieving particular ranges of data\",\"href\":\"/rest-api/guides/pagination\"},{\"title\":\"Configuring webhooks\",\"description\":\"Responding to changes in real-time\",\"href\":\"/rest-api/guides/webhooks\"}]},{\"group\":\"Tutorials\",\"pages\":[{\"title\":\"Connect an app to Attio through OAuth\",\"description\":\"Learn how to create an OAuth 2.0 app to access Attio's REST API\",\"href\":\"/rest-api/tutorials/connect-an-app-through-oauth\"}]},{\"group\":\"Attribute types\",\"pages\":[{\"title\":\"Overview\",\"description\":null,\"href\":\"/rest-api/attribute-types/attribute-types\"},{\"title\":\"Actor reference\",\"description\":\"References to workspace members and others\",\"href\":\"/rest-api/attribute-types/attribute-types-actor-reference\"},{\"title\":\"Checkbox\",\"description\":\"Modelling boolean values\",\"href\":\"/rest-api/attribute-types/attribute-types-checkbox\"},{\"title\":\"Currency\",\"description\":\"More than just numbers\",\"href\":\"/rest-api/attribute-types/attribute-types-currency\"},{\"title\":\"Date\",\"description\":\"A timezone-less calendar date\",\"href\":\"/rest-api/attribute-types/attribute-types-date\"},{\"title\":\"Domain\",\"description\":\"An internet domain\",\"href\":\"/rest-api/attribute-types/attribute-types-domain\"},{\"title\":\"Email address\",\"description\":\"An email address\",\"href\":\"/rest-api/attribute-types/attribute-types-email-address\"},{\"title\":\"Interaction\",\"description\":\"Calendar events and emails\",\"href\":\"/rest-api/attribute-types/attribute-types-interaction\"},{\"title\":\"Location\",\"description\":\"A physical location in the world\",\"href\":\"/rest-api/attribute-types/attribute-types-location\"},{\"title\":\"(Personal) name\",\"description\":\"A person's name\",\"href\":\"/rest-api/attribute-types/attribute-types-personal-name\"},{\"title\":\"Number\",\"description\":\"Quantities, sums and metrics\",\"href\":\"/rest-api/attribute-types/attribute-types-number\"},{\"title\":\"Phone number\",\"description\":\"International telephone numbers\",\"href\":\"/rest-api/attribute-types/attribute-types-phone-number\"},{\"title\":\"Rating\",\"description\":\"Star ratings from 0 to 5\",\"href\":\"/rest-api/attribute-types/attribute-types-rating\"},{\"title\":\"Record reference\",\"description\":\"Relationships and one-way links between records\",\"href\":\"/rest-api/attribute-types/attribute-types-record-reference\"},{\"title\":\"Select\",\"description\":\"An option from a predefined list\",\"href\":\"/rest-api/attribute-types/attribute-types-select\"},{\"title\":\"Status\",\"description\":\"Similar to select attributes, originally designed for use in Lists\",\"href\":\"/rest-api/attribute-types/attribute-types-status\"},{\"title\":\"Text\",\"description\":\"Human-readable, unconstrained text inputs\",\"href\":\"/rest-api/attribute-types/attribute-types-text\"},{\"title\":\"Timestamp\",\"description\":\"A calendar date including time information, stored in UTC\",\"href\":\"/rest-api/attribute-types/attribute-types-timestamp\"}]},{\"group\":\"Endpoint reference\",\"pages\":[{\"title\":\"OpenAPI\",\"description\":\"Access the OpenAPI specification for the Attio REST API\",\"href\":\"/rest-api/endpoint-reference/openapi\"},{\"group\":\"Core endpoints\",\"pages\":[{\"group\":\"Objects\",\"pages\":[{\"title\":\"List objects\",\"description\":\"Lists all system-defined and user-defined objects in your workspace.\\n\\nRequired scopes: `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/objects\",\"href\":\"/rest-api/endpoint-reference/objects/list-objects\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create an object\",\"description\":\"Creates a new custom object in your workspace.\\n\\nRequired scopes: `object_configuration:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/objects\",\"href\":\"/rest-api/endpoint-reference/objects/create-an-object\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get an object\",\"description\":\"Gets a single object by its `object_id` or slug.\\n\\nRequired scopes: `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/objects/{object}\",\"href\":\"/rest-api/endpoint-reference/objects/get-an-object\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update an object\",\"description\":\"Updates a single object. The object to be updated is identified by its `object_id`.\\n\\nRequired scopes: `object_configuration:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api patch /v2/objects/{object}\",\"href\":\"/rest-api/endpoint-reference/objects/update-an-object\",\"autogeneratedByOpenApi\":true},{\"title\":\"List views for object\",\"description\":\"Lists saved views for an object. Results are ordered by view ID (`id.view_id` ascending).\\n\\nRequired scopes: `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/objects/{object}/views\",\"href\":\"/rest-api/endpoint-reference/objects/list-views-for-object\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Attributes\",\"pages\":[{\"title\":\"List attributes\",\"description\":\"Lists all attributes defined on a specific object or list. Attributes are returned in the order that they are sorted by in the UI.\\n\\nWhen `target` is `objects`, the required scopes are `object_configuration:read`. When `target` is `lists`, the required scopes are `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/{target}/{identifier}/attributes\",\"href\":\"/rest-api/endpoint-reference/attributes/list-attributes\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create an attribute\",\"description\":\"Creates a new attribute on either an object or a list.\\n\\nFor record-reference attributes, you can optionally create a bidirectional relationship by providing a `relationship` object. This will create two entangled attributes: one on the specified object and a reverse attribute on the related object.\\n\\nTo create an attribute on an object, you must also have the `object_configuration:read-write` scope.\\n\\nTo create an attribute on a list, you must also have the `list_configuration:read-write` scope.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/{target}/{identifier}/attributes\",\"href\":\"/rest-api/endpoint-reference/attributes/create-an-attribute\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get an attribute\",\"description\":\"Gets information about a single attribute on either an object or a list.\\n\\nWhen `target` is `objects`, the required scopes are `object_configuration:read`. When `target` is `lists`, the required scopes are `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/{target}/{identifier}/attributes/{attribute}\",\"href\":\"/rest-api/endpoint-reference/attributes/get-an-attribute\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update an attribute\",\"description\":\"Updates a single attribute on a given object or list.\\n\\nWhen `target` is `objects`, the required scopes are `object_configuration:read-write`. When `target` is `lists`, the required scopes are `list_configuration:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api patch /v2/{target}/{identifier}/attributes/{attribute}\",\"href\":\"/rest-api/endpoint-reference/attributes/update-an-attribute\",\"autogeneratedByOpenApi\":true},{\"title\":\"List select options\",\"description\":\"Lists all select options for a particular attribute on either an object or a list.\\n\\nWhen `target` is `objects`, the required scopes are `object_configuration:read`. When `target` is `lists`, the required scopes are `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/{target}/{identifier}/attributes/{attribute}/options\",\"href\":\"/rest-api/endpoint-reference/attributes/list-select-options\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a select option\",\"description\":\"Adds a select option to a select attribute on an object or a list.\\n\\nWhen `target` is `objects`, the required scopes are `object_configuration:read-write`. When `target` is `lists`, the required scopes are `list_configuration:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/{target}/{identifier}/attributes/{attribute}/options\",\"href\":\"/rest-api/endpoint-reference/attributes/create-a-select-option\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a select option\",\"description\":\"Updates a select option on an attribute on either an object or a list.\\n\\nWhen `target` is `objects`, the required scopes are `object_configuration:read-write`. When `target` is `lists`, the required scopes are `list_configuration:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api patch /v2/{target}/{identifier}/attributes/{attribute}/options/{option}\",\"href\":\"/rest-api/endpoint-reference/attributes/update-a-select-option\",\"autogeneratedByOpenApi\":true},{\"title\":\"List statuses\",\"description\":\"Lists all statuses for a particular status attribute on either an object or a list.\\n\\nWhen `target` is `objects`, the required scopes are `object_configuration:read`. When `target` is `lists`, the required scopes are `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/{target}/{identifier}/attributes/{attribute}/statuses\",\"href\":\"/rest-api/endpoint-reference/attributes/list-statuses\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a status\",\"description\":\"Add a new status to a status attribute on either an object or a list.\\n\\nWhen `target` is `objects`, the required scopes are `object_configuration:read-write`. When `target` is `lists`, the required scopes are `list_configuration:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/{target}/{identifier}/attributes/{attribute}/statuses\",\"href\":\"/rest-api/endpoint-reference/attributes/create-a-status\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a status\",\"description\":\"Update a status on an status attribute on either an object or a list.\\n\\nWhen `target` is `objects`, the required scopes are `object_configuration:read-write`. When `target` is `lists`, the required scopes are `list_configuration:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api patch /v2/{target}/{identifier}/attributes/{attribute}/statuses/{status}\",\"href\":\"/rest-api/endpoint-reference/attributes/update-a-status\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Records\",\"pages\":[{\"title\":\"List records\",\"description\":\"Lists people, company or other records, with the option to filter and sort results.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/objects/{object}/records/query\",\"href\":\"/rest-api/endpoint-reference/records/list-records\",\"autogeneratedByOpenApi\":true},{\"title\":\"Upsert a record\",\"description\":\"Use this endpoint to create or update people, companies and other records. A matching attribute is used to search for existing records. If a record is found with the same value for the matching attribute, that record will be updated. If no record with the same value for the matching attribute is found, a new record will be created instead. If you would like to avoid matching, please use the [Create record endpoint](/rest-api/endpoint-reference/records/create-a-record).\\n\\nIf the matching attribute is a multiselect attribute, new values will be added and existing values will not be deleted. For any other multiselect attribute, all values will be either created or deleted as necessary to match the list of supplied values.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api put /v2/objects/{object}/records\",\"href\":\"/rest-api/endpoint-reference/records/upsert-a-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a record\",\"description\":\"Creates a new person, company or other record. This endpoint will throw on conflicts of unique attributes. If you would prefer to update records on conflicts, please use the [Upsert record endpoint](/rest-api/endpoint-reference/records/upsert-a-record) instead.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/objects/{object}/records\",\"href\":\"/rest-api/endpoint-reference/records/create-a-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a record\",\"description\":\"Gets a single person, company or other record by its `record_id`.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/objects/{object}/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/records/get-a-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a record (overwrite multiselect values)\",\"description\":\"Use this endpoint to update people, companies, and other records by `record_id`. If the update payload includes multiselect attributes, the values supplied will overwrite/remove the list of values that already exist (if any). Use the `PATCH` endpoint to append multiselect values without removing those that already exist.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api put /v2/objects/{object}/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/records/update-a-record-overwrite-multiselect-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a record\",\"description\":\"Deletes a single record (e.g. a company or person) by ID.\\n\\nRequired scopes: `object_configuration:read`, `record_permission:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api delete /v2/objects/{object}/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/records/delete-a-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a record (append multiselect values)\",\"description\":\"Use this endpoint to update people, companies, and other records by `record_id`. If the update payload includes multiselect attributes, the values supplied will be created and prepended to the list of values that already exist (if any). Use the `PUT` endpoint to overwrite or remove multiselect attribute values.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api patch /v2/objects/{object}/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/records/update-a-record-append-multiselect-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"List record attribute values\",\"description\":\"Gets all values for a given attribute on a record. Historic values can be queried using the `show_historic` query param. Historic values cannot be queried on COMINT (Communication Intelligence) or enriched attributes and the endpoint will return a 400 error if this is attempted. Historic values are sorted from oldest to newest (by `active_from`). Some attributes are subject to billing status and will return an empty array of values if theworkspace being queried does not have the required billing flag enabled.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/objects/{object}/records/{record_id}/attributes/{attribute}/values\",\"href\":\"/rest-api/endpoint-reference/records/list-record-attribute-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"List record entries\",\"description\":\"List all entries, across all lists, for which this record is the parent.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`, `list_entry:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/objects/{object}/records/{record_id}/entries\",\"href\":\"/rest-api/endpoint-reference/records/list-record-entries\",\"autogeneratedByOpenApi\":true},{\"title\":\"Search records\",\"description\":\"The search records endpoint provides a convenient way to fuzzy search for records across one or more objects.\\nThe matching strategy employed in this endpoint follows the in-product strategy and will match names, domains, emails, phone numbers and social handles on people and companies, and labels on all other objects.\\nPlease note, results returned from this endpoint are eventually consistent. For results which are guaranteed to be up to date, please use the record query endpoint instead.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api post /v2/objects/records/search\",\"href\":\"/rest-api/endpoint-reference/records/search-records\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"SQL\",\"pages\":[{\"title\":\"Query SQL\",\"description\":\"Query records and lists with SQL.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api post /v2/sql\",\"href\":\"/rest-api/endpoint-reference/sql/query-sql\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Lists\",\"pages\":[{\"title\":\"List all lists\",\"description\":\"List all lists that your access token has access to. lists are returned in the order that they are sorted in the sidebar.\\n\\nRequired scopes: `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/lists\",\"href\":\"/rest-api/endpoint-reference/lists/list-all-lists\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a list\",\"description\":\"Creates a new list.\\n\\nOnce you have your list, add attributes to it using the [Create attribute](/rest-api/endpoint-reference/attributes/create-an-attribute) API, and add records to it using the [Add records to list](/rest-api/endpoint-reference/entries/create-an-entry-add-record-to-list) API. \\n\\nNew lists must specify which records can be added with the `parent_object` parameter which accepts either an object slug or an object ID. Permissions for the list are controlled with the `workspace_access` and `workspace_member_access` parameters.\\n\\nPlease note that new lists must have either `workspace_access` set to `\\\"full-access\\\"` or one or more element of `workspace_member_access` with a `\\\"full-access\\\"` level. It is also possible to receive a `403` billing error if your workspace is not on a plan that supports either advanced workspace or workspace member-level access for lists.\\n\\nRequired scopes: `list_configuration:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/lists\",\"href\":\"/rest-api/endpoint-reference/lists/create-a-list\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a list\",\"description\":\"Gets a single list in your workspace that your access token has access to.\\n\\nRequired scopes: `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/lists/{list}\",\"href\":\"/rest-api/endpoint-reference/lists/get-a-list\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a list\",\"description\":\"Updates an existing list. Permissions for the list are controlled with the `workspace_access` and `workspace_member_access` parameters. Please note that lists must have either `workspace_access` set to `\\\"full-access\\\"` or one or more element of `workspace_member_access` with a `\\\"full-access\\\"` level. It is also possible to receive a `403` billing error if your workspace is not on a plan that supports either advanced workspace or workspace member level access for lists. Changing the parent object of a list is not possible through the API as it can have unintended side-effects that should be considered carefully. If you wish to carry out a parent object change you should do so through the UI.\\n\\nRequired scopes: `list_configuration:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api patch /v2/lists/{list}\",\"href\":\"/rest-api/endpoint-reference/lists/update-a-list\",\"autogeneratedByOpenApi\":true},{\"title\":\"List views for list\",\"description\":\"Lists saved views for a list. Results are ordered by view ID (`id.view_id` ascending).\\n\\nRequired scopes: `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/lists/{list}/views\",\"href\":\"/rest-api/endpoint-reference/lists/list-views-for-list\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Entries\",\"pages\":[{\"title\":\"List entries\",\"description\":\"Lists entries in a given list, with the option to filter and sort results.\\n\\nRequired scopes: `list_entry:read`, `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/lists/{list}/entries/query\",\"href\":\"/rest-api/endpoint-reference/entries/list-entries\",\"autogeneratedByOpenApi\":true},{\"title\":\"Upsert a list entry by parent\",\"description\":\"Use this endpoint to create or update a list entry for a given parent record. If an entry with the specified parent record is found, that entry will be updated. If no such entry is found, a new entry will be created instead. If there are multiple entries with the same parent record, this endpoint with return the \\\"MULTIPLE_MATCH_RESULTS\\\" error. When writing to multi-select attributes, all values will be either created or deleted as necessary to match the list of values supplied in the request body.\\n\\nRequired scopes: `list_entry:read-write`, `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api put /v2/lists/{list}/entries\",\"href\":\"/rest-api/endpoint-reference/entries/upsert-a-list-entry-by-parent\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create an entry (add record to list)\",\"description\":\"Adds a record to a list as a new list entry. This endpoint will throw on conflicts of unique attributes. Multiple list entries are allowed for the same parent record\\n\\nRequired scopes: `list_entry:read-write`, `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/lists/{list}/entries\",\"href\":\"/rest-api/endpoint-reference/entries/create-an-entry-add-record-to-list\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a list entry\",\"description\":\"Gets a single list entry by its `entry_id`.\\n\\nRequired scopes: `list_entry:read`, `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/lists/{list}/entries/{entry_id}\",\"href\":\"/rest-api/endpoint-reference/entries/get-a-list-entry\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a list entry (overwrite multiselect values)\",\"description\":\"Use this endpoint to update list entries by `entry_id`. If the update payload includes multiselect attributes, the values supplied will overwrite/remove the list of values that already exist (if any). Use the `PATCH` endpoint to add multiselect attribute values without removing those value that already exist.\\n\\nRequired scopes: `list_entry:read-write`, `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api put /v2/lists/{list}/entries/{entry_id}\",\"href\":\"/rest-api/endpoint-reference/entries/update-a-list-entry-overwrite-multiselect-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a list entry\",\"description\":\"Deletes a single list entry by its `entry_id`.\\n\\nRequired scopes: `list_entry:read-write`, `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api delete /v2/lists/{list}/entries/{entry_id}\",\"href\":\"/rest-api/endpoint-reference/entries/delete-a-list-entry\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a list entry (append multiselect values)\",\"description\":\"Use this endpoint to update list entries by `entry_id`. If the update payload includes multiselect attributes, the values supplied will be created and prepended to the list of values that already exist (if any). Use the `PUT` endpoint to overwrite or remove multiselect attribute values.\\n\\nRequired scopes: `list_entry:read-write`, `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api patch /v2/lists/{list}/entries/{entry_id}\",\"href\":\"/rest-api/endpoint-reference/entries/update-a-list-entry-append-multiselect-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"List attribute values for a list entry\",\"description\":\"Gets all values for a given attribute on a list entry. This endpoint has the ability to return all historic values using the `show_historic` query param. Historic values are sorted from oldest to newest (by `active_from`).\\n\\nRequired scopes: `list_entry:read`, `list_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/lists/{list}/entries/{entry_id}/attributes/{attribute}/values\",\"href\":\"/rest-api/endpoint-reference/entries/list-attribute-values-for-a-list-entry\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Workspace members\",\"pages\":[{\"title\":\"List workspace members\",\"description\":\"Lists all workspace members in the workspace.\\n\\nRequired scopes: `user_management:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/workspace_members\",\"href\":\"/rest-api/endpoint-reference/workspace-members/list-workspace-members\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a workspace member\",\"description\":\"Gets a single workspace member by ID.\\n\\nRequired scopes: `user_management:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/workspace_members/{workspace_member_id}\",\"href\":\"/rest-api/endpoint-reference/workspace-members/get-a-workspace-member\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Notes\",\"pages\":[{\"title\":\"List notes\",\"description\":\"List notes for all records or for a specific record.\\n\\nRequired scopes: `note:read`, `object_configuration:read`, `record_permission:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/notes\",\"href\":\"/rest-api/endpoint-reference/notes/list-notes\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a note\",\"description\":\"Creates a new note for a given record.\\n\\nRequired scopes: `note:read-write`, `object_configuration:read`, `record_permission:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/notes\",\"href\":\"/rest-api/endpoint-reference/notes/create-a-note\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a note\",\"description\":\"Get a single note by ID.\\n\\nRequired scopes: `note:read`, `object_configuration:read`, `record_permission:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/notes/{note_id}\",\"href\":\"/rest-api/endpoint-reference/notes/get-a-note\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a note\",\"description\":\"Delete a single note by ID.\\n\\nRequired scopes: `note:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api delete /v2/notes/{note_id}\",\"href\":\"/rest-api/endpoint-reference/notes/delete-a-note\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Tasks\",\"pages\":[{\"title\":\"List tasks\",\"description\":\"List all tasks. Results are sorted by creation date, from oldest to newest.\\n\\nRequired scopes: `task:read`, `object_configuration:read`, `record_permission:read`, `user_management:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/tasks\",\"href\":\"/rest-api/endpoint-reference/tasks/list-tasks\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a task\",\"description\":\"Creates a new task.\\n\\nAt present, tasks can only be created from plaintext without record reference formatting.\\n\\nRequired scopes: `task:read-write`, `object_configuration:read`, `record_permission:read`, `user_management:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/tasks\",\"href\":\"/rest-api/endpoint-reference/tasks/create-a-task\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a task\",\"description\":\"Get a single task by ID.\\n\\nRequired scopes: `task:read`, `object_configuration:read`, `record_permission:read`, `user_management:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/tasks/{task_id}\",\"href\":\"/rest-api/endpoint-reference/tasks/get-a-task\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a task\",\"description\":\"Delete a task by ID.\\n\\nRequired scopes: `task:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api delete /v2/tasks/{task_id}\",\"href\":\"/rest-api/endpoint-reference/tasks/delete-a-task\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a task\",\"description\":\"Updates an existing task by `task_id`. At present, only the `deadline_at`, `is_completed`, `linked_records`, and `assignees` fields can be updated.\\n\\nRequired scopes: `task:read-write`, `object_configuration:read`, `record_permission:read`, `user_management:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api patch /v2/tasks/{task_id}\",\"href\":\"/rest-api/endpoint-reference/tasks/update-a-task\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Threads\",\"pages\":[{\"title\":\"List threads\",\"description\":\"List threads of comments on a record or list entry.\\n\\nTo view threads on records, you will need the `object_configuration:read` and `record_permission:read` scopes.\\n\\nTo view threads on list entries, you will need the `list_configuration:read` and `list_entry:read` scopes.\\n\\nRequired scopes: `comment:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/threads\",\"href\":\"/rest-api/endpoint-reference/threads/list-threads\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a thread\",\"description\":\"Get all comments in a thread.\\n\\nTo view threads on records, you will need the `object_configuration:read` and `record_permission:read` scopes.\\n\\nTo view threads on list entries, you will need the `list_configuration:read` and `list_entry:read` scopes.\\n\\nRequired scopes: `comment:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/threads/{thread_id}\",\"href\":\"/rest-api/endpoint-reference/threads/get-a-thread\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Comments\",\"pages\":[{\"title\":\"Create a comment\",\"description\":\"Creates a new comment related to an existing thread, record or entry.\\n\\nTo create comments on records, you will need the `object_configuration:read` and `record_permission:read` scopes.\\n\\nTo create comments on list entries, you will need the `list_configuration:read` and `list_entry:read` scopes.\\n\\nRequired scopes: `comment:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/comments\",\"href\":\"/rest-api/endpoint-reference/comments/create-a-comment\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a comment\",\"description\":\"Get a single comment by ID.\\n\\nTo view comments on records, you will need the `object_configuration:read` and `record_permission:read` scopes.\\n\\nTo view comments on list entries, you will need the `list_configuration:read` and `list_entry:read` scopes.\\n\\nRequired scopes: `comment:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/comments/{comment_id}\",\"href\":\"/rest-api/endpoint-reference/comments/get-a-comment\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a comment\",\"description\":\"Deletes a comment by ID. If deleting a comment at the head of a thread, all messages in the thread are also deleted.\\n\\nRequired scopes: `comment:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api delete /v2/comments/{comment_id}\",\"href\":\"/rest-api/endpoint-reference/comments/delete-a-comment\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Meetings\",\"pages\":[{\"title\":\"List meetings\",\"description\":\"Lists all meetings in the workspace using a deterministic sort order.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `meeting:read`, `record_permission:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api get /v2/meetings\",\"href\":\"/rest-api/endpoint-reference/meetings/list-meetings\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a meeting\",\"description\":\"Get a single meeting by ID.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `meeting:read`, `record_permission:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api get /v2/meetings/{meeting_id}\",\"href\":\"/rest-api/endpoint-reference/meetings/get-a-meeting\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Call recordings\",\"pages\":[{\"title\":\"List call recordings\",\"description\":\"List all call recordings for a meeting.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `meeting:read`, `call_recording:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api get /v2/meetings/{meeting_id}/call_recordings\",\"href\":\"/rest-api/endpoint-reference/call-recordings/list-call-recordings\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get call recording\",\"description\":\"Get a single call recording by ID.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `meeting:read`, `call_recording:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api get /v2/meetings/{meeting_id}/call_recordings/{call_recording_id}\",\"href\":\"/rest-api/endpoint-reference/call-recordings/get-call-recording\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Transcripts\",\"pages\":[{\"title\":\"Get call transcript\",\"description\":\"Get the transcript for a call recording.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `meeting:read`, `call_recording:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api get /v2/meetings/{meeting_id}/call_recordings/{call_recording_id}/transcript\",\"href\":\"/rest-api/endpoint-reference/transcripts/get-call-transcript\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Files\",\"pages\":[{\"title\":\"List files\",\"description\":\"Lists internal files, externally connected files and folders for a specific record. Use the `object` and `record_id` query parameters to specify the record. Optional query parameters may be provided to filter results by storage provider or parent folder.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `object_configuration:read`, `record_permission:read`, `file:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api get /v2/files\",\"href\":\"/rest-api/endpoint-reference/files/list-files\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a folder\",\"description\":\"Creates a native folder entry or a connected file/folder entry on an object record.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `file:read-write`, `object_configuration:read`, `record_permission:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api post /v2/files\",\"href\":\"/rest-api/endpoint-reference/files/create-a-folder\",\"autogeneratedByOpenApi\":true},{\"title\":\"Upload a file\",\"description\":\"Uploads a file to native Attio storage for a record. Send multipart/form-data with a single binary field named `file` together with the body fields `object`, `record_id`, and optional `parent_folder_id`. Maximum file size is 50 MB.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `file:read-write`, `object_configuration:read`, `record_permission:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api post /v2/files/upload\",\"href\":\"/rest-api/endpoint-reference/files/upload-a-file\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a file\",\"description\":\"Get a single file entry by ID.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `file:read`, `object_configuration:read`, `record_permission:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api get /v2/files/{file_id}\",\"href\":\"/rest-api/endpoint-reference/files/get-a-file\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a file\",\"description\":\"Delete a single file by ID. Deleting a folder will delete all of its descendants.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `file:read-write`, `object_configuration:read`, `record_permission:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api delete /v2/files/{file_id}\",\"href\":\"/rest-api/endpoint-reference/files/delete-a-file\",\"autogeneratedByOpenApi\":true},{\"title\":\"Download a file\",\"description\":\"Downloads a file by redirecting to a signed URL.\\n\\nThis endpoint is in beta. We will aim to avoid breaking changes, but small updates may be made as we roll out to more users.\\n\\nRequired scopes: `object_configuration:read`, `record_permission:read`, `file:read`.\",\"deprecated\":null,\"version\":null,\"tag\":\"BETA\",\"openapi\":\"https://api.attio.com/openapi/api get /v2/files/{file_id}/download\",\"href\":\"/rest-api/endpoint-reference/files/download-a-file\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Webhooks\",\"pages\":[{\"title\":\"List webhooks\",\"description\":\"Get all of the webhooks in your workspace.\\n\\nRequired scopes: `webhook:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/webhooks\",\"href\":\"/rest-api/endpoint-reference/webhooks/list-webhooks\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a webhook\",\"description\":\"Create a webhook and associated subscriptions.\\n\\nRequired scopes: `webhook:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api post /v2/webhooks\",\"href\":\"/rest-api/endpoint-reference/webhooks/create-a-webhook\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a webhook\",\"description\":\"Get a single webhook.\\n\\nRequired scopes: `webhook:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/webhooks/{webhook_id}\",\"href\":\"/rest-api/endpoint-reference/webhooks/get-a-webhook\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a webhook\",\"description\":\"Delete a webhook by ID.\\n\\nRequired scopes: `webhook:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api delete /v2/webhooks/{webhook_id}\",\"href\":\"/rest-api/endpoint-reference/webhooks/delete-a-webhook\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a webhook\",\"description\":\"Update a webhook and associated subscriptions.\\n\\nRequired scopes: `webhook:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api patch /v2/webhooks/{webhook_id}\",\"href\":\"/rest-api/endpoint-reference/webhooks/update-a-webhook\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Meta\",\"pages\":[{\"title\":\"Identify\",\"description\":\"Identify the current access token, the workspace it is linked to, and any permissions it has.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/api get /v2/self\",\"href\":\"/rest-api/endpoint-reference/meta/identify\",\"autogeneratedByOpenApi\":true}]}]},{\"group\":\"Standard objects\",\"pages\":[{\"group\":\"People\",\"pages\":[{\"title\":\"List person records \",\"description\":\"Lists person records, with the option to filter and sort results.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/people/records/query\",\"href\":\"/rest-api/endpoint-reference/people/list-person-records\",\"autogeneratedByOpenApi\":true},{\"title\":\"Upsert a person record\",\"description\":\"Use this endpoint to create or update person records, using a unique attribute to search for existing People (for example the `email_addresses` attribute). If a person is found with the same value for the matching attribute, that person will be updated. If no person with the same value for the matching attribute is found, a new person will be created instead. If you would like to avoid matching, please use the Create person endpoint.\\n\\n\\nIf the matching attribute is a multiselect attribute, new values will be added and existing values will not be deleted. For any other multiselect attribute, all values will be either created or deleted as necessary to match the list of supplied values.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects put /v2/objects/people/records\",\"href\":\"/rest-api/endpoint-reference/people/upsert-a-person-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a person Record\",\"description\":\"Creates a new person Record. This endpoint will throw on conflicts of unique attributes, like `email_addresses`. If you would prefer to update person records on conflicts, please use the Assert person record endpoint instead. Please note, the `avatar_url` attribute cannot currently be set via the API.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/people/records\",\"href\":\"/rest-api/endpoint-reference/people/create-a-person-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a person Record\",\"description\":\"Gets a single person record by its `record_id`.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/people/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/people/get-a-person-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a person Record\",\"description\":\"Deletes a single person record by ID.\\n\\nRequired scopes: `object_configuration:read`, `record_permission:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects delete /v2/objects/people/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/people/delete-a-person-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a person Record\",\"description\":\"Use this endpoint to update person records by `record_id`. If the update payload includes multiselect attributes, the values supplied will be created and prepended to the list of values that already exist (if any). Use the [Upsert person endpoint](/reference/put_v2-objects-people-records) to overwrite or remove multiselect attribute values. Please note, the `avatar_url` attribute cannot currently be updated via the API.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects patch /v2/objects/people/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/people/update-a-person-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"List person record attribute values\",\"description\":\"Gets all values for a given attribute on a person record. Historic values can be queried using the `show_historic` query param. Historic values cannot be queried on COMINT (Communication Intelligence) or enriched attributes and the endpoint will return a 400 error if this is attempted. Historic values are sorted from oldest to newest (by `active_from`). Some attributes are subject to billing status and will return an empty array of values if theworkspace being queried does not have the required billing flag enabled.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/people/records/{record_id}/attributes/{attribute}/values\",\"href\":\"/rest-api/endpoint-reference/people/list-person-record-attribute-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"List person record entries\",\"description\":\"List all entries, across all lists, for which this person record is the parent.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`, `list_entry:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/people/records/{record_id}/entries\",\"href\":\"/rest-api/endpoint-reference/people/list-person-record-entries\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Companies\",\"pages\":[{\"title\":\"List company records\",\"description\":\"Lists company records, with the option to filter and sort results.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/companies/records/query\",\"href\":\"/rest-api/endpoint-reference/companies/list-company-records\",\"autogeneratedByOpenApi\":true},{\"title\":\"Upsert a company record\",\"description\":\"Use this endpoint to create or update company records, using a unique attribute to search for existing companies (for example, the `domains` attribute). If a company is found with the same value for the matching attribute, that company will be updated. If no company with the same value for the matching attribute is found, a new company will be created instead. If you would like to avoid matching, please use the Create company endpoint.\\n\\n\\nIf the matching attribute is a multiselect attribute, new values will be added and existing values will not be deleted. For any other multiselect attribute, all values will be either created or deleted as necessary to match the list of supplied values.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects put /v2/objects/companies/records\",\"href\":\"/rest-api/endpoint-reference/companies/upsert-a-company-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a company record\",\"description\":\"Creates a new company record. This endpoint will throw on conflicts of unique attributes, like `domains`. If you would prefer to update company records on conflicts, please use the Assert company record endpoint instead. Please note, the `logo_url` attribute cannot currently be set via the API.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/companies/records\",\"href\":\"/rest-api/endpoint-reference/companies/create-a-company-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a company record\",\"description\":\"Gets a single company record by its `record_id`.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/companies/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/companies/get-a-company-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a company record\",\"description\":\"Deletes a single company record by ID.\\n\\nRequired scopes: `object_configuration:read`, `record_permission:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects delete /v2/objects/companies/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/companies/delete-a-company-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a company record\",\"description\":\"Use this endpoint to update company records by `record_id`. If the update payload includes multiselect attributes, the values supplied will be created and prepended to the list of values that already exist (if any). Use the [Upsert company endpoint](/rest-api/endpoint-reference/standard-objects/companies/upsert-a-company-record) to overwrite or remove multiselect attribute values. Please note, the `logo_url` attribute cannot currently be updated via the API.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects patch /v2/objects/companies/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/companies/update-a-company-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"List company record attribute values\",\"description\":\"Gets all values for a given attribute on a company record. Historic values can be queried using the `show_historic` query param. Historic values cannot be queried on COMINT (Communication Intelligence) or enriched attributes and the endpoint will return a 400 error if this is attempted. Historic values are sorted from oldest to newest (by `active_from`). Some attributes are subject to billing status and will return an empty array of values if theworkspace being queried does not have the required billing flag enabled.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/companies/records/{record_id}/attributes/{attribute}/values\",\"href\":\"/rest-api/endpoint-reference/companies/list-company-record-attribute-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"List company record entries\",\"description\":\"List all entries, across all lists, for which this company record is the parent.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`, `list_entry:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/companies/records/{record_id}/entries\",\"href\":\"/rest-api/endpoint-reference/companies/list-company-record-entries\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Users\",\"pages\":[{\"title\":\"List user records\",\"description\":\"Lists user records, with the option to filter and sort results.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/users/records/query\",\"href\":\"/rest-api/endpoint-reference/users/list-user-records\",\"autogeneratedByOpenApi\":true},{\"title\":\"Upsert a user record\",\"description\":\"Use this endpoint to create or update user records, using a unique attribute to search for existing users (for example the `primary_email_address` attribute). If a user is found with the same value for the matching attribute, that user will be updated, otherwise a new user will be created instead. If the matching attribute is a multiselect attribute, new values will be added and existing values will not be deleted. For any other multiselect attribute, all values will be either created or deleted as necessary to match the list of supplied values.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects put /v2/objects/users/records\",\"href\":\"/rest-api/endpoint-reference/users/upsert-a-user-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a user record\",\"description\":\"Creates a new user record. This endpoint will throw on conflicts of unique attributes, like `primary_email_address`. If you would prefer to update user records on conflicts, please use the Assert user record endpoint instead. Please note, the `avatar_url` attribute cannot currently be set via the API.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/users/records\",\"href\":\"/rest-api/endpoint-reference/users/create-a-user-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a user record\",\"description\":\"Gets a single user record by its `record_id`.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/users/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/users/get-a-user-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a user record\",\"description\":\"Deletes a single user record by ID.\\n\\nRequired scopes: `object_configuration:read`, `record_permission:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects delete /v2/objects/users/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/users/delete-a-user-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a user Record\",\"description\":\"Use this endpoint to update user records by `record_id`. If the update payload includes multiselect attributes, the values supplied will be created and prepended to the list of values that already exist (if any). Use the [Upsert user endpoint](/reference/put_v2-objects-users-records) to overwrite or remove multiselect attribute values. Please note, the `avatar_url` attribute cannot currently be updated via the API.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects patch /v2/objects/users/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/users/update-a-user-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"List user record attribute values\",\"description\":\"Gets all values for a given attribute on a user record. Historic values can be queried using the `show_historic` query param. Historic values are sorted from oldest to newest (by `active_from`).\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/users/records/{record_id}/attributes/{attribute}/values\",\"href\":\"/rest-api/endpoint-reference/users/list-user-record-attribute-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"List user record entries\",\"description\":\"List all entries, across all lists, for which this user record is the parent.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`, `list_entry:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/users/records/{record_id}/entries\",\"href\":\"/rest-api/endpoint-reference/users/list-user-record-entries\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Deals\",\"pages\":[{\"title\":\"Upsert a deal record\",\"description\":\"Use this endpoint to create or update deal records, using a unique attribute to search for existing deals. By default, deals do not have a unique attribute, so you should add your own attribute with a unique constraint to use this API. If a deal is found with the same value for the matching attribute, that deal will be updated, otherwise a new deal will be created instead. If the matching attribute is a multiselect attribute, new values will be added and existing values will not be deleted. For any other multiselect attribute, all values will be either created or deleted as necessary to match the list of supplied values.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects put /v2/objects/deals/records\",\"href\":\"/rest-api/endpoint-reference/deals/upsert-a-deal-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a deal record\",\"description\":\"Creates a new deal record. This endpoint will throw on conflicts of unique attributes, if defined. If you would prefer to update deal records on conflicts, please use the Assert deal record endpoint instead.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/deals/records\",\"href\":\"/rest-api/endpoint-reference/deals/create-a-deal-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a deal record\",\"description\":\"Gets a single deal record by its `record_id`.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/deals/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/deals/get-a-deal-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a deal record\",\"description\":\"Deletes a single deal record by ID.\\n\\nRequired scopes: `object_configuration:read`, `record_permission:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects delete /v2/objects/deals/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/deals/delete-a-deal-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a deal record\",\"description\":\"Use this endpoint to update deal records by `record_id`. If the update payload includes multiselect attributes, the values supplied will be created and prepended to the list of values that already exist (if any). Use the [Upsert deal endpoint](/rest-api/endpoint-reference/standard-objects/deals/upsert-a-deal-record) to overwrite or remove multiselect attribute values.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects patch /v2/objects/deals/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/deals/update-a-deal-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"List deal record attribute values\",\"description\":\"Gets all values for a given attribute on a deal record. Historic values can be queried using the `show_historic` query param. Historic values are sorted from oldest to newest (by `active_from`).\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/deals/records/{record_id}/attributes/{attribute}/values\",\"href\":\"/rest-api/endpoint-reference/deals/list-deal-record-attribute-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"List deal record entries\",\"description\":\"List all entries, across all lists, for which this deal record is the parent.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`, `list_entry:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/deals/records/{record_id}/entries\",\"href\":\"/rest-api/endpoint-reference/deals/list-deal-record-entries\",\"autogeneratedByOpenApi\":true},{\"title\":\"List deal records\",\"description\":\"Lists deal records, with the option to filter and sort results.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/deals/records/query\",\"href\":\"/rest-api/endpoint-reference/deals/list-deal-records\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Workspaces\",\"pages\":[{\"title\":\"Upsert a workspace record\",\"description\":\"Use this endpoint to create or update workspace records, using a unique attribute to search for existing workspaces (for example the `workspace_id` attribute). If a workspace is found with the same value for the matching attribute, that workspace will be updated, otherwise a new workspace will be created instead. If the matching attribute is a multiselect attribute, new values will be added and existing values will not be deleted. For any other multiselect attribute, all values will be either created or deleted as necessary to match the list of supplied values.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects put /v2/objects/workspaces/records\",\"href\":\"/rest-api/endpoint-reference/workspaces/upsert-a-workspace-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Create a workspace record\",\"description\":\"Creates a new workspace record. This endpoint will throw on conflicts of unique attributes, like `workspace_id`. If you would prefer to update workspace records on conflicts, please use the Assert workspace record endpoint instead.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/workspaces/records\",\"href\":\"/rest-api/endpoint-reference/workspaces/create-a-workspace-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Get a workspace record\",\"description\":\"Gets a single workspace record by its `record_id`.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/workspaces/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/workspaces/get-a-workspace-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Delete a workspace record\",\"description\":\"Deletes a single workspace record by ID.\\n\\nRequired scopes: `object_configuration:read`, `record_permission:read-write`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects delete /v2/objects/workspaces/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/workspaces/delete-a-workspace-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"Update a workspace Record\",\"description\":\"Use this endpoint to update workspace records by `record_id`. If the update payload includes multiselect attributes, the values supplied will be created and prepended to the list of values that already exist (if any). Use the [Upsert workspace endpoint](/rest-api/endpoint-reference/standard-objects/workspaces/upsert-a-workspace-record) to overwrite or remove multiselect attribute values.\\n\\nRequired scopes: `record_permission:read-write`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects patch /v2/objects/workspaces/records/{record_id}\",\"href\":\"/rest-api/endpoint-reference/workspaces/update-a-workspace-record\",\"autogeneratedByOpenApi\":true},{\"title\":\"List workspace record attribute values\",\"description\":\"Gets all values for a given attribute on a workspace record. Historic values can be queried using the `show_historic` query param. Historic values are sorted from oldest to newest (by `active_from`).\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/workspaces/records/{record_id}/attributes/{attribute}/values\",\"href\":\"/rest-api/endpoint-reference/workspaces/list-workspace-record-attribute-values\",\"autogeneratedByOpenApi\":true},{\"title\":\"List workspace record entries\",\"description\":\"List all entries, across all lists, for which this workspace record is the parent.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`, `list_entry:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects get /v2/objects/workspaces/records/{record_id}/entries\",\"href\":\"/rest-api/endpoint-reference/workspaces/list-workspace-record-entries\",\"autogeneratedByOpenApi\":true},{\"title\":\"List workspace records\",\"description\":\"Lists workspace records, with the option to filter and sort results.\\n\\nRequired scopes: `record_permission:read`, `object_configuration:read`.\",\"deprecated\":null,\"version\":null,\"openapi\":\"https://api.attio.com/openapi/standard-objects post /v2/objects/workspaces/records/query\",\"href\":\"/rest-api/endpoint-reference/workspaces/list-workspace-records\",\"autogeneratedByOpenApi\":true}]}]},{\"group\":\"SCIM 2.0\",\"pages\":[{\"title\":\"List SCIM schemas\",\"api\":\"GET https://api.attio.com/scim/v2/Schemas\",\"description\":\"Returns the SCIM 2.0 resource schemas supported by Attio (User and Group), allowing SCIM clients to discover supported attributes.\\n\\nRequired scopes: `user_management:read`.\",\"href\":\"/rest-api/scim/list-schemas\"},{\"group\":\"Users\",\"pages\":[{\"title\":\"Create a SCIM user\",\"api\":\"POST https://api.attio.com/scim/v2/Users\",\"description\":\"Creates a SCIM user in the workspace. For verified domains the user is added as an active member immediately. For unverified domains an invite is sent and the invite ID is returned as the SCIM user ID.\\n\\nRequired scopes: `user_management:read-write`.\",\"href\":\"/rest-api/scim/create-user\"},{\"title\":\"Get a SCIM user\",\"api\":\"GET https://api.attio.com/scim/v2/Users/{user_id}\",\"description\":\"Gets a SCIM user by ID. Returns both active members and pending invites.\\n\\nRequired scopes: `user_management:read`.\",\"href\":\"/rest-api/scim/get-user-by-id\"},{\"title\":\"List SCIM users\",\"api\":\"GET https://api.attio.com/scim/v2/Users\",\"description\":\"Lists all SCIM users in the workspace, including active members and pending invites, with optional filtering and pagination.\\n\\nRequired scopes: `user_management:read`.\",\"href\":\"/rest-api/scim/list-users\"},{\"title\":\"Update a SCIM user\",\"api\":\"PUT https://api.attio.com/scim/v2/Users/{user_id}\",\"description\":\"Fully replaces a SCIM user's attributes. Returns 200 with the updated user. Returns 204 when setting `active` to `false` on a pending invite.\\n\\nRequired scopes: `user_management:read-write`.\",\"href\":\"/rest-api/scim/update-user\"},{\"title\":\"Patch a SCIM user\",\"api\":\"PATCH https://api.attio.com/scim/v2/Users/{user_id}\",\"description\":\"Applies partial updates to a SCIM user using SCIM PatchOp operations. Returns 200 with the updated user. Returns 204 when setting `active` to `false` on a pending invite.\\n\\nRequired scopes: `user_management:read-write`.\",\"href\":\"/rest-api/scim/patch-user\"},{\"title\":\"Delete a SCIM user\",\"api\":\"DELETE https://api.attio.com/scim/v2/Users/{user_id}\",\"description\":\"Deletes a SCIM user from the workspace, suspending active members and cancelling pending invites. Returns 204 No Content on success.\\n\\nRequired scopes: `user_management:read-write`.\",\"href\":\"/rest-api/scim/delete-user\"}]},{\"group\":\"Groups\",\"pages\":[{\"title\":\"Create a SCIM group\",\"api\":\"POST https://api.attio.com/scim/v2/Groups\",\"description\":\"Creates a SCIM group (team) in the workspace.\\n\\nRequired scopes: `user_management:read-write`.\",\"href\":\"/rest-api/scim/create-group\"},{\"title\":\"Get a SCIM group\",\"api\":\"GET https://api.attio.com/scim/v2/Groups/{workspace_team_id}\",\"description\":\"Gets a SCIM group by ID.\\n\\nRequired scopes: `user_management:read`.\",\"href\":\"/rest-api/scim/get-group-by-id\"},{\"title\":\"List SCIM groups\",\"api\":\"GET https://api.attio.com/scim/v2/Groups\",\"description\":\"Lists all SCIM groups in the workspace, with optional filtering and pagination.\\n\\nRequired scopes: `user_management:read`.\",\"href\":\"/rest-api/scim/list-groups\"},{\"title\":\"Update a SCIM group\",\"api\":\"PUT https://api.attio.com/scim/v2/Groups/{workspace_team_id}\",\"description\":\"Fully replaces a SCIM group's display name and member list.\\n\\nRequired scopes: `user_management:read-write`.\",\"href\":\"/rest-api/scim/update-group\"},{\"title\":\"Patch a SCIM group\",\"api\":\"PATCH https://api.attio.com/scim/v2/Groups/{workspace_team_id}\",\"description\":\"Applies partial updates to a SCIM group using SCIM PatchOp operations. Supports updating the display name and adding, removing, or replacing members.\\n\\nRequired scopes: `user_management:read-write`.\",\"href\":\"/rest-api/scim/patch-group\"},{\"title\":\"Delete a SCIM group\",\"api\":\"DELETE https://api.attio.com/scim/v2/Groups/{workspace_team_id}\",\"description\":\"Deletes a SCIM group from the workspace. Returns 204 No Content on success.\\n\\nRequired scopes: `user_management:read-write`.\",\"href\":\"/rest-api/scim/delete-group\"}]}]},{\"group\":\"OAuth 2.0\",\"pages\":[{\"title\":\"Authorize\",\"api\":\"GET https://app.attio.com/authorize\",\"tags\":[\"OAuth 2.0\"],\"description\":null,\"href\":\"/docs/oauth/authorize\"},{\"title\":\"Token\",\"api\":\"POST https://app.attio.com/oauth/token\",\"tags\":[\"OAuth 2.0\"],\"description\":null,\"href\":\"/docs/oauth/token\"},{\"title\":\"Introspect\",\"api\":\"POST https://app.attio.com/oauth/introspect\",\"tags\":[\"OAuth 2.0\"],\"description\":null,\"href\":\"/docs/oauth/introspect\"}]}]},{\"group\":\"Webhook reference\",\"pages\":[{\"group\":\"Call recording events\",\"pages\":[{\"title\":\"Call recording created\",\"description\":\"This event fires after a call recording has finished and its media upload is complete.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook call-recording.created\",\"href\":\"/rest-api/webhook-reference/call-recording-events/call-recordingcreated\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Comment events\",\"pages\":[{\"title\":\"Comment created\",\"description\":\"This event is fired whenever a comment is created.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook comment.created\",\"href\":\"/rest-api/webhook-reference/comment-events/commentcreated\",\"autogeneratedByOpenApi\":true},{\"title\":\"Comment resolved\",\"description\":\"This event is fired whenever a comment is resolved.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook comment.resolved\",\"href\":\"/rest-api/webhook-reference/comment-events/commentresolved\",\"autogeneratedByOpenApi\":true},{\"title\":\"Comment unresolved\",\"description\":\"This event is fired whenever a comment is un-resolved.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook comment.unresolved\",\"href\":\"/rest-api/webhook-reference/comment-events/commentunresolved\",\"autogeneratedByOpenApi\":true},{\"title\":\"Comment deleted\",\"description\":\"This event is fired whenever a comment is deleted.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook comment.deleted\",\"href\":\"/rest-api/webhook-reference/comment-events/commentdeleted\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"List events\",\"pages\":[{\"title\":\"List created\",\"description\":\"This event is fired whenever a list is created.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook list.created\",\"href\":\"/rest-api/webhook-reference/list-events/listcreated\",\"autogeneratedByOpenApi\":true},{\"title\":\"List updated\",\"description\":\"This event is fired whenever a list is updated (e.g. when changing the name or icon of the list).\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook list.updated\",\"href\":\"/rest-api/webhook-reference/list-events/listupdated\",\"autogeneratedByOpenApi\":true},{\"title\":\"List deleted\",\"description\":\"This event is fired whenever a list is deleted.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook list.deleted\",\"href\":\"/rest-api/webhook-reference/list-events/listdeleted\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"List attribute events\",\"pages\":[{\"title\":\"List attribute created\",\"description\":\"This event is fired whenever a list attribute is created (e.g. adding an \\\"Owner\\\" attribute).\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook list-attribute.created\",\"href\":\"/rest-api/webhook-reference/list-attribute-events/list-attributecreated\",\"autogeneratedByOpenApi\":true},{\"title\":\"List attribute updated\",\"description\":\"This event is fired whenever a list attribute is updated (e.g. when changing the name of the \\\"Owner\\\" attribute to \\\"Proprietor\\\").\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook list-attribute.updated\",\"href\":\"/rest-api/webhook-reference/list-attribute-events/list-attributeupdated\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"List entry events\",\"pages\":[{\"title\":\"List entry created\",\"description\":\"This event is fired whenever a list entry is created (i.e. when a record is added to a list).\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook list-entry.created\",\"href\":\"/rest-api/webhook-reference/list-entry-events/list-entrycreated\",\"autogeneratedByOpenApi\":true},{\"title\":\"List entry updated\",\"description\":\"This event is fired whenever an existing list entry is updated (i.e. when a list attribute is changed for a specific list entry, e.g. when setting \\\"Owner\\\").\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook list-entry.updated\",\"href\":\"/rest-api/webhook-reference/list-entry-events/list-entryupdated\",\"autogeneratedByOpenApi\":true},{\"title\":\"List entry deleted\",\"description\":\"This event is fired whenever a list entry is deleted (i.e. when a record is removed from a list).\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook list-entry.deleted\",\"href\":\"/rest-api/webhook-reference/list-entry-events/list-entrydeleted\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Object attribute events\",\"pages\":[{\"title\":\"Object attribute created\",\"description\":\"This event is fired whenever an object attribute is created (e.g. when defining a new attribute \\\"Rating\\\" on the company object).\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook object-attribute.created\",\"href\":\"/rest-api/webhook-reference/object-attribute-events/object-attributecreated\",\"autogeneratedByOpenApi\":true},{\"title\":\"Object attribute updated\",\"description\":\"This event is fired whenever an object attribute is updated (e.g. when renaming the \\\"Rating\\\" attribute to \\\"Score\\\" on the company object).\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook object-attribute.updated\",\"href\":\"/rest-api/webhook-reference/object-attribute-events/object-attributeupdated\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Note events\",\"pages\":[{\"title\":\"Note created\",\"description\":\"This event is fired whenever a note is created. The `parent_object_id` refers to the object that the note references (e.g. the person object), and the `parent_record_id` refers to the record that the note references.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook note.created\",\"href\":\"/rest-api/webhook-reference/note-events/notecreated\",\"autogeneratedByOpenApi\":true},{\"title\":\"Note updated\",\"description\":\"This event is fired whenever the title of a note is modified. Body updates do not currently trigger webhooks.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook note.updated\",\"href\":\"/rest-api/webhook-reference/note-events/noteupdated\",\"autogeneratedByOpenApi\":true},{\"title\":\"Note deleted\",\"description\":\"This event is fired whenever a note is deleted.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook note.deleted\",\"href\":\"/rest-api/webhook-reference/note-events/notedeleted\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Note content events\",\"pages\":[{\"title\":\"Note content updated\",\"description\":\"This event is fired whenever the content (body) of a note is updated. The `parent_object_id` refers to the object that the note references (e.g. the person object), and the `parent_record_id` refers to the record that the note references.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook note-content.updated\",\"href\":\"/rest-api/webhook-reference/note-content-events/note-contentupdated\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Record events\",\"pages\":[{\"title\":\"Record created\",\"description\":\"This event is fired whenever a record is created.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook record.created\",\"href\":\"/rest-api/webhook-reference/record-events/recordcreated\",\"autogeneratedByOpenApi\":true},{\"title\":\"Record merged\",\"description\":\"This event is fired whenever two records are merged together. Merging copies properties from the \\\"duplicate\\\" record into the original record, so that the original record has the properties of both, and the duplicate record is deleted.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook record.merged\",\"href\":\"/rest-api/webhook-reference/record-events/recordmerged\",\"autogeneratedByOpenApi\":true},{\"title\":\"Record updated\",\"description\":\"This event is fired whenever an attribute on a record is updated (e.g. changing the \\\"name\\\" field on a record).\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook record.updated\",\"href\":\"/rest-api/webhook-reference/record-events/recordupdated\",\"autogeneratedByOpenApi\":true},{\"title\":\"Record deleted\",\"description\":\"This event is fired whenever a record is deleted.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook record.deleted\",\"href\":\"/rest-api/webhook-reference/record-events/recorddeleted\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Task events\",\"pages\":[{\"title\":\"Task created\",\"description\":\"This event is fired whenever a task is created.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook task.created\",\"href\":\"/rest-api/webhook-reference/task-events/taskcreated\",\"autogeneratedByOpenApi\":true},{\"title\":\"Task updated\",\"description\":\"This event is fired whenever a task is updated (e.g. the assignees or deadline are changed).\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook task.updated\",\"href\":\"/rest-api/webhook-reference/task-events/taskupdated\",\"autogeneratedByOpenApi\":true},{\"title\":\"Task deleted\",\"description\":\"This event is fired whenever a task is deleted.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook task.deleted\",\"href\":\"/rest-api/webhook-reference/task-events/taskdeleted\",\"autogeneratedByOpenApi\":true}]},{\"group\":\"Workspace member events\",\"pages\":[{\"title\":\"Workspace member created\",\"description\":\"This event is fired whenever a workspace member is added to the workspace.\",\"version\":null,\"deprecated\":null,\"openapi\":\"https://api.attio.com/openapi/webhooks webhook workspace-member.created\",\"href\":\"/rest-api/webhook-reference/workspace-member-events/workspace-membercreated\",\"autogeneratedByOpenApi\":true}]}]}]},{\"tab\":\"MCP\",\"groups\":[{\"group\":\"Overview\",\"pages\":[{\"title\":\"Attio MCP\",\"description\":null,\"href\":\"/mcp/overview\"}]}]},{\"tab\":\"SQL\",\"groups\":[{\"group\":\"Introduction\",\"pages\":[{\"title\":\"Overview\",\"description\":\"Query your workspace data with read-only SQL\",\"href\":\"/sql/overview\"},{\"title\":\"Available data\",\"description\":\"Schemas, tables, and how to discover them\",\"href\":\"/sql/available-data\"},{\"title\":\"Data connectors\",\"description\":\"Query your workspace data from external tools over the PostgreSQL protocol\",\"href\":\"/sql/data-connectors\"}]},{\"group\":\"Guides\",\"pages\":[{\"title\":\"Querying with SQL\",\"description\":\"Query your workspace data with read-only SQL\",\"href\":\"/sql/guides/querying-with-sql\"}]}]},{\"tab\":\"Share\",\"groups\":[{\"group\":\"Sharing your app\",\"pages\":[{\"title\":\"The publication lifecycle\",\"description\":\"Understand how to develop your app and share it with users\",\"href\":\"/share/the-publication-lifecycle\"},{\"title\":\"Private invites\",\"description\":\"How to share your app with specific workspaces using a private link\",\"href\":\"/share/private-invites\"},{\"title\":\"Publishing to the App Store\",\"description\":\"When and how to publish to the Attio App Store\",\"href\":\"/share/publishing-to-the-app-store\"},{\"title\":\"Shipping updates\",\"description\":\"How to ship new versions of your app\",\"href\":\"/share/shipping-updates\"}]},{\"group\":\"Publication requirements\",\"pages\":[{\"title\":\"App listings\",\"description\":\"Requirements for your app listing content when publishing to the Attio App Store\",\"href\":\"/share/app-listings\"},{\"title\":\"Code review\",\"description\":\"Code quality and security requirements for App SDK apps\",\"href\":\"/share/code-review\"},{\"title\":\"Logos\",\"description\":\"Logo and icon requirements for your app and developer account\",\"href\":\"/share/logos\"},{\"title\":\"Listing images\",\"description\":\"Screenshot requirements for your App Store listing\",\"href\":\"/share/listing-images\"}]}]}]},\"anonymizedNav\":\"$undefined\"},\"children\":\"$L2e\"}]}]}]}]]}]}]]\n"])</script><script>self.__next_f.push([1,"2f:I[604804,[\"/mintlify-assets/_next/static/chunks/39ae7a72da9a1903.js?dpl=dpl_5NdtJYwamH41ztoWfMfMpB8t5YYx\",\"/mintlify-assets/_next/static/chunks/b664fc8bb1e7ab0d.js?dpl=dpl_5NdtJYwamH41ztoWfMfMpB8t5YYx\",\"/mintlify-assets/_next/static/chunks/16c10790c9074f9a.js?dpl=dpl_5NdtJYwamH41ztoWfMfMpB8t5YYx\",\"/mintlify-assets/_next/static/chunks/e717313a872c371a.js?dpl=dpl_5NdtJYwamH41ztoWfMfMpB8t5YYx\",\"/mintlify-assets/_next/static/chunks/90079180db6f14a4.js?dpl=dpl_5NdtJYwamH41ztoWfMfMpB8t5YYx\",\"/mintlify-assets/_next/static/chunks/72a2b38525f75d98.js?dpl=dpl_5NdtJYwamH41ztoWfMfMpB8t5YYx\",\"/mintlify-assets/_next/static/chunks/2ca9a2f3a69d20cc.js?dpl=dpl_5NdtJYwamH41ztoWfMfMpB8t5YYx\",\"/mintlify-assets/_next/static/chunks/13ebb4257dd3a545.js?dpl=dpl_5NdtJYwamH41ztoWfMfMpB8t5YYx\",\"/mintlify-assets/_next/static/chunks/6fd3acb5d5a9a0e5.js?dpl=dpl_5NdtJYwamH41zt