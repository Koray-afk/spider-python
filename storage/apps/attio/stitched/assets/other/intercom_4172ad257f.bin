==:note_tweet":$R[809]={__id:"client:VHdlZXQ6MjA2MTQ3NzcxMjkzMDQ4MDIxNA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[810]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYxNDc3NzEyODA0NjM0NjI0"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDYxNDc3NzEyODA0NjM0NjI0:$R[811]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYxNDc3NzEyODA0NjM0NjI0",__typename:"NoteTweetResults",result:$R[812]={__ref:"Tm90ZVR3ZWV0OjIwNjE0Nzc3MTI4MDQ2MzQ2MjQ="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDYxNDc3NzEyODA0NjM0NjI0"},"Tm90ZVR3ZWV0OjIwNjE0Nzc3MTI4MDQ2MzQ2MjQ=":$R[813]={__id:"Tm90ZVR3ZWV0OjIwNjE0Nzc3MTI4MDQ2MzQ2MjQ=",__typename:"NoteTweet",text:"@attio replaced their contact form with a conversation, and it changed how they sell.\n\nInstead of routing new visitors to a static form, Attio used Fin for Sales and built a real-time conversational entry point that qualifies prospects, answers complex product questions, and routes leads to the right next step. 24/7, without adding headcount.\n\nThe results after 3 months:\n→ 9x increase in Messenger engagement from new leads\n→ 50+ sales-qualified leads generated\n→ 30+ startup program qualifications\n→ One converted customer came in at 6x their average contract value\n\nMatt Duffy, Head of New Business at Attio, saw where it was headed: \"This is going to be the buying experience. More and more people are going to be doing this.\"\n\nFin isn't just a support agent. It's an AI Customer Agent – handling support, qualifying leads, and driving revenue across the entire customer journey.\n\nRead the full story here: https://t.co/wcb9JnKRTJ",entity_set:$R[814]={__ref:"client:Tm90ZVR3ZWV0OjIwNjE0Nzc3MTI4MDQ2MzQ2MjQ=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNjE0Nzc3MTI4MDQ2MzQ2MjQ="},"client:Tm90ZVR3ZWV0OjIwNjE0Nzc3MTI4MDQ2MzQ2MjQ=:entity_set":$R[815]={__id:"client:Tm90ZVR3ZWV0OjIwNjE0Nzc3MTI4MDQ2MzQ2MjQ=:entity_set",__typename:"EntitySet",hashtags:$R[816]={__refs:$R[817]=[]},symbols:$R[818]={__refs:$R[819]=[]},smarttags:$R[820]={__refs:$R[821]=[]},urls:$R[822]={__refs:$R[823]=[