Tk4ODYzNDYyNDY="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUyNzU4MjE5ODg2MzQ2MjQ2"},"Tm90ZVR3ZWV0OjIwNTI3NTgyMTk4ODYzNDYyNDY=":$R[2387]={__id:"Tm90ZVR3ZWV0OjIwNTI3NTgyMTk4ODYzNDYyNDY=",__typename:"NoteTweet",text:"Most AI Agents treat product catalogs like documents.\n\nThat breaks when a shopper asks for anything with real constraints (like price, size, or availability) – because the system can return something that looks relevant but doesn’t actually satisfy what the customer asked for.\n\nShopping queries have structure: price limits, sizes, stock, variants.\n\nSo the Fin AI Group built a RAG system to handle both semantic intent and hard constraints in one system.\n\nThis new system powers Fin for Ecommerce, a new role for Fin the Customer Agent\n\nHow it works ↓\nhttps://t.co/ZqJo0zk3cW",entity_set:$R[2388]={__ref:"client:Tm90ZVR3ZWV0OjIwNTI3NTgyMTk4ODYzNDYyNDY=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNTI3NTgyMTk4ODYzNDYyNDY="},"client:Tm90ZVR3ZWV0OjIwNTI3NTgyMTk4ODYzNDYyNDY=:entity_set":$R[2389]={__id:"client:Tm90ZVR3ZWV0OjIwNTI3NTgyMTk4ODYzNDYyNDY=:entity_set",__typename:"EntitySet",hashtags:$R[2390]={__refs:$R[2391]=[]},symbols:$R[2392]={__refs:$R[2393]=[]},smarttags:$R[2394]={__refs:$R[2395]=[]},urls:$R[2396]={__refs:$R[2397]=["client:Tm90ZVR3ZWV0OjIwNTI3NTgyMTk4ODYzNDYyNDY=:entity_set:urls:0"]},user_mentions:$R[2398]={__refs:$R[2399]=[]}},"client:Tm90ZVR3ZWV0OjIwNTI3NTgyMTk4ODYzNDYyNDY=:entity_set:urls:0":$R[2400]={__id:"client:Tm90ZVR3ZWV0OjIwNTI3NTgyMTk4ODYzNDYyNDY=:entity_set:urls:0",__typename:"UrlsEntity",display_url:"fin.ai/research/struc…",expanded_url:"https://fin.ai/research/structured-agentic-rag-for-e-commerce/",indices:$R[2401]=[554,577],url:"https://t.co/ZqJo0zk3cW"},"client:VHdlZXQ6MjA1Mjc1ODIyMDAzMzE2MzU0Nw==:grok_translated_post_with_availability":$R[2402]={__id:"client:VHdlZXQ6MjA1Mjc1ODIyMDAzMzE2MzU0Nw==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA1Mjc1ODIyMDAzMzE2MzU0Nw==:edit