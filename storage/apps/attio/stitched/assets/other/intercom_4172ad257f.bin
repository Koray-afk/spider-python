TgzNzQ1MTg3ODY3MA==:note_tweet":$R[2143]={__id:"client:VHdlZXQ6MjA1MjgwMTgzNzQ1MTg3ODY3MA==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[2144]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODAxODM3MzQyODY3NDYy"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODAxODM3MzQyODY3NDYy:$R[2145]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODAxODM3MzQyODY3NDYy",__typename:"NoteTweetResults",result:$R[2146]={__ref:"Tm90ZVR3ZWV0OjIwNTI4MDE4MzczNDI4Njc0NjI="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODAxODM3MzQyODY3NDYy"},"Tm90ZVR3ZWV0OjIwNTI4MDE4MzczNDI4Njc0NjI=":$R[2147]={__id:"Tm90ZVR3ZWV0OjIwNTI4MDE4MzczNDI4Njc0NjI=",__typename:"NoteTweet",text:"There’s a reality that’s starting to take shape: for some teams, AI is already handling the majority of customer conversations.\n\nAt our recent Fin x @AnthropicAI meetup, we shared how this is already happening in practice. Fin now resolves over 80% of support queries end to end. The technology is here, but adoption is still catching up.\n\nThat progress is unlocking something bigger. Fin is moving beyond support toward a broader vision, where one agent can deliver a consistent, high-quality experience across the entire customer lifecycle, from day zero to year ten.\n\nWatch more below to hear how close we are to that future, and what it takes to get there.",entity_set:$R[2148]={__ref:"client:Tm90ZVR3ZWV0OjIwNTI4MDE4MzczNDI4Njc0NjI=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNTI4MDE4MzczNDI4Njc0NjI="},"client:Tm90ZVR3ZWV0OjIwNTI4MDE4MzczNDI4Njc0NjI=:entity_set":$R[2149]={__id:"client:Tm90ZVR3ZWV0OjIwNTI4MDE4MzczNDI4Njc0NjI=:entity_set",__typename:"EntitySet",hashtags:$R[2150]={__refs:$R[2151]=[]},symbols:$R[2152]={__refs:$R[2153]=[]},smarttags:$R[2154]={__refs:$R[2155]=[]},urls:$R[2156]={__refs:$R[2157]=[]},user_mentions:$R[2158]={__refs:$R[2159]=["client:Tm90ZVR3ZWV0OjIwNTI4MDE4MzczNDI4Njc0NjI=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwNTI4MDE4MzczNDI4Njc0NjI=:entity_set:user_mentions:0":$R[2160]={__id:"client:Tm90ZVR3ZWV0OjIwNTI4MDE4MzczND