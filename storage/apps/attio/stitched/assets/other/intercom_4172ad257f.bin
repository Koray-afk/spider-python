nsitive_media_warning:null,indices:$R[1492]=[281,304]},"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:media_entities2:3:original_info":$R[1493]={__id:"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:media_entities2:3:original_info",__typename:"ApiMediaEntityOriginalInfo",width:2500,height:1667},"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:details":$R[1494]={__id:"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:details",__typename:"TBirdData",display_text_range:$R[1495]=[0,280],self_thread_metadata:null,full_text:"Earlier this month, the EMEA leg of our Customer Service Transformation tour came to a close in Amsterdam.\n\nOne theme that surfaced throughout the evening: the teams making the most progress with AI aren't treating it like a tool. They've given it a name. Vera. Stella. Kiki.\n\nAnd https://t.co/Z3M5wK2xAT",hashtag_entities:$R[1496]={__refs:$R[1497]=[]},cashtag_entities:$R[1498]={__refs:$R[1499]=[]},smarttags:$R[1500]={__refs:$R[1501]=[]},created_at_ms:1779202912000},"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:note_tweet":$R[1502]={__id:"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[1503]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDU2NzUyMjAyMDQ4Mjc4NTI5"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDU2NzUyMjAyMDQ4Mjc4NTI5:$R[1504]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDU2NzUyMjAyMDQ4Mjc4NTI5",__typename:"NoteTweetResults",result:$R[1505]={__ref:"Tm90ZVR3ZWV0OjIwNTY3NTIyMDIwNDgyNzg1Mjk="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDU2NzUyMjAyMDQ4Mjc4NTI5"},"Tm90ZVR3ZWV0OjIwNTY3NTIyMDIwNDgyNzg1Mjk=":$R[1506]={__id:"Tm90ZVR3ZWV0OjIwNTY3NTIyMDIwNDgyNzg1Mjk=",__typename:"NoteTweet",text:"Earlier this month, the EMEA leg of our Customer Service Transformation tour came to a close in Amsterdam.\n\nOne theme that surfaced throughout the evening: the teams making the most progress with AI aren't treating it like a tool. They've given it a name. Vera. Stella. Kiki.\n\nAnd to the people running support at Road, WebinarGeek, and ParkBee, it's a genuine member of the team with a role, a track record, and a personality. That framing changes how you build, how you measure, and how you get stakeholder buy-in.\n\nThanks to our panelists: Marco, Bob, and Tim, to Caroline and Christopher for leading the discussions, and to everyone who joined us in Amsterdam!\n\nStay tuned for information on the next stops on the Customer Service Transformation Tour.",entity_set:$R[1507]={__ref:"client:Tm90ZVR3ZWV0OjIwNTY3NTIyMDIwNDgyNzg1Mjk=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNTY3NTIyMDIwNDgyNzg1Mjk="},"client:Tm90ZVR3ZWV0OjIwNTY3NTIyMDIwNDgyNzg1Mjk=:entity_set":$R[1508]={__id:"client:Tm90ZVR3ZWV0OjIwNTY3NTIyMDIwNDgyNzg1Mjk=:entity_set",__typename:"EntitySet",hashtags:$R[1509]={__refs:$R[1510]=[]},symbols:$R[1511]={__refs:$R[1512]=[]},smarttags:$R[1513]={__refs:$R[1514]=[]},urls:$R[1515]={__refs:$R[1516]=[]},user_mentions:$R[1517]={__refs:$R[1518]=[]}},"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:grok_translated_post_with_availability":$R[1519]={__id:"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:edit_control":$R[1520]={__id:"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[1521]=["2056752202178257356"]},"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:quick_promote_eligibility":$R[1522]={__id:"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:quick_promote_eligibility",__typename:"TweetQuickPromoteEligibilityResponse",eligibility:"IneligibleUserUnauthorized"},"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:views":$R[1523]={__id:"client:VHdlZXQ6MjA1Njc1MjIwMjE3ODI1NzM1Ng==:views",__typename:"ViewCountInfo",count:"892"},"urt:server:TimelineTimelineEntry:tweet-2056399491566051613":$R[1524]={__id:"urt:server:TimelineTimelineEntry:tweet-2056399491566051613",__typename:"TimelineTimelineEntry",entry_id:"tweet-2056399491566051613",sort_index:"2074181