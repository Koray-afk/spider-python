\" CTA you can turn on or off.\n\n@Attio is already seeing the benefits from Spotlight Messenger – at our recent event in London, Will Jones shared that initial results show a ~90% increase in engagement.\n\nLearn more about Spotlight Messenger, and Fin for Sales at the link in the replies.",entity_set:$R[1738]={__ref:"client:Tm90ZVR3ZWV0OjIwNTU2NzM0NTkxOTYxODI1Mjg=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNTU2NzM0NTkxOTYxODI1Mjg="},"client:Tm90ZVR3ZWV0OjIwNTU2NzM0NTkxOTYxODI1Mjg=:entity_set":$R[1739]={__id:"client:Tm90ZVR3ZWV0OjIwNTU2NzM0NTkxOTYxODI1Mjg=:entity_set",__typename:"EntitySet",hashtags:$R[1740]={__refs:$R[1741]=[]},symbols:$R[1742]={__refs:$R[1743]=[]},smarttags:$R[1744]={__refs:$R[1745]=[]},urls:$R[1746]={__refs:$R[1747]=[]},user_mentions:$R[1748]={__refs:$R[1749]=["client:Tm90ZVR3ZWV0OjIwNTU2NzM0NTkxOTYxODI1Mjg=:entity_set:user_mentions:0"]}},"client:Tm90ZVR3ZWV0OjIwNTU2NzM0NTkxOTYxODI1Mjg=:entity_set:user_mentions:0":$R[1750]={__id:"client:Tm90ZVR3ZWV0OjIwNTU2NzM0NTkxOTYxODI1Mjg=:entity_set:user_mentions:0",__typename:"ApiMentionEntity",indices:$R[1751]=[434,440],is_unmentioned:null,screen_name:"Attio"},"client:VHdlZXQ6MjA1NTY3MzQ1OTMxMzY2ODEwMQ==:grok_translated_post_with_availability":$R[1752]={__id:"client:VHdlZXQ6MjA1NTY3MzQ1OTMxMzY2ODEwMQ==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA1NTY3MzQ1OTMxMzY2ODEwMQ==:edit_control":$R[1753]={__id:"client:VHdlZXQ6MjA1NTY3MzQ1OTMxMzY2ODEwMQ==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[1754]=["2055673459313668101"]},"client:VHdlZXQ6MjA1NTY3MzQ1OTMxMzY2ODEwMQ==:quick_promote_eligibility":$R[1755]={__id:"client:VHdlZXQ6MjA1NTY3MzQ1OTMxMzY2ODEwMQ==:quick_promote_eligibility",__typename:"TweetQuickPromoteEligibilityResponse",eligibility:"IneligibleUserUnauthorized"},"client:VHdlZXQ6MjA1NTY3MzQ1OTMxMzY2ODEwMQ==:views":$R[1756]={__id:"client:VHdlZXQ6MjA1NTY3MzQ1OTMxMzY2ODEwMQ==:views",__typename:"ViewCountInfo",count:"207