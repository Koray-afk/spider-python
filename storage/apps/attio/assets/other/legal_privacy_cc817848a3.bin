\"children\":[[\"$\",\"li\",\".$list_item=2c1_1607\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c2_1606\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"b\",\".$bold=20_1605\",{\"className\":\"in-[p]:font-semibold\",\"children\":[[\"$\",\"$1\",\".$qepdyn7kjf8\",{\"children\":[\"- Consent Withdrawal\"]}]]}],[\"$\",\"$1\",\".$qj806x9mnp\",{\"children\":[\". You may withdraw any consent you previously provided to us regarding the processing of your personal data, at any time and free of charge. We will apply your preferences going forward and this will not affect the lawfulness of the processing before you withdrew your consent.\"]}]]}]]}]]}]\ne4:[\"$\",\"ul\",\"bullet_list:c1_1612\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1611\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c2_1610\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"b\",\".$bold=20_1609\",{\"className\":\"in-[p]:font-semibold\",\"children\":[[\"$\",\"$1\",\".$h4to4meb74\",{\"children\":[\"- Complaint\"]}]]}],[\"$\",\"$1\",\".$bagxgrj8dp\",{\"children\":[\". You may lodge a complaint with a supervisory authority, including in your country of residence, place of work, or where an incident took place. We would, however, appreciate the chance to deal with your concerns before you approach a supervisory authority, so please contact us in the first instance.\"]}]]}]]}]]}]\ne5:[\"$\",\"p\",\"paragraph:c1_1613\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$z"])</script><script>self.__next_f.push([1,"bqjp69k82\",{\"children\":[\"You may exercise these rights by contacting us using the contact details at the end of this Privacy Policy. Please note that there are exceptions and limitations to each of these rights.\"]}]]}]\ne6:[\"$\",\"p\",\"paragraph:c1_1614\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$vxnc4ojyte9\",{\"children\":[\"If we are a processor of your data (and our client is the controller) we shall only process your personal data as instructed by our client. You will need to contact our client directly if you wish to exercise your rights in relation to the data processed on our platform. If you do contact us directly, we will notify our client as soon as reasonably practical and assist our client as the controller by taking appropriate measures to enable the fulfilment of our obligations to you.\"]}]]}]\ne7:[\"$\",\"p\",\"paragraph:c3_1616\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$aebyu3tb6fp\",{\"children\":[\"If you have any complaints in relation to this Privacy Policy or otherwise in relation to our processing of your personal data, please tell us. We shall review and investigate your complaint and try to get back to you within a reasonable time. You can also contact the Information Commissioner, see \"]}],[\"$\",\"a\",\".$link=20=2hz0hb_1615\",{\"href\":\"http://www.ico.org.uk\",\"target\":null,\"rel\":\"$undefined\",\"className\":\"-mx-px rounded-sm px-px underline transition-colors duration-400 hover:duration-150 active:duration-50 text-link-foreground decoration-transparent hover:text-link-strong-foreground hover:decoration-link-strong-foreground active:text-link-strong-foreground\",\"style\":\"$undefined\",\"children\":[[\"$\",\"$1\",\".$3she8lo2bsu\",{\"children\":[\"www.ico.org.uk\"]}]]}],[\"$\",\"$1\",\".$xah6745l8pn\",{\"children\":[\" or if you are based outside of the United Kingdom, please contact your local data protection authority.\"]}]]}]\ne8:[\"$\",\"h2\",\"heading:l2:c1_1617\",{\"id\":\"12-retention-of-personal-data\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-5 font-bold text-2xl text-primary-foreground lg:not-first:mt-20\",\"children\":[[\"$\",\"$1\",\".$khuct2nf0pq\",{\"children\":[\"12. Retention of personal data\"]}]]}]\ne9:[\"$\",\"p\",\"paragraph:c1_1618\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$s98d9ck11ri\",{\"children\":[\"We will retain personal data in accordance with applicable laws.\"]}]]}]\nea:[\"$\",\"p\",\"paragraph:c1_1619\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$6ca6s12afdd\",{\"children\":[\"If we have received your personal data because you are an employee of a client, we shall retain your personal data until we no longer work with your employer, except where we are required to retain personal data for a particular period of time to comply with legal, auditory, or statutory requirements, including requirements of HMRC in respect of financial documents.\"]}]]}]\neb:[\"$\",\"p\",\"paragraph:c1_1620\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$nownz9fpptj\",{\"children\":[\"If we have your personal data because a client has uploaded it to our platform, we shall retain it in accordance with our client’s instructions.\"]}]]}]\nec:[\"$\",\"p\",\"paragraph:c1_1621\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$ymw3wnso4v\",{\"children\":[\"In some circumstances you can ask us to delete your data: see ‘Your rights’ above for further information.\"]}]]}]\ned:[\"$\",\"p\",\"paragraph:c1_1622\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$0vpofb86zl5\",{\"children\":[\"In some circumstances we will anonymize your personal data (so that it can no longer be associated with you) for research or statistical purposes, in"])</script><script>self.__next_f.push([1," which case we may use this information indefinitely without further notice to you.\"]}]]}]\nee:[\"$\",\"h2\",\"heading:l2:c1_1623\",{\"id\":\"13-childrens-privacy\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-5 font-bold text-2xl text-primary-foreground lg:not-first:mt-20\",\"children\":[[\"$\",\"$1\",\".$y8bnxbnbqo\",{\"children\":[\"13. Children’s privacy\"]}]]}]\nef:[\"$\",\"p\",\"paragraph:c3_1625\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$5eezqyw4ode\",{\"children\":[\"We do not knowingly collect, maintain, or use personal data from children under 18 years of age, and no part of our services is directed to children. If you learn that a child has provided us with personal information in violation of this Privacy Policy, then you may alert us by emailing \"]}],[\"$\",\"a\",\".$link=20=2hp5ma_1624\",{\"href\":\"mailto:support@attio.com\",\"target\":null,\"rel\":\"$undefined\",\"className\":\"-mx-px rounded-sm px-px underline transition-colors duration-400 hover:duration-150 active:duration-50 text-link-foreground decoration-transparent hover:text-link-strong-foreground hover:decoration-link-strong-foreground active:text-link-strong-foreground\",\"style\":\"$undefined\",\"children\":[[\"$\",\"$1\",\".$ijitlrz1o5o\",{\"children\":[\"support@attio.com\"]}]]}],[\"$\",\"$1\",\".$c0j10zj5uan\",{\"children\":[\".\"]}]]}]\nf0:[\"$\",\"h2\",\"heading:l2:c1_1626\",{\"id\":\"14-third-party-platforms\",\"classNam