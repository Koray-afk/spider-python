aragraph=2c1_1408\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$nv3djdsc8i\",{\"children\":[\"- Otherwise contact us, for example with queries, comments, or complaints.\"]}]]}]]}]]}]\n8c:[\"$\",\"p\",\"paragraph:c1_1411\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$r94slv48dl\",{\"children\":[\"Personal data you provi"])</script><script>self.__next_f.push([1,"de to us may include your name, email address, phone number, location or region and, if you are applying for a job with us, information you choose to provide on your CV/resume (such as your education and employment history).\"]}]]}]\n8d:[\"$\",\"p\",\"paragraph:c1_1412\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$5s1prdatbi\",{\"children\":[\"We shall process all such personal data in accordance with this Privacy Policy. Certain personal data is mandatory to be provided to us in order that we can fulfil your request, for example to provide services to you. We make this clear to you at the point of collection of the personal data.\"]}]]}]\n8e:[\"$\",\"p\",\"paragraph:c1_1413\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$acqe5scqqmk\",{\"children\":[\"Where we need to collect personal data by law, or under the terms of a contract we have with you, and you fail to provide that data when requested, we may not be able to perform the contract we have or are trying to enter into with you (for example, to provide you with our services). In this case, we may have to cancel a product or service you have with us, but we will notify you if this is the case at the time.\"]}]]}]\n8f:[\"$\",\"p\",\"paragraph:c1_1414\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$90dvseu10gh\",{\"children\":[\"All personal data that you provide to us must be true, complete, and accurate. At our request, you shall promptly provide evidence of your identity. If you provide us with inaccurate or false data, and we suspect or identify fraud, we will record this, and we may be unable to provide our services to you. We may also report this information. When you contact us by email or post, we may keep a record of the correspondence, and we may also record any telephone call we have with you.\"]}]]}]\n90:[\"$\",\"h3\",\"heading:l3:c1_1415\",{\"id\":\"32-data-we-automatically-collect-about-you\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-2 font-semibold text-lg text-secondary-foreground\",\"children\":[[\"$\",\"$1\",\".$uzm53cxpcv\",{\"children\":[\"3.2. Data we automatically collect about you\"]}]]}]\n91:[\"$\",\"p\",\"paragraph:c1_1416\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$5jyctpfv98c\",{\"children\":[\"When you use our services, we automatically collect and store information about your device and your activities. This information could include:\"]}]]}]\n92:[\"$\",\"ul\",\"bullet_list:c1_1419\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1418\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1417\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$vxzmzpboojm\",{\"children\":[\"- Technical information about your device such as type of device, web browser or operating system.\"]}]]}]]}]]}]\n93:[\"$\",\"ul\",\"bullet_list:c1_1422\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1421\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1420\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$ho4ddr44zyn\",{\"children\":[\"- Your preferences and settings such as time zone and language.\"]}]]}]]}]]}]\n94:[\"$\",\"ul\",\"bullet_list:c1_1425\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1424\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1423\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$eg8fmv8h87o\",{\"child"])</script><script>self.__next_f.push([1,"ren\":[\"- How long you used the website/app and which services and features you used.\"]}]]}]]}]]}]\n95:[\"$\",\"ul\",\"bullet_list:c1_1428\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1427\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1426\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$15f65tvgsjd\",{\"children\":[\"- Your location information, which we infer by using your IP address.\"]}]]}]]}]]}]\n96:[\"$\",\"ul\",\"bullet_list:c1_1431\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1430\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1429\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$la98njvu0mn\",{\"children\":[\"- Information about your interactions with our website and services, such as the pages or other content you view, referrer information (the website you visited before coming to our services), and the dates and times of your visits.\"]}]]}]]}]]}]\n97:[\"$\",\"p\",\"paragraph:c3_1433\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$464jqv0e14p\",{\"children\":[\"If you want to find out more about the types of cookies we use, why, and how you can control them, please see our \"]}],[\"$\",\"a\",\".$link=20=2hvpub_1432\",{\"href\":\"https://attio.com/legal/cookies\",\"target\":null,\"rel\":\"$undefined\",\"className\":\"-mx-px rounded-sm px-px underline transition-colors duration-400 hover:duration-150 active:duration-50 text-link-foreground decoration-transparent hover:text-link-strong-foreground hover:decoration-link-strong-foreground active:text-link-strong-foreground\",\"style\":\"$undefined\",\"children\":[[\"$\",\"$1\",\".$in6c36f51sb\",{\"children\":[\"Cookie Policy\"]}]]}],[\"$\",\"$1\",\".$22kix3yattv\",{\"children\":[\".\"]}]]}]\n98:[\"$\",\"p\",\"paragraph:c1_1434\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$8tgez4bbtco\",{\"children\":[\"We will also collect information about our communications with you, including whether our emails were successfully delivered, whether they were opened, and whether you interacted with their content.\"]}]]}]\n99:[\"$\",\"h3\",\"heading:l3:c1_1435\",{\"id\":\"33-type-of-data-we-automatically-collect-from-connected-third-party-services,-such-as-google-services,-dropbox,-microsoft-outlook,-and-microsoft-onedrive\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-2 font-semibold text-lg text-secondary-foreground\",\"children\":[[\"$\",\"$1\",\".$feutiskrard\",{\"children\":[\"3.3. Type of data we automatically collect from connected third-party services, such as Google Services, Dropbox, Microsoft Outlook, and Microsoft OneDrive\"]}]]}]\n9a:[\"$\",\"p\",\"paragraph:c1_1436\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$s6e5ostjmx\",{\"children\":[\"You may choose the option to log in with or access third-party services in order to access this information from within the Attio application and in such cases, we will automatically collect and store your user data from that third party. This may include:\"]}]]}]\n9b:[\"$\",\"ul\",\"bullet_list:c1_1439\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1438\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1437\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$jv4jr2s9gh\",{\"children\":[\"- Profile with third party\"]}]]}]]}]]}]\n9c:[\"$\",\"ul\",\"bullet_list:c1_1442\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1441\",{\"className\":\"p"])</script><script>self.__next_f.push([1,"t-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1440\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$v8anxq6l9x\",{\"children\":[\"- Name\"]}]]}]]}]]}]\n9d:[\"$\",\"ul\",\"bullet_list:c1_1445\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1444\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1443\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$ektddo1zyx\",{\"children\":[\"- Email address\"]}]]}]]}]]}]\n9e:[\"$\",\"h3\",\"heading:l3:c1_1446\",{\"id\":\"34-data-we-receive-from-others\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-2 font-semibold text-lg text-secondary-foreground\",\"children\":[[\"$\",\"$1\",\".$3ihh7omblc\",{\"children\":[\"3.4. Data we receive from others\"]}]]}]\n9f:[\"$\",\"p\",\"paragraph:c1_1447\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$f69ybnz791g\",{\"children\":[\"Your employer or a colleague may from time to time provide personal data to us that relates to you (for example, your email address) so that you can create an account on our platform. If a third party such as your employer or a colleague provides us with your email address, and that address is your personal, non-work email address, you must contact us to let us know and we will remove this data.\"]}]]}]\na0:[\"$\",\"p\",\"paragraph:c1_1448\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$pfnq01095jp\",{\"children\":[\"We may also receive personal data about you from an Integration App, our payment providers and/or our website security service partners, particularly if there is any misuse of the platform including the introduction of viruses or other malicious software.\"]}]]}]\na1:[\"$\",\"p\",\"paragraph:c1_1449\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$2cnnb2j4n0g\",{\"children\":[\"If you sign up or log in to your Attio account using a third-party account (such as your Google account), we may receive personal data from those services, such as your name, email address, and profile information.\"]}]]}]\na2:[\"$\",\"p\",\"paragraph:c1_1450\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$iibx85herc\",{\"children\":[\"If you access our services through third-party tools such via an MCP, we may receive information relating to your connection between Attio and such third-party services.\"]}]]}]\na3:[\"$\",\"p\",\"paragraph:c1_1451\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$oxr03df0dx\",{\"children\":[\"If you express an interest in Attio’s platform and services (for example, by requesting to talk to sales on our website), or if we think you may be interested in our services, we may collect information about you from third parties and use this information to contact you. You can ask to unsubscribe from being contacted at any time.\"]}]]}]\na4:[\"$\",\"p\",\"paragraph:c1_1452\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$ifudwcq0sbm\",{\"children\":[\"If you apply for a job with us, we may receive information about you and references from your previous employer. We may also collect your information from third-party platforms such as LinkedIn if we think that you may be suitable for a vacancy that we are promoting at Attio. If you accept a role with us, we will work with third-party partners to verify your identity and carry out background checks, including right to work checks and, for certain job roles, criminal background checks.\"]}]]}]\na5:[\"$\",\"h2\",\"heading:l2:c1_1453\",{\"id\":\"4-using-data-from-connected-"])</script><script>self.__next_f.push([1,"google-services\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-5 font-bold text-2xl text-primary-foreground lg:not-first:mt-20\",\"children\":[[\"$\",\"$1\",\".$mofgb9espi\",{\"children\":[\"4. Using data from connected Google Services\"]}]]}]\na6:[\"$\",\"p\",\"paragraph:c1_1454\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$8oa53g9gefy\",{\"children\":[\"If we have received your personal data because you have chosen to Sign in with Google, we will process your personal data to perform any contract we have entered into with your employer or in relation to any steps we take at the request of your employer prior to entering into a contract. In particular, this includes providing you with access to the Attio application.\"]}]]}]\na7:[\"$\",\"p\",\"paragraph:c1_1455\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$ifmxa54gog9\",{\"children\":[\"Attio is providing a customer relationship management (CRM) and task management application aimed at business customers. If we have received personal data because you have chosen to connect your Google Drive, Google Calendar and/or your Gmail account we will collect your data from this service in order to enhance the email, file and contact management experience and improve your productivity when using the Attio application. In particular, this includes access to your Google user data from within the Attio application where you can view your data in the relevant context of a CRM software application and manage your professional relationships.\"]}]]}]\na8:[\"$\",\"p\",\"paragraph:c1_1456\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$2cfkr4q2dtq\",{\"children\":[\"Additional Limits on Use of Your Google User Data:\"]}]]}]\na9:[\"$\",\"p\",\"paragraph:c1_1457\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$f83brftw02\",{\"children\":[\"Notwithstanding anything else in this Privacy Policy, if you provide us with access to data from connected Google services, our use of that data will be subject to the additional restrictions set out below. For the avoidance of doubt, we process data received from connected Google services solely in the capacity of a processor on your behalf, and not as a controller:\"]}]]}]\naa:[\"$\",\"ul\",\"bullet_list:c1_1460\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1459\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1458\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$amhdxgm9bvv\",{\"children\":[\"- We will only use access to data from a connected Google Service to provide our Attio web and mobile CRM and task management application that allows users to read, process, write and delete emails, track recipient opens, clicks and replies to emails, access their Google Drive files and calendar. Furthermore, our use of data is limited to providing or improving user-facing features that are prominent in the requesting application’s user interface.\"]}]]}]]}]]}]\nab:[\"$\",\"ul\",\"bullet_list:c1_1463\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1462\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1461\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$oxdt8yh0xas\",{\"children\":[\"- We will not transfer this data to others unless doing so is necessary to provide and improve features that are prominent in the user interface, comply with applicable law, or as part of a merger, acquisition, or sale of assets.\"]}]]}]]}]]}]\nac:[\"$\",\"ul\",\"bullet_list:c1_1466\",{\"className\":\"not-first:mt-1.5 list-[squar"])</script><script>self.__next_f.push([1,"e] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1465\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1464\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$ys1lk54juu\",{\"children\":[\"- We will never use Google User data for serving advertisements, including retargeting, personalized, or interest-based advertising.\"]}]]}]]}]]}]\nad:[\"$\",\"ul\",\"bullet_list:c1_1469\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1468\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1467\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$k41p484xpa\",{\"children\":[\"- We will not allow humans to read this data unless we have your affirmative agreement for specific messages, doing so is necessary for security purposes such as investigating abuse, to comply with applicable law, or for our internal operations and even then, only when the data have been aggregated and anonymized.\"]}]]}]]}]]}]\nae:[\"$\",\"ul\",\"bullet_list:c1_1472\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1471\",{\