":[[\"$\",\"$1\",\".$ogishcu68ai\",{\"children\":[\"We may use your identity, contact, technical, usage and profile data to form a view on what we think you may want or need, or what may be of interest to you. This is how we decide which products, services and offers may be relevant for you (we call this marketing).\"]}]]}]\nc6:[\"$\",\"p\",\"paragraph:c1_1532\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$c5n69vmqllu\",{\"children\":[\"You will receive marketing communications from us if you have requested information from us or purchased our services from us or where you have not opted out of receiving that marketing.\"]}]]}]\nc7:[\"$\",\"p\",\"paragraph:c1_1533\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$2i1m0590dli\",{\"children\":[\"You can ask us to stop sending you marketing messages at any time by following the opt-out links on any marketing message sent to you, accessing our website settings or by contacting us at any time. Please note that where you do opt-out of marketing emails, it may take us a few days to update our records to reflect your request.\"]}]]}]\nc8:[\"$\",\"p\",\"paragraph:c1_1534\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$xb9oc7hoxzh\",{\"children\":[\"Where you opt out of receiving these marketing messages, this will not apply to personal data provided to us as a result of a purchase, warranty registration, product/service experience or other transactions. You may therefore receive emails relating to your use, account and/or users use or account even if you have opted out of our marketing emails. This is because these emails are transactional and/or informational in nature and do not require your consent to receive.\"]}]]}]\nc9:[\"$\",\"p\",\"paragraph:c1_1535\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$ccxcw8bp82e\",{\"children\":[\"If you ask us to remove you from our mailing lists, we shall keep a record of your name and email address to ensure that we do not send to you anymore information you have opted out of receiving. We shall also continue to send you necessary information relating to your use of our services if you, your employer or colleague has an account with us.\"]}]]}]\nca:[\"$\""])</script><script>self.__next_f.push([1,",\"h2\",\"heading:l2:c1_1536\",{\"id\":\"8-who-do-we-share-your-data-with\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-5 font-bold text-2xl text-primary-foreground lg:not-first:mt-20\",\"children\":[[\"$\",\"$1\",\".$3i1jyvqsisi\",{\"children\":[\"8. Who do we share your data with?\"]}]]}]\ncb:[\"$\",\"p\",\"paragraph:c1_1537\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$dn2t23x4luj\",{\"children\":[\"We may share your personal data with third parties in the following circumstances:\"]}]]}]\ncc:[\"$\",\"ul\",\"bullet_list:c1_1541\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1540\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c2_1539\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"b\",\".$bold=20_1538\",{\"className\":\"in-[p]:font-semibold\",\"children\":[[\"$\",\"$1\",\".$ofvzq2buipn\",{\"children\":[\"- Service providers working on our behalf\"]}]]}],[\"$\",\"$1\",\".$6e49chi093n\",{\"children\":[\". We may share your personal data with any service providers, sub-contractors, and agents that we may appoint to perform functions on our behalf and in accordance with our instructions, including payment providers and IT hosting and maintenance services.\"]}]]}]]}]]}]\ncd:[\"$\",\"ul\",\"bullet_list:c1_1545\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1544\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c2_1543\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"b\",\".$bold=20_1542\",{\"className\":\"in-[p]:font-semibold\",\"children\":[[\"$\",\"$1\",\".$ou9e056t8vp\",{\"children\":[\"- Service providers you use\"]}]]}],[\"$\",\"$1\",\".$kvfu0b2aqr\",{\"children\":[\". If you use third-party services, for example using an Integration App or via our MCP, we will send certain information in order to make the connection. This includes, for example, member ID, email address and name.\"]}]]}]]}]]}]\nce:[\"$\",\"ul\",\"bullet_list:c1_1549\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1548\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c2_1547\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"b\",\".$bold=20_1546\",{\"className\":\"in-[p]:font-semibold\",\"children\":[[\"$\",\"$1\",\".$10c4qqr1trkr\",{\"children\":[\"- Independent service providers\"]}]]}],[\"$\",\"$1\",\".$q8tqwu6v81r\",{\"children\":[\". We may share your personal data with, or receive your personal data from, third parties that we partner with to support various aspects of our business and our services. This includes, for example, third party payment providers who collect payments on our behalf, an