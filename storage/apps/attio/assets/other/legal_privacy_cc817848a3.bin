"$1\",\".$crpd3q7znid\",{\"children\":[\"support@attio.com\"]}]]}],[\"$\",\"$1\",\".$kp2flqkpuek\",{\"children\":[\".\"]}]]}]\nf4:[\"$\",\"p\",\"paragraph:c1_1631\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$r5zmyng8598\",{\"children\":[\"If you are in the European Union, you may address privacy-related inquiries to our EU representative pursuant to Article 27 GDPR:\"]}]]}]\nf5:[\"$\",\"p\",\"paragraph:c1_1632\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$n1vonc9xmvi\",{\"children\":[\"EU-REP.Global GmbH, Attn: Attio\"]}]]}]\nf6:[\"$\",\"p\",\"paragraph:c1_1633\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\""])</script><script>self.__next_f.push([1,",\"children\":[[\"$\",\"$1\",\".$dd41i4uq4hp\",{\"children\":[\"Hopfenstr. 1d, 24114 Kiel, Germany\"]}]]}]\nf7:[\"$\",\"p\",\"paragraph:c1_1634\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$d4g0b8jshw\",{\"children\":[\"attio@eu-rep.global\"]}]]}]\nf8:[\"$\",\"p\",\"paragraph:c1_1635\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$ywbhzriyh9\",{\"children\":[\"www.eu-rep.global\"]}]]}]\n"])</script></body></html>