a2e10604e8\",{\"className\":\"space-y-4 lg:space-y-6 mx-auto max-w-2xl\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"faq\",\"className\":\"pr-6 text-heading-responsive-md text-secondary-foreground\",\"children\":\"Frequently asked questions.\"}],[\"$\",\"$L7d\",null,{\"faqItems\":[{\"_uid\":\"bc7d0c3f-0b40-4dd4-9e5a-5199ed72fed8\",\"answer\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Refer your friend to Attio Pro / Enterprise and you’ll get a $200 gift card for every valid referral. Your referral gets 10% off their first year on a paid plan.\",\"type\":\"text\"}]}]},\"question\":\"What is the referral promo?\",\"component\":\"faqItem\"},{\"_uid\":\"55936614-3be8-488d-ad4e-612568ae6444\",\"answer\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Please refer to our \",\"type\":\"text\"},{\"text\":\"Referral Gift Card Policy\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/legal/referral/referral-gift-card-reward-policy\",\"uuid\":\"0c65f266-74aa-4887-ad71-9112bb27fdfa\",\"anchor\":null,\"target\":\"_blank\",\"linktype\":\"story\"}}]},{\"text\":\" for more detail.\",\"type\":\"text\"}]}]},\"question\":\"Are there any terms and conditions I should be aware of?*\",\"component\":\"faqItem\"},{\"_uid\":\"64f0d141-f3d0-451c-96d1-459d809b155f\",\"answer\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Your referral is valid when a \",\"type\":\"text\"},{\"text\":\"new\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]},{\"text\":\" workspace signs up with your referral link and converts to Pro / Enterprise plan within 60 days of signing up to Attio and remains on the plan for 3 consecutive months after their two-week trial. \",\"type\":\"text\"},{\"type\":\"hard_break\"},{\"type\":\"hard_break\"},{\"text\":\"The workspace you refer through your link can convert to Pro / Enterprise at any point during the 3 months Promo Window, but any cancellation, downgrade, or deletion after their first paid date, will disqualify them as a valid referral.\",\"type\":\"text\"}]}]},\"question\":\"What counts as a valid referral?\",\"component\":\"faqItem\"},{\"_uid\":\"96682ebb-a0a8-4cc7-9785-33c4cf4fb9df\",\"answer\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"For every valid referral,\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]},{\"text\":\" \",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}},{\"type\":\"bold\"}]},{\"text\":\"y\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]},{\"text\":\"ou’ll receive a $200 digital gift card, delivered via email to the address associated with your Attio account. We’ll send it to you within 30 days of your referral completing the 3-month qualifying period.\",\"type\":\"text\"}]}]},\"question\":\"What do I get?\",\"component\":\"faqItem\"},{\"_uid\":\"d8d5754e-e20c-4003-b20b-801f73582b7c\",\"answer\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"No. Referral rewards - both the gift card and the 10% discount - cannot be combined with any other promotional or incentive offers, including but not limited to: startup program discount, sales offers, and any other special promos. The reward applies only to new workspaces that sign up using your link.\",\"type\":\"text\"}]}]},\"question\":\"Can referral rewards be combined with other offers?\",\"component\":\"faqItem\"},{\"_uid\":\"ce149690-7f2c-4d14-ba80-bebf3fdae521\",\"answer\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"The most common reasons why you haven’t received a gift-card are: the 3-month qualifying period hasn’t elapsed yet, your referral didn’t sign up using your unique link, the referral didn't convert to Pro/Enterprise within 60 days of signing up, or the referred workspace has cancelled, deleted, or downgraded to the Free or Plus plan after their first paid date.\",\"type\":\"text\"}]}]},\"question\":\"I’ve referred someone but haven’t got my gift card - why?\",\"component\":\"faqItem\"}],\"children\":[\"$L7e\",\"$L7f\",\"$L80\",\"$L81\",\"$L82\",\"$L83\"]}],\"$undefined\"]}]]}]}]}]}]}]\n"])</script><script>self.__next_f.push([1,"7a:[\"$\",\"section\",\"0e526d08-3a21-4733-9f7a-cbb84aa898c9\",{\"className\":\"dark bg-primary-background\",\"ref\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"container flex flex-1 flex-col\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex w-full flex-1 flex-col border-subtle-stroke border-x\",\"style\":\"$undefined\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":\"true\",\"className\":\"grid h-40 w-full grid-cols-12 overflow-hidden max-xl:h-30 max-lg:h-25 h-8!\",\"children\":[\"$\",\"div\",null,{\"className\":\"col-[2/-2] flex justify-between\",\"children\":[[\"$\",\"svg\",null,{\"width\":\"1\",\"height\":\"100%\",\"className\":\"text-subtle-stroke\",\"children\":[\"$\",\"line\",null,{\"x1\":\"0.5\",\"y1\":\"0\",\"x2\":\"0.5\",\"y2\":\"100%\",\"stroke\":\"currentColor\",\"strokeDasharray\":\"4 6\",\"strokeLinecap\":\"round\"}]}],[\"$\",\"svg\",null,{\"width\":\"1\",\"height\":\"100%\",\"className\":\"text-subtle-stroke\",\"children\":[\"$\",\"line\",null,{\"x1\":\"0.5\",\"y1\":\"0\",\"x2\":\"0.5\",\"y2\":\"100%\",\"stroke\":\"currentColor\",\"strokeDasharray\":\"$undefined\",\"strokeLinecap\":\"round\"}]}],[\"$\",\"svg\",null,{\"width\":\"1\",\"height\":\"100%\",\"className\":\"text-subtle-stroke\",\"children\":[\"$\",\"line\",null,{\"x1\":\"0.5\",\"y1\":\"0\",\"x2\":\"0.5\",\"y2\":\"100%\",\"stroke\":\"currentColor\",\"strokeDasharray\":\"4 6\",\"strokeLinecap\":\"round\"}]}]]}]}],[\"$\",\"svg\",null,{\"width