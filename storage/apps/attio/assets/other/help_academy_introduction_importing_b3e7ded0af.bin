[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Bring data from any outside source into Attio via CSV upload\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Load it into Attio Lists\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Map columns to Attio attributes and perform any needed data cleanup to add records to lists, as well as create new records and update existing records\",\"type\":\"text\"}]}]}]}]},\"title\":\"Importing into Lists\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]},\"videoId\":\"W_oOficUSqo\",\"component\":\"academyCourseLesson\",\"redirects\":[],\"thumbnail\":{\"id\":22947538,\"alt\":\"\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/234930/1920x1080/a8411e9aef/importing-into-lists-17-40-00.png\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{},\"is_external_url\":false},\"description\":\"Quickly and easily load data from upstream tools into Attio Lists.\",\"videoLength\":\"4:15\",\"relatedArticles\":[\"7067b66d-b50c-48ad-890e-84eee487bcdb\",\"5fb57d3a-e028-4f7f-83f9-c442d90f7ee0\",\"7522dd0d-ba1f-4d4c-a827-98ce2f19a8ad\",\"819835f5-dbe4-4e5a-ad8d-e75a915f4af4\",\"c53665c7-9083-4b04-9f2a-d3a9543cebfb\"]},\"slug\":\"importing-into-lists\",\"full_slug\":\"help/academy/introduction/importing-into-lists\",\"sort_by_date\":null,\"position\":-210,\"tag_list\":[],\"is_startpage\":false,\"parent_id\":583442331,\"meta_data\":null,\"group_id\":\"36042b6e-00b7-4cd3-8420-9824491e696d\",\"first_published_at\":\"2025-06-02T13:00:10.344Z\",\"release_id\":null,\"lang\":\"default\",\"path\":null,\"alternates\":[],\"default_full_slug\":null,\"translated_slugs\":null},\"currentLessonId\":\"fb9e0758-f2a0-426a-9bd7-eb22c5c4d93a\"}]\n"])</script><script>self.__next_f.push([1,"110:[\"$\",\"$L106\",\"5a51d4d0-c319-44f7-a02a-e5f192b6a3cd\",{\"lessonId\":\"5a51d4d0