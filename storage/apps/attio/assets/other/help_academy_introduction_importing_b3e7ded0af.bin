]},{\"text\":\"Introduction to objects, records and attributes - the fundamental building blocks of Attio's flexible data model.\",\"type\":\"text\",\"marks\":[{\"type\":\"textStyle\",\"attrs\":{\"color\":\"\"}}]}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Managing People and Companies\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\",\"marks\":[{\"type\":\"bold\"}]},{\"text\":\"View and manage the People and Company records populated from your and your colleagues' synced email accounts.\",\"type\":\"text\"}]}]}]}]},\"title\":\"Email sync, People and Company records\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]},\"videoId\":\"0WqSZGs3PUc\",\"component\":\"academyCourseLesson\",\"redirects\":[{\"_uid\":\"03ae0522-bdbc-4536-be84-83bf7c9805c1\",\"redirect\":\"/help/academy/email-sync-people-companies\",\"component\":\"redirect\"}],\"thumbnail\":{\"id\":17030739,\"alt\":\"\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/234930/5000x2719/a2f1eaf941/email-sync-people-and-company-records-light.png\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{},\"is_external_url\":false},\"description\":\"Your first step in setting up your Attio workspace. Connect your mailbox to bring all of your contact history into your CRM.\",\"videoLength\":\"3:56\",\"contentTitle\":\"\",\"relatedArticles\":[\"6b37818c-8a76-45ba-b4b7-26490e44e4c4\",\"24983dfe-b953-4f2c-8f0a-ae3fe8b29c31\",\"1abc5a9b-e62a-478b-a8f5-512191350ef1\",\"36ddc91e-44c8-4c4e-b324-421242308e0c\",\"c8df66d3-3c10-4006-bdf7-3aabee0333bc\",\"826821b2-6fc5-4832-a514-79f9aaf292e5\",\"6c5c5def-8d46-4d33-bba8-87a0740f0a0c\"]},\"slug\":\"email-sync-people-companies\",\"full_slug\":\"help/academy/introduction/email-sync-people-companies\",\"sort_by_date\":null,\"position\":-10,\"tag_list\":[\"phoenix-emails\"],\"is_startpage\":false,\"parent_id\":583442331,\"meta_data\":n