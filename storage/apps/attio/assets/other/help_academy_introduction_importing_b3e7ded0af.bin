4 * 60 * 60 * 1000));\n                        expires = \"; expires=\" + date.toUTCString();\n                    }\n                    document.cookie = name + \"=\" + (value || \"\") + expires + \"; path=/; domain=.attio.com\";\n                }\n\n                // Main script execution\n                (function() {\n                    var gclid = getGCLID();\n                    if (gclid) {\n                        setGclidCookie('gclid_cookie', gclid, 30); // Setting the cookie for 30 days\n                    }\n                })();\n            "])</script><script>self.__next_f.push([1,"35:T65b,"])</script><script>self.__next_f.push([1,"\n                (function() {\n                    // List of UTM parameters to capture\n                    var utmParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm_campaignid'];\n\n                    // Object to hold UTM data\n                    var utmData = {};\n\n                    var urlParams = new URLSearchParams(window.location.search);\n\n                    // Collect UTM data\n                    utmParams.forEach(function(param) {\n                        var value = urlParams.get(param);\n                        if (value) {\n                            utmData[param] = value;\n                        }\n                    });\n\n                    // Function to set cookie\n                    function setUtmCookie(name, value, days) {\n                        var expires = \"\";\n                        if (days) {\n                            var date = new Date();\n                            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));\n                            expires = \"; expires=\" + date.toUTCString();\n                        }\n                        document.cookie = name + \"=\" + (value || \"\")  + expires + \"; path=/; domain=.attio.com\";\n                    }\n\n                    // Set cookie with UTM data for 30 days\n                    if (Object.keys(utmData).length \u003e 0) {\n                        // Add timestamp to UTM data\n                        utmData['utm_timestamp'] = new Date().toISOString();\n\n                        setUtmCookie('utm_cookie', JSON.stringify(utmData), 30);\n                    }\n                })();\n            "])</script><script>self.__next_f.push([1,"1a:[\"$\",\"$L31\",null,{\"content\":{\"_uid\":\"c61735d9-f3cf-4a2f-b813-337fd0fb2514\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"We use cookies to improve your experience. You can opt out of certain cookies. Find out more in our \",\"type\":\"text\"},{\"text\":\"privacy policy\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/legal/privacy\",\"uuid\":null,\"anchor\":null,\"target\":\"_blank\",\"linktype\":\"url\"}}]},{\"text\":\".\",\"type\":\"text\"}]}]},\"component\":\"cookieConsent\",\"acceptButtonLabel\":\"Continue\",\"rejectButtonLabel\":\"Reject\"},\"children\":[[\"$\",\"$L32\",null,{\"id\":\"analytics-gclid\",\"children\":\"$33\"}],[\"$\",\"$L34\",null,{}],[\"$\",\"$L32\",null,{\"id\":\"analytics-utm\",\"children\":\"$35\"}],\"$L36\",\"$L37\",\"$L38\"]}]\n1c:[\"$\",\"$L39\",null,{\"text\":\"\\n\\n      *@@@@#=                                    ++:\\n     #@@@@# :#                      :+#    =+@   @@+\\n    #@@@@#   +             +++ :++ -*@@::::@@@:: --.    +++:\\n   #@@@@+   ::          :%@@@@@@@@ @@@@@@@@@@@@@ @@+ :#@@@@@@=\\n  #@@@@:   *:++++      :@@+   +@@@  +@@    @@@   @@+:@@#   +@@+\\n #@@@@:   *:#@@# +     *@#     +@@  +@@    @@@   @@++@@     +@@\\n@@@@@-   + #@@#   +    +@@:   :@@@  +@@    @@@   @@+=@@:    #@#\\n:@@@@%: + #@@@@: ::     #@@@+@@@@@  :@@@@+ +@@@@ @@+ +@@@+#@@#\\n :@@@@@+   #@@@@+:       :++++++++   :+++:  ++++ ++:   +++++:\\n\\n\\n→ https://attio.com/careers\\n\\n\"}]\n"])</script><script>self.__next_f.push([1,"3a:I[344970,[\"/_next/static/chunks/18df3wdz3