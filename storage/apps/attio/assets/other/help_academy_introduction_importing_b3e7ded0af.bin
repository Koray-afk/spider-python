a10651e1556\",\"learn\":{\"type\":\"doc\",\"content\":[{\"type\":\"bullet_list\",\"content\":[{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Effortless call recording and storage\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Learn how Attio’s call recorder automatically joins meetings in Zoom, Google Meet, and Microsoft Teams, transcribes conversations, and stores recordings directly in your CRM for seamless access.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"AI powered insights and summaries\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Discover how to create and apply custom AI insight templates that generate summaries, highlight key details, and provide actionable next steps tailored to different call types.\",\"type\":\"text\"}]}]},{\"type\":\"list_item\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Managing and using call recordings\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]},{\"type\":\"hard_break\"},{\"text\":\"Explore how to access, filter, and organize your call recordings within Attio, leverage live insights, and use playback modes like pinned mode and picture-in-picture for efficient review.\",\"type\":\"text\"}]}]}]}]},\"title\":\"Call Intelligence\",\"videoId\":\"-HbTAAz9-r0\",\"component\":\"academyCourseLesson\",\"redirects\":[],\"thumbnail\":{\"id\":21554874,\"alt\":\"\",\"name\":\"\",\"focus\":\"\",\"title\":\"\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/234930/3840x2160/00abbe5354/call-recording.png\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{},\"is_external_url\":false},\"description\":\"Automatically record, transcribe, and store meetings in Attio, and leverage AI-powered insight templates to generate summaries, highlight key details, and streamline follow ups for seamless team collaboration.\",\"v