ta",display_text_range:$R[1477]=[0,214],full_text:"Personal Intelligence 🤝 Nano Banana 2\n\nPersonal Intelligence now gives Gemini an understanding of your preferences and interests when generating images, so you can spend more time creating and less time explaining.",hashtag_entities:$R[1478]={__refs:$R[1479]=[]},cashtag_entities:$R[1480]={__refs:$R[1481]=[]},smarttags:$R[1482]={__refs:$R[1483]=[]},self_thread_metadata:null,created_at_ms:1776355487000},"client:VHdlZXQ6MjA0NDgwOTIzNzE1MTI3MzI4NA==:grok_translated_post_with_availability":$R[1484]={__id:"client:VHdlZXQ6MjA0NDgwOTIzNzE1MTI3MzI4NA==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:details":$R[1485]={__id:"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:details",__typename:"TBirdData",display_text_range:$R[1486]=[0,277],self_thread_metadata:null,full_text:"More users in the U.S. can now create personalized images for free.\n\nBy choosing to connect your Google apps to Gemini in settings, Gemini is able to better understand your preferences, so it can automatically fill in the blanks and ground image creation in the things you care",hashtag_entities:$R[1487]={__refs:$R[1488]=[]},cashtag_entities:$R[1489]={__refs:$R[1490]=[]},smarttags:$R[1491]={__refs:$R[1492]=[]},created_at_ms:1782755732000},"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:note_tweet":$R[1493]={__id:"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:note_tweet",__typename:"NoteTweetData",is_expandable:!0,note_tweet_results:$R[1494]={__ref:"Tm90ZVR3ZWV0UmVzdWx0czoyMDcxNjUzODExMDQzODQwMDAw"}},Tm90ZVR3ZWV0UmVzdWx0czoyMDcxNjUzODExMDQzODQwMDAw:$R[1495]={__id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDcxNjUzODExMDQzODQwMDAw",__typename:"NoteTweetResults",result:$R[1496]={__ref:"Tm90ZVR3ZWV0OjIwNzE2NTM4MTEwNDM4NDAwMDA="},id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDcxNjUzODExMDQzODQwMDAw"},"Tm90ZVR3ZWV0OjIwNzE2NTM4MTEwNDM4NDAwMDA=":$R[1497]={__id:"Tm90ZVR3ZWV0OjIwNzE2NTM4MTEwNDM4NDAwMDA=",__typename:"NoteTweet",text:"More users in the U.S. can now create personalized images for free.\n\nBy choosing to connect your Google apps to Gemini in settings, Gemini is able to better understand your preferences, so it can automatically fill in the blanks and ground image creation in the things you care about most. You can choose to connect or disconnect your Google apps at any time, so you’re in control.\n\nTry it out today and share what you create in the replies 👇",entity_set:$R[1498]={__ref:"client:Tm90ZVR3ZWV0OjIwNzE2NTM4MTEwNDM4NDAwMDA=:entity_set"},id:"Tm90ZVR3ZWV0OjIwNzE2NTM4MTEwNDM4NDAwMDA="},"client:Tm90ZVR3ZWV0OjIwNzE2NTM4MTEwNDM4NDAwMDA=:entity_set":$R[1499]={__id:"client:Tm90ZVR3ZWV0OjIwNzE2NTM4MTEwNDM4NDAwMDA=:entity_set",__typename:"EntitySet",hashtags:$R[1500]={__refs:$R[1501]=[]},symbols:$R[1502]={__refs:$R[1503]=[]},smarttags:$R[1504]={__refs:$R[1505]=[]},urls:$R[1506]={__refs:$R[1507]=[]},user_mentions:$R[1508]={__refs:$R[1509]=[]}},"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:grok_translated_post_with_availability":$R[1510]={__id:"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:grok_translated_post_with_availability",__typename:"ApiGrokTranslateResponse",is_available:!1,data:null},"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:edit_control":$R[1511]={__id:"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:edit_control",__typename:"EditControlInitial",edit_tweet_ids:$R[1512]=["2071653811110998226"]},"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:quick_promote_eligibility":$R[1513]={__id:"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:quick_promote_eligibility",__typename:"TweetQuickPromoteEligibilityResponse",eligibility:"IneligibleUserUnauthorized"},"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:views":$R[1514]={__id:"client:VHdlZXQ6MjA3MTY1MzgxMTExMDk5ODIyNg==:views",__typename:"ViewCountInfo",count:"217729"},"urt:server:TimelineTimelineEntry:profile-conversation-2074181720311070729":$R[1515]={__id:"urt:server:TimelineTimelineEntry:profile-conversation-2074181