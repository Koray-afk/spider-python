ease trading; or\"]}]]}]]}],[\"$\",\"li\",\".$list_item=2c1_1299\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1298\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$z7f9gn1uryh\",{\"children\":[\"(c) either party, or any of its officers, directors, or beneficial owners, becomes subject to sanctions or export controls imposed by the United States, United Kingdom, European Union, or United Nations, or is designated on any sanctions list maintained by any of these jurisdictions.\"]}]]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"ed:[\"$\",\"p\",\"paragraph:c1_1301\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$sewy3xk8hkj\",{\"children\":[\"16.2. On termination, Customer will pay in full for the Attio Services up to and including the effective date of termination. Upon any termination, Attio will make all Customer Data available to Customer for electronic retrieval for a period of thirty (30) days. Thereafter Customer may request Attio deletes stored Customer Data in accordance with the terms of this Agreement but without such request, Attio may, but is not obligated to do so.\"]}]]}]\nee:[\"$\",\"p\",\"paragraph:c1_1302\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$gm6yunnacvo\",{\"children\":[\"16.3. Upon termination of this Agreement for any reason, Customer will promptly destroy or permanently delete all Attio Content and all copies thereof in Customer’s or any User’s possession or control, and will, upon Attio’s written request, certify in writing that it has done so. This obligation is without prejudice to Customer’s obligations under clause 14.1(e).\"]}]]}]\nef:[\"$\",\"p\",\"paragraph:c1_1303\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$zlbz0eh80n\",{\"children\":[\"16.4. All clauses of this Agreement which by their nature should survive termination will survive termination, including, without limitation, accrued rights to payment, and clauses 1, 4.3, 4.4, 4.5(a)-(e), 4.6, 4.8, 5.5-5.8, 6, 8.8, 9, 10, 12-14, 16.2, 16.3, 16.6, and 17-19.\"]}]]}]\nf0:[\"$\",\"p\",\"paragraph:c1_1304\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$z8k1698fv4d\",{\"children\":[\"16.5. Attio may terminate this Agreement: (a) for any legitimate business reason, including discontinuation of the Attio Services, a change in business operations, or where continued performance would be commercially impracticable; or (b) for non-payment of Fees lasting more than thirty (30) days after notice of non-payment, in each case by giving Customer reasonable notice. Attio may terminate with immediate effect where required to comply with applicable law or regulation or to address a security incident.\"]}]]}]\nf1:[\"$\",\"p\",\"paragraph:c1_1305\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$unl5bh9eadb\",{\"children\":[\"16.6. In cases of termination by Attio without cause, Attio will refund Customer the paid but unused portion of Fees for the remainder of the then current Initial Term or Renewal Term.\"]}]]}]\nf2:[\"$\",\"p\",\"paragraph:c1_1306\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$yvokmz8achl\",{\"children\":[\"16.7. Without prejudice to clauses 16.1, 16.2 or 16.5, Attio may, in addition, and without liability, suspend access to and use of the Attio Services or any part thereof, by giving notice to Customer if any provision of this Agreement is breached.\"]}]]}]\nf3:[\"$\",\"h2\",\"heading:l2:c1_1307\",{\"id\":\"17-force-majeure\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-5 font-bold text-2xl text-primary-foreground lg:not-first:mt-20\",\"children\":[[\"$\",\"$1\",\".$og5iursqsn\",{\"children\":[\"17. Force Majeure\"]}]]}]\nf4:[\"$\",\"p\",\"paragraph:c1_1308\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$li2482dy1q\",{\"children\":[\"Neither party will be liable for any failure or delay in performing its obligations under this Agreement (other than Customer’s payment obligations) to the extent caused by circumstances beyond its reasonable control, including acts of God, pandemics, natural disasters, war, terrorism, government action, labour disputes (excluding those involving the affected party’s own workforce), or failures of the internet, networks, telecommunic"])</script><script>self.__next_f.push([1,"ations, or power supply. For the avoidance of doubt, force majeure does not include any shortage or lack of funds on Customer’s part. This clause applies provided the affected party:\"]}]]}]\nf5:[\"$\",\"ul\",\"bullet_list:c3_1315\",{\"className\":\"not-first:mt-1.5 list-[square] pl-3.5 marker:text-white-600\",\"children\":[[\"$\",\"li\",\".$list_item=2c1_1310\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1309\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$2hk6ji7v02p\",{\"children\":[\"(a) notifies the other in writing as soon as reasonably practicable about the nature and extent of the circumstances and likely effects;\"]}]]}]]}],[\"$\",\"li\",\".$list_item=2c1_1312\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1311\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$6vg18r0b2pr\",{\"children\":[\"(b) uses reasonable efforts to mitigate any adverse impact on the other; and\"]}]]}]]}],[\"$\",\"li\",\".$list_item=2c1_1314\",{\"className\":\"pt-1 pl-1.5 first:pt-1.5 [\u0026:not(:has(ul,li))]:pb-1.5\",\"children\":[[\"$\",\"p\",\".$paragraph=2c1_1313\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$oc0ytmm09se\",{\"children\":[\"(c) uses reasonable efforts to resume performance as soon as reasonably practicable.\"]}]]}]]}]]}]\nf6:[\"$\",\"h2\",\"heading:l2:c1_1316\",{\"id\":\"18-publicity\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-5 font-bold text-2xl text-primary-foreground lg:not-first:mt-20\",\"children\":[[\"$\",\"$1\",\".$9kdwdagafpg\",{\"children\":[\"18. Publicity\"]}]]}]\nf7:[\"$\",\"p\",\"paragraph:c1_1317\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$nbh4y21e2r\",{\"children\":[\"Customer agrees that Attio may use Customer’s name or logo to list Customer as an Attio customer on its website and in other marketing, sales, and other business materials.\"]}]]}]\nf8:[\"$\",\"h2\",\"heading:l2:c1_1318\",{\"id\":\"19-general\",\"className\":\"scroll-my-24 relative not-first:mt-15 not-last:mb-5 font-bold text-2xl text-primary-foreground lg:not-first:mt-20\",\"children\":[[\"$\",\"$1\",\".$b2ivo6b8fw8\",{\"children\":[\"19. General\"]}]]}]\nf9:[\"$\",\"p\",\"paragraph:c1_1319\",{\"className\":\"not-first:mt-5 text-pretty [h4+\u0026:not(:first-child)]:mt-2.5 [p+\u0026:not(:first-child)]:mt-5\",\"children\":[[\"$\",\"$1\",\".$cksz7t8cmdh\",{\"children\":[\"19.1. Attio m