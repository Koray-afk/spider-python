  "ui_html": "<div class=\"messages-container\">\n<div class=\"alert alert-success alert-dismissible fade show\" role=\"alert\">\n                Agent settings saved.\n                <button aria-label=\"Close\" class=\"btn-close\" data-bs-dismiss=\"alert\" type=\"button\"></button>\n</div>\n</div>\n<style>\n\t.messages-container {\n\t\tposition: fixed;\n\t\ttop: 10px;\n\t\tleft: 50%;\n\t\ttransform: translateX(-50%);\n\t\tz-index: 9999;\n\t\twidth: 25%;\n\t}\n\t</style>\n<a class=\"menu-link\" href=\"/spout/ai-operations/\">\n<span class=\"menu-bullet\"><span class=\"bullet bullet-dot\"></span></span>\n<span class=\"menu-title\">Production Agent</span>\n</a>\n<a class=\"menu-link active bg-light-primary\" href=\"/likwid/agent-settings/\">\n<span class=\"menu-bullet\"><span class=\"bullet bullet-dot\"></span></span>\n<span class=\"menu-title\">Agent Settings</span>\n</a>\n<div class=\"alert alert-dismissible d-flex align-items-center p-5 mb-5 alert-success\">\n<i class=\"ki-duotone ki-information-5 fs-2hx me-4 flex-shrink-0\"><span class=\"path1\"></span><span class=\"path2\"></span><span class=\"path3\"></span></i>\n<div class=\"d-flex flex-column flex-grow-1\"><span>Agent settings saved.</span></div>\n<button class=\"btn-close\" data-bs-dismiss=\"alert\" type=\"button\"></button>\n</div>\n<form method=\"post\">\n<input name=\"csrfmiddlewaretoken\" type=\"hidden\" value=\"RYvlKyV7jTRIUolWwz30YQ6BuLeB9vbN1Q50MW1o4yFsgFFIJBdXSDvUDApTbUf4\"/>\n<!-- Feature Flags -->\n<div class=\"card mb-6\">\n<div class=\"card-header border-0 pt-6\">\n<div class=\"card-title\">\n<i class=\"ki-duotone ki-robot fs-2x text-primary me-3\"><span class=\"path1\"></span><span class=\"path2\"></span></i>\n<div>\n<h3 class=\"card-label fw-bold mb-0\">AI Agent Configuration</h3>\n<span class=\"text-muted fs-7\">Configure how AI agents orchestrate your production and procurement.</span>\n</div>\n</div>\n</div>\n<div class=\"card-body pt-4 pb-6\">\n<!-- Enable / Disable -->\n<div class=\"bg-light-primary rounded p-6 mb-8\">\n<h5 class=\"fw-bold text-gray-800 mb-2\">Enable / Disable Agents</h5>\n<p class=\"text-muted fs-7 mb-6\">Both agents are <strong>off by default</strong>. Enable once you have verified setup in a test order.</p>\n<div class=\"row g-6\">\n<div class=\"col-md-6\">\n<div class=\"d-flex align-items-start p-5 bg-white rounded border\">\n<div class=\"form-check form-switch form-check-custom form-check-solid me-4 mt-1\">\n<input checked=\"\" class=\"form-check-input\" id=\"production_agent_enabled\" name=\"production_agent_enabled\" type=\"checkbox\"/>\n</div>\n<div>\n<label class=\"fw-bold text-gray-800 fs-6 d-block mb-1\" for=\"production_agent_enabled\">Production Agent</label>\n<span class=\"text-muted fs-7\">AI handles scheduling, machine allocation, batch decisions, and SFG sourcing. Falls back to hardcoded scheduler on any error.</span>\n</div>\n</div>\n</div>\n<div class=\"col-md-6\">\n<div class=\"d-flex align-items-start p-5 bg-white rounded border\">\n<div class=\"form-check form-switch form-check-custom form-check-solid me-4 mt-1\">\n<input checked=\"\" class=\"form-check-input\" id=\"procurement_agent_enabled\" name=\"procurement_agent_enabled\" type=\"checkbox\"/>\n</div>\n<div>\n<label class=\"fw-bold text-gray-800 fs-6 d-block mb-1\" for=\"procurement_agent_enabled\">Procurement Agent</label>\n<span class=\"text-muted fs-7\">AI analyses stock levels and drafts procurement recommendations. A human must approve before any purchase order is raised.</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<!-- Separator -->\n<div class=\"separator separator-dashed mb-8\"></div>\n<!-- Production Settings -->\n<h5 class=\"fw-bold text-gray-800 mb-5\">Production Agent Settings</h5>\n<div class=\"row g-6 mb-8\">\n<div class=\"col-md-6\">\n<label class=\"form-label fw-semibold required\">Semi-Finished Goods Sourcing</label>\n<select class=\"form-select form-select-solid\" name=\"sfg_sourcing_mode\">\n<option selected=\"\" value=\"always_ask\">Always Ask User</option>\n<option value=\"agent_decides\">Agent Decides (Make vs Buy)</option>\n<option value=\"always_make\">Always Make</option>\n<option value=\"always_buy\">Always Buy</option>\n</select>\n<div class=\"form-text text-muted\">How the agent handles semi-finished goods shortages.</div>\n</div>\n<div class=\"col-md-6\">\n<label class=\"form-label fw-semibold required\">Production Sequencing</label>\n<select class=\"form-select form-select-solid\" name=\"production_sequencing_mode\">\n<option value=\"priority\">Priority \u2014 delivery urgency + customer value + order value</option>\n<option selected=\"\" value=\"fifo\">FIFO \u2014 first in, first out by order date</option>\n<option value=\"batch\">Batch \u2014 maximise run size, minimise setup</option>\n<option value=\"hybrid\">Hybrid \u2014 priority tiers, FIFO within each tier</option>\n</select>\n<div class=\"form-text text-muted\">How orders are ranked for machine slot allocation.</div>\n</div>\n<div class=\"col-md-4\">\n<label class=\"form-label fw-semibold\">Batch Wait Window <span class=\"text-muted\">(days)</span></label>\n<input class=\"form-control form-control-solid\" max=\"30\" min=\"0\" name=\"batch_wait_window_days\" type=\"number\" value=\"7\"/>\n<div class=\"form-text text-muted\">Max days the agent holds an order waiting for a batch to fill before escalating.</div>\n</div>\n<div class=\"col-md-4\">\n<label class=\"form-label fw-semibold\">Min Batch Fill <span class=\"text-muted\">(%)</span></label>\n<input class=\"form-control form-control-solid\" max=\"100\" min=\"10\" name=\"min_batch_fill_pct\" type=\"number\" value=\"50\"/>\n<div class=\"form-text text-muted\">Minimum % of economic batch quantity to trigger consolidation.</div>\n</div>\n</div>\n<!-- Separator -->\n<div class=\"separator separator-dashed mb-8\"></div>\n<!-- Procurement Settings -->\n<h5 class=\"fw-bold text-gray-800 mb-5\">Procurement Agent Settings</h5>\n<div class=\"row g-6\">\n<div class=\"col-md-4\">\n<label class=\"form-label fw-semibold\">Procurement Horizon <span class=\"text-muted\">(days)</span></label>\n<input class=\"form-control form-control-solid\" max=\"180\" min=\"7\" name=\"procurement_horizon_days\" type=\"number\" value=\"30\"/>\n<div class=\"form-text text-muted\">Days ahead to project stock and raise proactive alerts.</div>\n</div>\n<div class=\"col-md-8 d-flex align-items-center\">\n<div class=\"d-flex align-items-start p-5 bg-light rounded border w-100\">\n<div class=\"form-check form-switch form-check-custom form-check-solid me-4 mt-1\">\n<input checked=\"\" class=\"form-check-input\" id=\"procurement_proactive_mode\" name=\"procurement_proactive_mode\" type=\"checkbox\"/>\n</div>\n<div>\n<label class=\"fw-bold text-gray-800 d-block mb-1\" for=\"procurement_proactive_mode\">Enable Daily Automated Scan</label>\n<span class=\"text-muted fs-7\">When on, the system scans all items every day and raises recommendations before stock runs out. When off, you can still trigger a manual scan from the Procurement Agent page.</span>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"card-footer d-flex justify-content-end py-4\">\n<button class=\"btn btn-primary px-8\" type=\"submit\">\n<i class=\"ki-duotone ki-check fs-4 me-1\"><span class=\"path1\"></span><span class=\"path2\"></span></i>\n                        Save Settings\n                    </button>\n</div>\n</div>\n</form>",
