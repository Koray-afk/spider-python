{
  "trigger": {
    "label": "Campaign -Cogent Feedback",
    "tagName": "button",
    "id": "",
    "className": "btn btn-link p-0 text-gray-800 fw-bold fs-6 text-hover-primary text-start campaign-preview-btn",
    "selector": "[data-crawl-id=\"5\"]",
    "outerHTML": "<button type=\"button\" class=\"btn btn-link p-0 text-gray-800 fw-bold fs-6 text-hover-primary text-start campaign-preview-btn\" title=\"Click to preview email content\" data-crawl-id=\"5\">\n                                                                <span class=\"text-muted fw-semibold fs-7 me-1\">Campaign -</span>Cogent Feedback\n                                                            </button>"
  },
  "interaction_type": "modal",
  "location": {
    "parentSelector": "#kt_app_root",
    "parentXPath": "/html[1]/body[1]/div[1]",
    "insertMethod": "append"
  },
  "ui_html": "<div aria-modal=\"true\" class=\"modal fade show\" id=\"kt_modal_email_preview\" role=\"dialog\" style=\"display: block;\" tabindex=\"-1\">\n<div class=\"modal-dialog modal-dialog-centered modal-xl\">\n<div class=\"modal-content\">\n<div class=\"modal-header\">\n<div class=\"d-flex flex-column\">\n<h2 class=\"fw-bold mb-1\" id=\"emailPreviewCampaignName\">Campaign - Cogent Feedback</h2>\n<div class=\"d-flex align-items-center gap-3\">\n<span class=\"text-muted fs-7\">\n<i class=\"ki-duotone ki-abstract-26 fs-7 me-1\"><span class=\"path1\"></span><span class=\"path2\"></span></i>\n                                Subject: <span class=\"fw-semibold text-gray-700\" id=\"emailPreviewSubject\">How was your Cogent experience?</span>\n</span>\n<span class=\"text-muted fs-7\">\u00b7</span>\n<span class=\"text-muted fs-7\">\n<i class=\"ki-duotone ki-calendar fs-7 me-1\"><span class=\"path1\"></span><span class=\"path2\"></span></i>\n                                Sent: <span class=\"fw-semibold text-gray-700\" id=\"emailPreviewSentAt\">Jun 11, 2026 at 16:53</span>\n</span>\n</div>\n</div>\n<div class=\"btn btn-icon btn-sm btn-active-icon-primary ms-auto\" data-bs-dismiss=\"modal\">\n<i class=\"ki-duotone ki-cross fs-1\"><span class=\"path1\"></span><span class=\"path2\"></span></i>\n</div>\n</div>\n<div class=\"modal-body p-0\">\n<!-- Toolbar -->\n<div class=\"d-flex align-items-center px-7 py-3 border-bottom border-gray-200 bg-light\">\n<div class=\"d-flex align-items-center gap-2\">\n<span class=\"badge badge-light-primary fs-8 px-3 py-2\">\n<i class=\"ki-duotone ki-sms fs-7 me-1\"><span class=\"path1\"></span><span class=\"path2\"></span></i>\n                                To: sidharth@likwid.co.in\n                            </span>\n</div>\n<div class=\"ms-auto d-flex gap-2\">\n<button class=\"btn btn-sm btn-light-primary\" id=\"emailPreviewToggle\" type=\"button\"><i class=\"ki-duotone ki-code fs-5\"><span class=\"path1\"></span><span class=\"path2\"></span><span class=\"path3\"></span><span class=\"path4\"></span></i> View Source</button>\n</div>\n</div>\n<!-- Rendered HTML view -->\n<div id=\"emailPreviewRendered\" style=\"min-height:400px; max-height:600px; overflow-y:auto;\">\n<!-- \u2705 FIX 1: Added \"allow-scripts\" to sandbox -->\n<!-- OLD: sandbox=\"allow-same-origin\" -->\n<!-- Without allow-scripts, the browser blocks ANY script inside the iframe,\n                             including inline <style> tags being applied, causing the email to render\n                             unstyled and throwing \"Blocked script execution\" in the console. -->\n<iframe id=\"emailPreviewIframe\" sandbox=\"allow-same-origin allow-scripts\" srcdoc='&lt;!DOCTYPE html&gt;\n&lt;html&gt;\n&lt;head&gt;\n&lt;meta charset=\"utf-8\"&gt;\n&lt;meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"&gt;\n&lt;style&gt;\n  body { font-family: Arial, sans-serif; font-size: 14px; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f4f4f4; }\n  .email-container { background-color: #ffffff; padding: 30px; border-radius: 8px; }\n  .content-section { margin: 20px 0; word-break: break-word; }\n  a { color: #007bff; }\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n  &lt;div class=\"email-container\"&gt;\n    \n    &lt;div class=\"content-section\"&gt;You made your first website or store on Cogent.&lt;br&gt;&lt;br&gt;We\\u0027d love to hear how it went. It\\u0027s 8 quick questions and takes under 2 minutes.&lt;br&gt;&lt;br&gt;Share your feedback \u2192 https://forms.gle/XsTXvQneZ8Si4pG19&lt;br&gt;&lt;br&gt;Your answers go directly to the team building Cogent. We read every response.&lt;br&gt;&lt;br&gt;Thanks,&lt;br&gt;Sidharth&lt;br&gt;Founder, Cogent&lt;/div&gt;\n    &lt;div style=\"text-align:center; margin-top:30px; padding-top:20px; border-top:1px solid #eee;\"&gt;\n                         &lt;a href=\"https://forms.gle/XsTXvQneZ8Si4pG19\" style=\"display:inline-block; background-color:#007bff; color:#fff; padding:12px 30px; text-decoration:none; border-radius:5px; font-weight:bold;\"&gt;Share Feedback&lt;/a&gt;\n                       &lt;/div&gt;\n  &lt;/div&gt;\n&lt;/body&gt;\n&lt;/html&gt;' style=\"width: 100%; min-height: 400px; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; display: block; height: 200px;\">\n</iframe>\n</div>\n<!-- Raw source view (hidden by default) -->\n<div id=\"emailPreviewSource\" style=\"display:none; min-height:400px; max-height:600px; overflow-y:auto;\">\n<pre class=\"p-7 m-0 fs-7 text-gray-700\" id=\"emailPreviewSourceText\" style=\"white-space:pre-wrap; word-break:break-all; background:#f8f9fa;\">You made your first website or store on Cogent.\\u000D\\u000A\\u000D\\u000AWe\\u0027d love to hear how it went. It\\u0027s 8 quick questions and takes under 2 minutes.\\u000D\\u000A\\u000D\\u000AShare your feedback \u2192 https://forms.gle/XsTXvQneZ8Si4pG19\\u000D\\u000A\\u000D\\u000AYour answers go directly to the team building Cogent. We read every response.\\u000D\\u000A\\u000D\\u000AThanks,\\u000D\\u000ASidharth\\u000D\\u000AFounder, Cogent</pre>\n</div>\n</div>\n<div class=\"modal-footer border-top border-gray-200 py-4\">\n<button class=\"btn btn-light\" data-bs-dismiss=\"modal\" type=\"button\">Close</button>\n</div>\n</div>\n</div>\n</div>",
  "ui_css": "",
  "backdrop_html": "<div class=\"modal-backdrop fade show\"></div>",
  "tab_content_html": "",
  "tab_content_selector": ""
