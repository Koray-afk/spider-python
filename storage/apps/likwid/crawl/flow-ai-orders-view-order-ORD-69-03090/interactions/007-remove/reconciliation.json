  "ui_html": "<div class=\"messages-container\">\n<div class=\"alert alert-warning alert-dismissible fade show\" role=\"alert\">\n                Pet Bottle - 100ml Brute Round removed from requirements\n                <button aria-label=\"Close\" class=\"btn-close\" data-bs-dismiss=\"alert\" type=\"button\"></button>\n</div>\n</div>\n<div class=\"mb-5\">\n<div class=\"alert alert-dismissible fade show py-3 px-4 mb-2 alert-warning\" role=\"alert\">\n<span class=\"fs-7\">Pet Bottle - 100ml Brute Round removed from requirements</span>\n<button class=\"btn-close btn-close-sm\" data-bs-dismiss=\"alert\" type=\"button\"></button>\n</div>\n</div>\n<span class=\"badge badge-light-warning\">Not Mapped</span>\n<div class=\"o360-card-body text-center py-10\">\n<div class=\"text-gray-400 fs-7\">No work orders have been scheduled for this order yet.</div>\n</div>\n<div class=\"o360-card\">\n<div class=\"o360-card-body text-center py-8\">\n<div class=\"text-gray-400 fs-7\">No production data available.</div>\n</div>\n</div>\n<style>\n/* \u2500\u2500 Likwid AI full-content panel \u2500\u2500 */\n#lkh-chat-overlay {\n\tposition: fixed;\n\ttop: 70px;\n\tleft: 265px;\n\tright: 0;\n\tbottom: 0;\n\tz-index: 200;\n\tbackground: #fff;\n\tdisplay: flex;\n\tflex-direction: column;\n\tbox-shadow: -4px 0 24px rgba(0,0,0,0.10);\n\ttransform: translateX(100%);\n\ttransition: transform 0.25s ease;\n}\n#lkh-chat-overlay.lkh-open { transform: translateX(0); }\n\n.lkh-chat-header {\n\tdisplay: flex;\n\talign-items: center;\n\tjustify-content: space-between;\n\tpadding: 14px 22px;\n\tborder-bottom: 1px solid #efefef;\n\tflex-shrink: 0;\n\tbackground: #fff;\n}\n.lkh-gradient-text {\n\tbackground: linear-gradient(135deg, #7e44ee 0%, #0059fc 100%);\n\t-webkit-background-clip: text;\n\t-webkit-text-fill-color: transparent;\n\tbackground-clip: text;\n}\n.lkh-chat-body {\n\tdisplay: flex;\n\tflex: 1;\n\toverflow: hidden;\n}\n\n/* Sidebar */\n.lkh-chat-sidebar {\n\twidth: 240px;\n\tborder-right: 1px solid #efefef;\n\tdisplay: flex;\n\tflex-direction: column;\n\toverflow: hidden;\n\tflex-shrink: 0;\n\tbackground: #fafafa;\n}\n.lkh-sidebar-top {\n\tpadding: 12px 14px;\n\tborder-bottom: 1px solid #efefef;\n\tflex-shrink: 0;\n}\n#lkh-conversations-list {\n\tflex: 1;\n\toverflow-y: auto;\n\tpadding: 8px 0;\n}\n.lkh-conv-item {\n\tpadding: 10px 14px;\n\tcursor: pointer;\n\tborder-radius: 6px;\n\tmargin: 2px 8px;\n\tfont-size: 13px;\n\tcolor: #5e6278;\n\twhite-space: nowrap;\n\toverflow: hidden;\n\ttext-overflow: ellipsis;\n\ttransition: background 0.15s;\n}\n.lkh-conv-item:hover { background: #f1f1f4; color: #181c32; }\n.lkh-conv-item.active {\n\tbackground: linear-gradient(135deg, rgba(126,68,238,0.12) 0%, rgba(0,89,252,0.08) 100%);\n\tcolor: #7e44ee;\n\tfont-weight: 600;\n}\n\n/* Main chat area */\n.lkh-chat-main {\n\tflex: 1;\n\tdisplay: flex;\n\tflex-direction: column;\n\toverflow: hidden;\n}\n#lkh-messages-erp {\n\tflex: 1;\n\toverflow-y: auto;\n\tpadding: 24px 32px;\n}\n\n/* Bubbles */\n.lkh-user-bubble {\n\tdisplay: flex;\n\tjustify-content: flex-end;\n\tmargin-bottom: 20px;\n}\n.lkh-user-bubble > div {\n\tmax-width: 72%;\n\tbackground: linear-gradient(135deg, #7e44ee 0%, #0059fc 100%);\n\tcolor: #fff;\n\tborder-radius: 16px 16px 4px 16px;\n\tpadding: 12px 16px;\n\tfont-size: 14px;\n\tline-height: 1.5;\n\tword-break: break-word;\n}\n.lkh-ai-bubble {\n\tdisplay: flex;\n\tjustify-content: flex-start;\n\tmargin-bottom: 20px;\n}\n.lkh-ai-bubble-inner {\n\tmax-width: 82%;\n}\n.lkh-ai-label {\n\tdisplay: flex;\n\talign-items: center;\n\tgap: 6px;\n\tmargin-bottom: 6px;\n}\n.lkh-ai-content {\n\tbackground: #f8f6ff;\n\tborder: 1px solid rgba(126,68,238,0.12);\n\tborder-radius: 4px 16px 16px 16px;\n\tpadding: 14px 18px;\n\tfont-size: 14px;\n\tline-height: 1.6;\n\tcolor: #2d2d2d;\n\tword-break: break-word;\n}\n.lkh-row-charts { margin-top: 10px; }\n\n/* Rich text elements */\n.lkh-blockquote {\n\tborder-left: 3px solid #7e44ee;\n\tpadding: 6px 12px;\n\tmargin: 6px 0;\n\tbackground: rgba(126,68,238,0.04);\n\tborder-radius: 0 6px 6px 0;\n\tcolor: #555;\n\tfont-size: 0.88em;\n}\n.lkh-chat-table { font-size: 0.82rem; border-color: #e8e0ff; }\n.lkh-chat-table thead th {\n\tbackground: rgba(126,68,238,0.07);\n\tcolor: #5a32d1;\n\tborder-color: #e8e0ff;\n\tfont-size: 0.78rem;\n\ttext-transform: uppercase;\n\tletter-spacing: 0.03em;\n}\n.lkh-chat-table td { border-color: #f0ecff; vertical-align: middle; }\n\n/* Footer */\n.lkh-chat-footer {\n\tpadding: 14px 22px;\n\tborder-top: 1px solid rgba(126,68,238,0.1);\n\tbackground: rgba(255,255,255,0.97);\n\tflex-shrink: 0;\n}\n.lkh-btn-send {\n\tbackground: linear-gradient(135deg, #7e44ee 0%, #0059fc 100%);\n\tborder: none;\n\tborder-radius: 12px;\n\tcolor: white;\n\tfont-weight: 600;\n\tpadding: 10px 22px;\n\ttransition: all 0.2s ease;\n}\n.lkh-btn-send:disabled { opacity: 0.65; cursor: not-allowed; }\n.lkh-btn-send:not(:disabled):hover { filter: brightness(1.08); }\n\n.lkh-suggest-pill {\n\tborder: none;\n\tbackground: rgba(126,68,238,0.07);\n\tcolor: #7e44ee;\n\tborder-radius: 20px;\n\tfont-size: 12px;\n\tpadding: 6px 14px;\n\tcursor: pointer;\n\ttransition: background 0.15s;\n}\n.lkh-suggest-pill:hover { background: rgba(126,68,238,0.14); }\n\n@media (max-width: 991px) {\n\t#lkh-chat-overlay { left: 0; top: 60px; }\n\t.lkh-chat-sidebar { width: 200px; }\n}\n</style>\n<svg height=\"0\" id=\"SvgjsSvg1001\" style=\"overflow: hidden; top: -100%; left: -100%; position: absolute; opacity: 0;\" version=\"1.1\" width=\"2\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:svgjs=\"http://svgjs.dev\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"><defs id=\"SvgjsDefs1002\"></defs><polyline id=\"SvgjsPolyline1003\" points=\"0,0\"></polyline><path d=\"M0 0 \" id=\"SvgjsPath1004\"></path></svg>",
